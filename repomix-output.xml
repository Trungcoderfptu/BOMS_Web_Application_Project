<file path="src/java/controller/admin/AdminDashboardController.java">
package controller.admin;

import java.io.IOException;
import java.util.List;
import java.util.Map;
import jakarta.servlet.ServletException;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;
import service.AdminService;
import utility.Constants;
import utility.FlashMessageUtil;
import utility.ValidationException;

public class AdminDashboardController extends HttpServlet {

    private AdminService adminService;

    @Override
    public void init() throws ServletException {
        adminService = new AdminService();
    }

    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        HttpSession session = request.getSession();
        FlashMessageUtil.forwardFlashMessages(request, session);

        Map<String, String> userSession = (Map<String, String>) session.getAttribute(Constants.USER_SESSION);
        if (userSession == null || !"Admin".equalsIgnoreCase(userSession.get("role"))) {
            response.sendRedirect("login.jsp");
            return;
        }

        try {
            List<Map<String, Object>> userList = adminService.getAllUsersForView();
            List<Map<String, Object>> keyList = adminService.getAllKeysForView();
            request.setAttribute("USER_LIST", userList);
            request.setAttribute("KEY_LIST", keyList);
        } catch (ValidationException e) {
            request.setAttribute(Constants.ERROR_MESSAGE, e.getMessage());
        }
        request.getRequestDispatcher("admin_dashboard.jsp").forward(request, response);
    }

    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        HttpSession session = request.getSession();
        Map<String, String> userSession = (Map<String, String>) session.getAttribute(Constants.USER_SESSION);
        if (userSession == null || !"Admin".equalsIgnoreCase(userSession.get("role"))) {
            response.sendRedirect("login.jsp");
            return;
        }

        String action = request.getParameter("action");
        if (action == null) {
            action = "";
        }

        int adminUserId = Integer.parseInt(userSession.get("userId"));

        try {
            if ("resetPassword".equals(action)) {
                String targetUserId = request.getParameter("targetUserId");
                String newPassword = request.getParameter("newPassword");
                String confirmPassword = request.getParameter("confirmPassword");
                adminService.resetUserPasswordByAdmin(adminUserId, targetUserId, newPassword, confirmPassword);
                session.setAttribute(Constants.SUCCESS_MESSAGE, Constants.SUCCESS_ADMIN_RESET_PSW);
                response.sendRedirect("AdminDashboardController?tab=tab-passwords");
                return;
            } else if ("changeRole".equals(action)) {
                String targetUserId = request.getParameter("targetUserId");
                String newRole = request.getParameter("newRole");
                adminService.changeUserRoleByAdmin(adminUserId, targetUserId, newRole);
                session.setAttribute(Constants.SUCCESS_MESSAGE, Constants.SUCCESS_ADMIN_CHANGE_ROLE);
                response.sendRedirect("AdminDashboardController?tab=tab-users");
                return;
            } else if ("revokeKey".equals(action)) {
                String keyId = request.getParameter("keyId");
                adminService.revokeSecurityKey(keyId);
                session.setAttribute(Constants.SUCCESS_MESSAGE, Constants.SUCCESS_REVOKE_KEY);
                response.sendRedirect("AdminDashboardController?tab=tab-keys");
                return;
            } else if ("generateKey".equals(action)) {
                String role = request.getParameter("ddlRole");
                if (role == null || role.trim().isEmpty()) {
                    throw new ValidationException(Constants.ERROR_INVALID_ROLE_SELECTION);
                }
                adminService.generateSecurityKey(role.trim());
                session.setAttribute(Constants.SUCCESS_MESSAGE, Constants.SUCCESS_GEN_KEY);
                response.sendRedirect("AdminDashboardController?tab=tab-keys");
                return;
            } else if ("toggleUser".equals(action)) {
                String userIdStr = request.getParameter("userId");
                int targetUserId;
                try {
                    targetUserId = Integer.parseInt(userIdStr);
                } catch (Exception e) {
                    throw new ValidationException(Constants.ERROR_USER_NOT_FOUND);
                }
                if (adminUserId == targetUserId) {
                    throw new ValidationException(Constants.ERROR_ADMIN_CANNOT_CHANGE_SELF_ROLE);
                }
                adminService.toggleUserStatus(targetUserId);
                session.setAttribute(Constants.SUCCESS_MESSAGE, Constants.SUCCESS_ACCOUNT_STATE_CHANGE);
                response.sendRedirect("AdminDashboardController?tab=tab-users");
                return;
            } else {
                session.setAttribute(Constants.ERROR_MESSAGE, Constants.ERROR_INVALID_ACTION);
                response.sendRedirect("AdminDashboardController");
                return;
            }
        } catch (ValidationException e) {
            session.setAttribute(Constants.ERROR_MESSAGE, e.getMessage());
            if ("resetPassword".equals(action)) {
                response.sendRedirect("AdminDashboardController?tab=tab-passwords");
            } else if ("revokeKey".equals(action) || "generateKey".equals(action)) {
                response.sendRedirect("AdminDashboardController?tab=tab-keys");
            } else {
                response.sendRedirect("AdminDashboardController?tab=tab-users");
            }
        }
    }
}
</file>

<file path="src/java/controller/AttendanceController.java">
package controller;

import java.io.IOException;
import java.time.LocalDate;
import java.time.format.DateTimeParseException;
import java.util.List;
import java.util.Map;
import jakarta.servlet.ServletException;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;
import service.AttendanceService;
import utility.Constants;
import utility.FlashMessageUtil;
import utility.ValidationException;

/**
 * Controller điều phối phân hệ Chấm công (Time Attendance UC-05 & UC-06)
 * Tuyệt đối không import Model hoặc DAO (tuân thủ Rule_BOMS.md)
 */
public class AttendanceController extends HttpServlet {

    private AttendanceService attendanceService;

    @Override
    public void init() throws ServletException {
        attendanceService = new AttendanceService();
    }

    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        response.setContentType("text/html;charset=UTF-8");
        HttpSession session = request.getSession();

        @SuppressWarnings("unchecked")
        Map<String, String> userSession = (Map<String, String>) session.getAttribute(Constants.USER_SESSION);
        if (userSession == null) {
            response.sendRedirect(request.getContextPath() + "/login.jsp");
            return;
        }

        FlashMessageUtil.forwardFlashMessages(request, session);

        int userId = Integer.parseInt(userSession.get("userId"));
        LocalDate today = LocalDate.now();

        String weekParam = request.getParameter("weekDate");
        LocalDate timetableWeekDate = today;
        if (weekParam != null && !weekParam.trim().isEmpty()) {
            try {
                timetableWeekDate = LocalDate.parse(weekParam.trim());
            } catch (DateTimeParseException ignored) {
                timetableWeekDate = today;
            }
        }

        int month = parseQueryInt(request.getParameter("month"), today.getMonthValue());
        int year = parseQueryInt(request.getParameter("year"), today.getYear());

        try {
            Map<String, Object> todayAttendance = attendanceService.getTodayAttendanceForView(userId);
            Map<String, Object> weeklyTimetable = attendanceService.getStaffWeeklyTimetable(userId, timetableWeekDate);
            List<Map<String, Object>> historyList = attendanceService.getAttendanceHistoryForView(userId, month, year);
            Map<String, Object> summary = attendanceService.getMonthlySummaryForView(userId, month, year);

            request.setAttribute("TODAY_ATTENDANCE", todayAttendance);
            request.setAttribute("WEEKLY_TIMETABLE", weeklyTimetable);
            request.setAttribute("TIMETABLE_WEEK_DATE", timetableWeekDate.toString());
            request.setAttribute("ATTENDANCE_HISTORY", historyList);
            request.setAttribute("ATTENDANCE_SUMMARY", summary);
            request.setAttribute("CURRENT_MONTH", month);
            request.setAttribute("CURRENT_YEAR", year);
        } catch (ValidationException e) {
            request.setAttribute(Constants.ERROR_MESSAGE, e.getMessage());
        } catch (Exception e) {
            request.setAttribute(Constants.ERROR_MESSAGE, Constants.ERROR_SYSTEM);
        }

        request.getRequestDispatcher("attendance.jsp").forward(request, response);
    }

    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        request.setCharacterEncoding("UTF-8");
        response.setContentType("text/html;charset=UTF-8");
        HttpSession session = request.getSession();

        @SuppressWarnings("unchecked")
        Map<String, String> userSession = (Map<String, String>) session.getAttribute(Constants.USER_SESSION);
        if (userSession == null) {
            response.sendRedirect(request.getContextPath() + "/login.jsp");
            return;
        }

        int userId = Integer.parseInt(userSession.get("userId"));
        String action = request.getParameter("action");

        try {
            if ("checkIn".equals(action)) {
                attendanceService.checkIn(userId);
                session.setAttribute(Constants.SUCCESS_MESSAGE, Constants.SUCCESS_ATTENDANCE_CHECK_IN);
            } else if ("checkOut".equals(action)) {
                String otReason = request.getParameter("otReason");
                attendanceService.checkOut(userId, otReason);
                session.setAttribute(Constants.SUCCESS_MESSAGE, Constants.SUCCESS_ATTENDANCE_CHECK_OUT);
            } else {
                throw new ValidationException(Constants.ERROR_INVALID_ACTION);
            }
        } catch (ValidationException e) {
            session.setAttribute(Constants.ERROR_MESSAGE, e.getMessage());
        } catch (Exception e) {
            session.setAttribute(Constants.ERROR_MESSAGE, Constants.ERROR_SYSTEM);
        }

        response.sendRedirect(request.getContextPath() + "/AttendanceController");
    }

    private int parseQueryInt(String paramValue, int defaultValue) {
        if (paramValue != null && !paramValue.trim().isEmpty()) {
            try {
                return Integer.parseInt(paramValue.trim());
            } catch (NumberFormatException e) {
                return defaultValue;
            }
        }
        return defaultValue;
    }

    @Override
    public String getServletInfo() {
        return "Time Attendance Controller for BOMS";
    }
}
