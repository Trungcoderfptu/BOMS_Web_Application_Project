package service;

import dao.DeliveryDAO;
import dao.UserDAO;
import java.sql.Timestamp;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import model.DeliveryArea;
import model.DeliveryStatusHistory;
import model.ShipperProfile;
import model.User;
import utility.Constants;
import utility.ValidationException;

public class DeliveryService {

    private DeliveryDAO deliveryDAO;
    private UserDAO userDAO;

    public DeliveryService() {
        this.deliveryDAO = new DeliveryDAO();
        this.userDAO = new UserDAO();
    }

    public List<Map<String, String>> getTasksForShipper(String shipperUsername) throws ValidationException {
        List<Map<String, String>> resultList = new ArrayList<>();
        List<Map<String, Object>> tasks = deliveryDAO.getTasksByShipper(shipperUsername);
        for (Map<String, Object> t : tasks) {
            resultList.add(buildTaskMap(t));
        }
        return resultList;
    }

    public List<Map<String, String>> getAvailableTasksForShipper(String shipperUsername) throws ValidationException {
        List<Map<String, String>> resultList = new ArrayList<>();
        List<Map<String, Object>> tasks = deliveryDAO.getAvailableTasksForShipper(shipperUsername);
        for (Map<String, Object> t : tasks) {
            resultList.add(buildTaskMap(t));
        }
        return resultList;
    }

    public List<Map<String, String>> getAvailableShippers() throws ValidationException {
        List<Map<String, String>> resultList = new ArrayList<>();
        List<User> allUsers = userDAO.getAllUsers(); 

        if (allUsers != null) {
            for (User u : allUsers) {
                if (Constants.ROLE_SHIPPER.equalsIgnoreCase(u.getRole())) {
                    Map<String, String> statusInfo = buildShipperStatusMap(u.getUsername());
                    resultList.add(buildShipperMap(u, statusInfo));
                }
            }
        }
        return resultList;
    }

    public List<Map<String, String>> getUnassignedTasks() throws ValidationException {
        List<Map<String, String>> unassignedList = new ArrayList<>();
        List<Map<String, Object>> allTasks = deliveryDAO.getAllTasks();
        for (Map<String, Object> t : allTasks) {
            if (isTaskWaitingForShipper(t)) {
                unassignedList.add(buildTaskMap(t));
            }
        }
        return unassignedList;
    }

    public void assignTaskToShipper(String taskIdStr, String shipperUsername) throws ValidationException {
        int taskId = parseTaskId(taskIdStr);
        Map<String, Object> task = getAndValidateTask(taskId);
        
        validateTaskIsFree(task);
        validateShipperCapacity(shipperUsername); 
        
        deliveryDAO.updateTaskShipper(taskId, shipperUsername); 
        deliveryDAO.updateTaskStatus(taskId, Constants.STATUS_WAITING_DELIVERY);

        int shipperId = deliveryDAO.getUserIdByUsername(shipperUsername);
        if (shipperId > 0) {
            DeliveryStatusHistory history = new DeliveryStatusHistory(
                    0, taskId, shipperId, Constants.STATUS_WAITING_DELIVERY,
                    Constants.NOTE_DISPATCH_ASSIGN, null, new Timestamp(System.currentTimeMillis())
            );
            deliveryDAO.insertStatusHistory(history);
            syncShipperProfileStatus(shipperId, shipperUsername);
        }
    }

    public void updateShipperTaskStatus(String taskIdStr, String shipperUsername, String newStatus) throws ValidationException {
        updateShipperTaskStatus(taskIdStr, shipperUsername, newStatus, null, null);
    }

    public void updateShipperTaskStatus(String taskIdStr, String shipperUsername, String newStatus, String failReason, String proofImage) throws ValidationException {
        int taskId = parseTaskId(taskIdStr);
        Map<String, Object> task = getAndValidateTask(taskId);

        validateShipperAuthorization(shipperUsername, (String) task.get("shipperUsername"));
        validateStatusFlow((String) task.get("status"));

        if (Constants.STATUS_FAILED.equals(newStatus)) {
            if (failReason == null || failReason.trim().isEmpty()) {
                throw new ValidationException(Constants.ERROR_EMPTY_FAIL_REASON);
            }
        }

        deliveryDAO.updateTaskStatus(taskId, newStatus);

        int shipperId = deliveryDAO.getUserIdByUsername(shipperUsername);
        if (shipperId > 0) {
            DeliveryStatusHistory history = new DeliveryStatusHistory(
                    0, taskId, shipperId, newStatus,
                    (failReason != null && !failReason.trim().isEmpty()) ? failReason.trim() : null,
                    proofImage, new Timestamp(System.currentTimeMillis())
            );
            deliveryDAO.insertStatusHistory(history);
            syncShipperProfileStatus(shipperId, shipperUsername);
        }
    }

    public void claimTask(String taskIdStr, String shipperUsername) throws ValidationException {
        int taskId = parseTaskId(taskIdStr);
        Map<String, Object> task = getAndValidateTask(taskId);

        validateTaskIsFree(task);
        validateShipperCapacity(shipperUsername);

        deliveryDAO.claimTask(taskId, shipperUsername);

        int shipperId = deliveryDAO.getUserIdByUsername(shipperUsername);
        if (shipperId > 0) {
            DeliveryStatusHistory history = new DeliveryStatusHistory(
                    0, taskId, shipperId, Constants.STATUS_DELIVERING,
                    Constants.NOTE_SHIPPER_CLAIM, null, new Timestamp(System.currentTimeMillis())
            );
            deliveryDAO.insertStatusHistory(history);
            syncShipperProfileStatus(shipperId, shipperUsername);
        }
    }

    public void acceptTask(String taskIdStr, String shipperUsername) throws ValidationException {
        int taskId = parseTaskId(taskIdStr);
        Map<String, Object> task = getAndValidateTask(taskId);

        validateShipperAuthorization(shipperUsername, (String) task.get("shipperUsername"));
        validateTaskIsPending(task);

        deliveryDAO.updateTaskStatus(taskId, Constants.STATUS_DELIVERING);

        int shipperId = deliveryDAO.getUserIdByUsername(shipperUsername);
        if (shipperId > 0) {
            DeliveryStatusHistory history = new DeliveryStatusHistory(
                    0, taskId, shipperId, Constants.STATUS_DELIVERING,
                    Constants.NOTE_SHIPPER_ACCEPT, null, new Timestamp(System.currentTimeMillis())
            );
            deliveryDAO.insertStatusHistory(history);
            syncShipperProfileStatus(shipperId, shipperUsername);
        }
    }

    public void rejectTask(String taskIdStr, String shipperUsername) throws ValidationException {
        int taskId = parseTaskId(taskIdStr);
        Map<String, Object> task = getAndValidateTask(taskId);

        validateShipperAuthorization(shipperUsername, (String) task.get("shipperUsername"));
        validateTaskIsPending(task); 

        int shipperId = deliveryDAO.getUserIdByUsername(shipperUsername);

        deliveryDAO.updateTaskShipper(taskId, null); 
        deliveryDAO.updateTaskStatus(taskId, Constants.STATUS_WAITING_DISPATCH);

        if (shipperId > 0) {
            DeliveryStatusHistory history = new DeliveryStatusHistory(
                    0, taskId, shipperId, Constants.STATUS_WAITING_DISPATCH,
                    Constants.NOTE_SHIPPER_REJECT, null, new Timestamp(System.currentTimeMillis())
            );
            deliveryDAO.insertStatusHistory(history);
            syncShipperProfileStatus(shipperId, shipperUsername);
        }
    }

    public void revokeTask(String taskIdStr) throws ValidationException {
        int taskId = parseTaskId(taskIdStr);
        Map<String, Object> task = getAndValidateTask(taskId);
        String currentStatus = (String) task.get("status");

        if (!Constants.STATUS_WAITING_DELIVERY.equals(currentStatus)) {
            throw new ValidationException(Constants.ERROR_INVALID_STATUS_FLOW);
        }

        String shipperUsername = (String) task.get("shipperUsername");
        int shipperId = (shipperUsername != null) ? deliveryDAO.getUserIdByUsername(shipperUsername) : 0;

        deliveryDAO.revokeTaskFromShipper(taskId);

        if (shipperId > 0) {
            DeliveryStatusHistory history = new DeliveryStatusHistory(
                    0, taskId, shipperId, Constants.STATUS_WAITING_DISPATCH,
                    Constants.NOTE_DISPATCH_REVOKE, null, new Timestamp(System.currentTimeMillis())
            );
            deliveryDAO.insertStatusHistory(history);
            syncShipperProfileStatus(shipperId, shipperUsername);
        }
    }

    public List<Map<String, String>> getAssignedPendingTasks() throws ValidationException {
        List<Map<String, String>> resultList = new ArrayList<>();
        List<Map<String, Object>> tasks = deliveryDAO.getAssignedPendingTasks();
        for (Map<String, Object> t : tasks) {
            Map<String, String> m = buildTaskMap(t);
            m.put("shipperFullName", t.get("shipperFullName") != null ? (String) t.get("shipperFullName") : "");
            resultList.add(m);
        }
        return resultList;
    }

    private Map<String, String> buildTaskMap(Map<String, Object> task) {
        Map<String, String> map = new HashMap<>();
        map.put("taskId", String.valueOf(task.get("taskId")));
        map.put("orderCode", (String) task.get("orderCode"));
        map.put("customerAddress", task.get("customerAddress") != null ? (String) task.get("customerAddress") : "");
        map.put("status", task.get("status") != null ? (String) task.get("status") : "");
        map.put("customerName", task.get("customerName") != null ? (String) task.get("customerName") : "");
        map.put("customerPhone", task.get("customerPhone") != null ? (String) task.get("customerPhone") : "");
        map.put("areaName", task.get("areaName") != null ? (String) task.get("areaName") : "");
        double total = (task.get("totalAmount") instanceof Number) ? ((Number) task.get("totalAmount")).doubleValue() : 0.0;
        map.put("totalAmount", String.format("%,.0f", total));
        map.put("shipperUsername", task.get("shipperUsername") != null ? (String) task.get("shipperUsername") : "");
        return map;
    }

    private Map<String, String> buildShipperStatusMap(String username) throws ValidationException {
        int activeOrders = countActiveOrders(username); 
        ShipperProfile profile = deliveryDAO.getShipperProfileByUsername(username);
        int maxOrders = (profile != null && profile.getMaxOrders() > 0) ? profile.getMaxOrders() : Constants.DEFAULT_SHIPPER_MAX_ORDERS;

        Map<String, String> statusMap = new HashMap<>();
        statusMap.put("workingStatus", (activeOrders == 0) ? Constants.SHIPPER_WORK_READY : Constants.SHIPPER_WORK_DELIVERING);
        statusMap.put("activeOrders", String.valueOf(activeOrders));
        statusMap.put("maxOrders", String.valueOf(maxOrders));
        return statusMap;
    }
    
    private Map<String, String> buildShipperMap(User u, Map<String, String> statusInfo) {
        Map<String, String> map = new HashMap<>();
        map.put("username", u.getUsername());
        map.put("fullName", u.getFullName());
        map.put("address", u.getAddress());
        map.put("phone", u.getPrimaryPhone());
        map.putAll(statusInfo); 
        return map;
    }

    public int countActiveOrders(String username) throws ValidationException {
        int count = 0;
        List<Map<String, Object>> tasks = deliveryDAO.getTasksByShipper(username);
        for (Map<String, Object> t : tasks) {
            String s = (String) t.get("status");
            if (Constants.STATUS_DELIVERING.equalsIgnoreCase(s) || Constants.STATUS_WAITING_DELIVERY.equalsIgnoreCase(s)) {
                count++;
            }
        }
        return count;
    }

    private boolean isTaskWaitingForShipper(Map<String, Object> t) {
        String status = (String) t.get("status");
        String shipper = (String) t.get("shipperUsername");
        boolean isStatusWaiting = Constants.STATUS_WAITING_DISPATCH.equals(status)
                || Constants.STATUS_WAITING_DELIVERY.equals(status);
        boolean isShipperEmpty = (shipper == null || shipper.trim().isEmpty());
        return isStatusWaiting && isShipperEmpty;
    }

    private int parseTaskId(String taskIdStr) throws ValidationException {
        try {
            return Integer.parseInt(taskIdStr);
        } catch (NumberFormatException e) {
            throw new ValidationException(Constants.ERROR_INVALID_TASK);
        }
    }

    private Map<String, Object> getAndValidateTask(int taskId) throws ValidationException {
        Map<String, Object> task = deliveryDAO.getTaskById(taskId);
        if (task == null) {
            throw new ValidationException(Constants.ERROR_INVALID_TASK);
        }
        return task;
    }

    private void validateShipperAuthorization(String loggedInShipper, String assignedShipper) throws ValidationException {
        if (!loggedInShipper.equals(assignedShipper)) {
            throw new ValidationException(Constants.ERROR_UNAUTHORIZED_SHIPPER);
        }
    }

    private void validateStatusFlow(String currentStatus) throws ValidationException {
        if (Constants.STATUS_COMPLETED.equals(currentStatus) || Constants.STATUS_FAILED.equals(currentStatus)) {
            throw new ValidationException(Constants.ERROR_INVALID_STATUS_FLOW);
        }
    }

    private void validateTaskIsFree(Map<String, Object> task) throws ValidationException {
        String shipper = (String) task.get("shipperUsername");
        if (shipper != null && !shipper.trim().isEmpty()) {
            throw new ValidationException(Constants.ERROR_TASK_ALREADY_ASSIGNED); 
        }
    }

    private void validateShipperCapacity(String shipperUsername) throws ValidationException {
        ShipperProfile profile = deliveryDAO.getShipperProfileByUsername(shipperUsername);
        int maxAllowed = (profile != null && profile.getMaxOrders() > 0) ? profile.getMaxOrders() : Constants.DEFAULT_SHIPPER_MAX_ORDERS;
        int activeCount = countActiveOrders(shipperUsername);
        if (activeCount >= maxAllowed) { 
            throw new ValidationException(Constants.ERROR_SHIPPER_FULL); 
        }
    }

    private void validateTaskIsPending(Map<String, Object> task) throws ValidationException {
        String status = (String) task.get("status");
        if (!Constants.STATUS_WAITING_DELIVERY.equals(status)
                && !Constants.STATUS_PENDING.equals(status)
                && !Constants.STATUS_WAITING_DISPATCH.equals(status)) {
            throw new ValidationException(Constants.ERROR_CANNOT_REJECT); 
        }
    }

    private void syncShipperProfileStatus(int shipperId, String username) throws ValidationException {
        int activeCount = countActiveOrders(username);
        String status = (activeCount == 0) ? Constants.SHIPPER_STATUS_READY : Constants.SHIPPER_STATUS_DELIVERING;
        deliveryDAO.updateShipperStatusAndCount(shipperId, status, activeCount);
    }

    public List<Map<String, String>> getAllDeliveryAreasForView() throws ValidationException {
        List<Map<String, String>> list = new ArrayList<>();
        List<DeliveryArea> areas = deliveryDAO.getAllDeliveryAreas();
        for (DeliveryArea a : areas) {
            Map<String, String> m = new HashMap<>();
            m.put("areaId", String.valueOf(a.getAreaId()));
            m.put("areaName", a.getAreaName());
            list.add(m);
        }
        return list;
    }
}
</file>

<file path="web/components/product_form_modal.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<fmt:setLocale value="${not empty cookie.LANG.value ? cookie.LANG.value : 'vi'}" />
<fmt:setBundle basename="resources.messages" />

<div id="productModal" class="modal-overlay d-none"
     data-title-add="<fmt:message key="menu.modal.title.add" />"
     data-title-edit="<fmt:message key="menu.modal.title.edit" />"
     data-error-size="<fmt:message key="E1013" />"
     data-error-recipe="<fmt:message key="E0212" />"
>
    <div class="modal-card modal-card-md">
        <div class="modal-header">
            <h3 id="productModalTitle" class="m-0"><fmt:message key="menu.modal.title.add" /></h3>
            <button type="button" class="btn-modal-close" data-close-modal="productModal"><i class="fi fi-rr-cross-small" aria-hidden="true"></i></button>
        </div>

        <form id="productForm" action="${pageContext.request.contextPath}/MenuManagementController" method="POST" enctype="multipart/form-data" class="m-0">
            <div class="modal-body">
                <input type="hidden" id="productModalAction" name="action" value="createProduct" />
                <input type="hidden" id="productModalId" name="productId" value="" />
                <input type="hidden" name="filterCategory" value="${CURRENT_FILTER_CATEGORY}" />

                <div class="form-group mb-15">
                    <label for="productNameInput" class="form-label font-bold">
                        <fmt:message key="menu.modal.label.name" /> <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="productNameInput" name="productName" required
                           class="filter-input w-100"
                           placeholder="<fmt:message key="menu.modal.placeholder.name" />" />
                </div>

                <div class="form-group mb-15">
                    <label for="productCategorySelect" class="form-label font-bold">
                        <fmt:message key="menu.modal.label.category" /> <span class="text-danger">*</span>
                    </label>
                    <select id="productCategorySelect" name="categoryId" required class="filter-input w-100">
                        <option value=""><fmt:message key="menu.mgmt.filter.category" /></option>
                        <c:forEach var="cat" items="${CATEGORY_LIST}">
                            <option value="${cat.categoryId}"><c:out value="${cat.categoryName}" /></option>
                        </c:forEach>
                    </select>
                </div>

                <div class="form-group mb-15">
                    <label for="productPriceInput" class="form-label font-bold">
                        <fmt:message key="menu.modal.label.price" /> <span class="text-danger">*</span>
                    </label>
                    <input type="number" id="productPriceInput" name="price" min="1000" step="1000" required
                           class="filter-input w-100"
                           placeholder="<fmt:message key="menu.modal.placeholder.price" />" />
                </div>

                <%-- Thông tin hiển thị ở popup chi tiết món (màn đặt món) --%>
                <div class="form-group mb-15">
                    <label for="productDescInput" class="form-label font-bold"><fmt:message key="menu.mgmt.label.description" /></label>
                    <textarea id="productDescInput" name="description" rows="2" maxlength="500" class="filter-input w-100"
                              placeholder="<fmt:message key='menu.mgmt.placeholder.description' />"></textarea>
                </div>
                <div class="form-group mb-15">
                    <label for="productVideoInput" class="form-label font-bold"><fmt:message key="menu.mgmt.label.video" /></label>
                    <input type="url" id="productVideoInput" name="videoUrl" maxlength="255" class="filter-input w-100" placeholder="https://" />
                </div>
                <div class="form-group mb-15 product-flag-group">
                    <%-- Input hidden "false" đứng trước checkbox: không tick vẫn gửi "false" để Controller phân biệt --%>
                    <input type="hidden" name="isFeatured" value="false" />
                    <label class="product-flag"><input type="checkbox" id="productFeaturedCheckbox" name="isFeatured" value="true" />
                        <fmt:message key="menu.mgmt.label.featured" /></label>
                    <input type="hidden" name="hasOptions" value="false" />
                    <label class="product-flag"><input type="checkbox" id="productHasOptionsCheckbox" name="hasOptions" value="true" checked />
                        <fmt:message key="menu.mgmt.label.has_options" /></label>
                </div>

                <div class="form-group mb-15">
                    <label class="form-label font-bold mb-5"><fmt:message key="menu.mgmt.table.image" /></label>
                    <div class="image-tab-bar mb-10">
                        <button type="button" id="tabBtnUpload" class="btn-image-tab active" data-action="switch-image-tab" data-image-tab="upload">
                            <fmt:message key="menu.modal.tab.upload_file" />
                        </button>
                        <button type="button" id="tabBtnUrl" class="btn-image-tab" data-action="switch-image-tab" data-image-tab="url">
                            <fmt:message key="menu.modal.tab.url_link" />
                        </button>
                    </div>

                    <!-- Tab 1: Upload File -->
                    <div id="imageUploadPanel" class="image-panel">
                        <input type="file" id="productImageFileInput" name="productImageFile"
                               accept=".jpg,.jpeg,.png,.webp" class="filter-input w-100"
                               data-action="preview-uploaded-image" />
                        <div class="form-hint-text mt-5"><fmt:message key="menu.modal.upload_hint" /></div>
                    </div>

                    <!-- Tab 2: URL Link -->
                    <div id="imageUrlPanel" class="image-panel d-none">
                        <input type="text" id="productImageInput" name="imageUrl"
                               maxlength="255"
                               class="filter-input w-100"
                               placeholder="<fmt:message key="menu.modal.placeholder.image" />"
                               data-action="preview-url-image" />
                        <div class="form-hint-text mt-5"><fmt:message key="menu.modal.url_hint" /></div>
                    </div>

                    <!-- Khung xem truoc anh -->
                    <div id="imagePreviewBox" class="image-preview-container d-none mt-10">
                        <div class="preview-title"><fmt:message key="menu.modal.preview.title" /></div>
                        <img id="imagePreviewImg" src="" alt="Preview" class="preview-thumb" />
                    </div>
                </div>

                <!-- Recipe Formulation Section -->
                <div class="form-group mb-15">
                    <div class="flex-between flex-align-center mb-8">
                        <label class="form-label font-bold m-0">
                            <fmt:message key="menu.modal.label.recipe" />
                        </label>
                        <button type="button" class="btn-action-add-recipe" data-action="add-recipe-row">
                            <fmt:message key="menu.modal.btn.add_ingredient" />
                        </button>
                    </div>

                    <!-- Hidden template select for ingredients -->
                    <select id="ingredientMasterTemplate" class="d-none">
                        <option value="" data-unit="">-- <fmt:message key="menu.modal.recipe.select_placeholder" /> --</option>
                        <c:forEach var="ing" items="${INGREDIENT_LIST}">
                            <option value="${ing.ingredientId}" data-unit="${fn:escapeXml(ing.unit)}">${fn:escapeXml(ing.ingredientName)} (${fn:escapeXml(ing.unit)})</option>
                        </c:forEach>
                    </select>

                    <div id="recipeContainer" class="recipe-container">
                        <div id="recipeEmptyHint" class="recipe-empty-hint">
                            <fmt:message key="menu.modal.recipe.empty_hint" />
                        </div>
                        <div id="recipeList" class="recipe-list"></div>
                    </div>
                </div>

                <div id="productStatusGroup" class="form-group mb-15 d-none">
                    <label class="form-label font-bold"><fmt:message key="menu.modal.label.status" /></label>
                    <div class="flex-align-center gap-10 mt-5">
                        <input type="checkbox" id="productAvailableCheckbox" name="isAvailable" value="true" checked />
                        <label for="productAvailableCheckbox" id="productAvailableLabel">
                            <fmt:message key="menu.mgmt.status.active" />
                        </label>
                    </div>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-order-cancel" data-close-modal="productModal">
                    <fmt:message key="menu.modal.btn.cancel" />
                </button>
                <button type="submit" id="productModalSubmitBtn" class="btn-login">
                    <fmt:message key="menu.modal.btn.save" />
                </button>
            </div>
        </form>
    </div>
</div>

<%-- MODAL 2: QUẢN LÝ DANH MỤC THỰC ĐƠN --%>
<div id="menuCategoryModal" class="modal-overlay d-none">
    <div class="modal-card modal-card-md">
        <div class="modal-header">
            <h3 class="m-0"><fmt:message key="menu.category.modal.title" /></h3>
            <button type="button" class="btn-modal-close" data-close-modal="menuCategoryModal"><i class="fi fi-rr-cross-small" aria-hidden="true"></i></button>
        </div>

        <div class="modal-body">
            <%-- Form thêm danh mục mới --%>
            <form action="${pageContext.request.contextPath}/MenuManagementController" method="POST" class="mb-20 p-15 card bg-light">
                <input type="hidden" name="action" value="createCategory" />
                <label for="newMenuCategoryName" class="form-label font-bold mb-5 d-block">
                    <fmt:message key="menu.category.label.name" /> <span class="text-danger">*</span>
                </label>
                <div class="d-flex gap-10">
                    <input type="text" id="newMenuCategoryName" name="categoryName" required maxlength="100"
                           class="filter-input flex-grow-1"
                           placeholder="<fmt:message key="menu.category.placeholder.name" />" />
                    <button type="submit" class="btn-login btn-sm">
                        + <fmt:message key="menu.category.btn.create" />
                    </button>
                </div>
            </form>

            <%-- Bảng danh sách danh mục hiện có --%>
            <h4 class="mb-10"><fmt:message key="menu.category.table.title" /></h4>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="w-60">ID</th>
                        <th><fmt:message key="menu.category.table.name" /></th>
                        <th class="w-120 text-center"><fmt:message key="menu.category.table.status" /></th>
                        <th class="w-100 text-center"><fmt:message key="menu.category.table.action" /></th>
                    </tr>
                </thead>
                <tbody>
                    <c:choose>
                        <c:when test="${not empty CATEGORY_LIST}">
                            <c:forEach var="cat" items="${CATEGORY_LIST}">
                                <tr>
                                    <td>${cat.categoryId}</td>
                                    <td><strong><c:out value="${cat.categoryName}" /></strong></td>
                                    <td class="text-center">
                                        <c:choose>
                                            <c:when test="${cat.inUse}">
                                                <span class="role-badge role-manager">
                                                    <fmt:message key="menu.category.status.in_use" />
                                                </span>
                                            </c:when>
                                            <c:otherwise>
                                                <span class="role-badge role-staff">
                                                    <fmt:message key="menu.category.status.empty" />
                                                </span>
                                            </c:otherwise>
                                        </c:choose>
                                    </td>
                                    <td class="text-center">
                                        <c:choose>
                                            <c:when test="${not cat.inUse}">
                                                <form action="${pageContext.request.contextPath}/MenuManagementController" method="POST" class="m-0 d-inline">
                                                    <input type="hidden" name="action" value="deleteCategory" />
                                                    <input type="hidden" name="categoryId" value="${cat.categoryId}" />
                                                    <button type="submit" class="btn-reject btn-sm"
                                                            data-confirm="<fmt:message key="menu.category.confirm.delete" />">
                                                        <fmt:message key="menu.category.btn.delete" />
                                                    </button>
                                                </form>
                                            </c:when>
                                            <c:otherwise>
                                                <span class="text-muted">-</span>
                                            </c:otherwise>
                                        </c:choose>
                                    </td>
                                </tr>
                            </c:forEach>
                        </c:when>
                        <c:otherwise>
                            <tr>
                                <td colspan="4" class="text-center"><fmt:message key="menu.category.empty" /></td>
                            </tr>
                        </c:otherwise>
                    </c:choose>
                </tbody>
            </table>
        </div>

        <div class="modal-actions">
            <button type="button" class="btn-order-cancel" data-close-modal="menuCategoryModal">
                <fmt:message key="menu.modal.btn.cancel" />
            </button>
        </div>
    </div>
</div>
</file>

<file path="web/admin_dashboard.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="currentLang" value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setLocale value="${currentLang}" />
<fmt:setBundle basename="resources.messages" />

<jsp:include page="header.jsp" />
<main class="main-content">
        <div class="dashboard-wrapper">
            <h2><fmt:message key="admin.dashbard.titile" /></h2>
            <c:if test="${not empty ERROR_MESSAGE}">
                <p class="msg-error"><fmt:message key="${ERROR_MESSAGE}" /></p>
            </c:if>
            <c:if test="${not empty SUCCESS_MESSAGE}">
                <p class="msg-success"><fmt:message key="${SUCCESS_MESSAGE}" /></p>
            </c:if>
            <c:remove var="ERROR_MESSAGE" scope="session" />
            <c:remove var="SUCCESS_MESSAGE" scope="session" />

            <div class="tab-nav d-flex">
                <button class="tab-btn ${empty param.tab || param.tab == 'tab-users' ? 'active' : ''}" data-tab="tab-users"><fmt:message key="admin.dashboard.tab.users" /></button>
                <button class="tab-btn ${param.tab == 'tab-keys' ? 'active' : ''}" data-tab="tab-keys"><fmt:message key="admin.dashboard.tab.keys" /></button>
                <button class="tab-btn ${param.tab == 'tab-passwords' ? 'active' : ''}" data-tab="tab-passwords"><fmt:message key="admin.dashboard.tab.passwords" /></button>
            </div>

            <div id="tab-users" class="tab-content ${empty param.tab || param.tab == 'tab-users' ? 'active' : 'd-none'}">
                <h3><fmt:message key="admin.dashboard.tab1.title" /></h3>
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th><fmt:message key="admin.dashboard.table.id" /></th>
                            <th><fmt:message key="admin.dashboard.table.username" /></th>
                            <th><fmt:message key="admin.dashboard.table.fullname" /></th>
                            <th><fmt:message key="admin.dashboard.table.role" /></th>
                            <th><fmt:message key="admin.dashboard.table.hiredate" /></th>
                            <th><fmt:message key="admin.dashboard.table.status" /></th>
                            <th><fmt:message key="admin.dashboard.table.action" /></th>
                        </tr>
                    </thead>
                    <tbody>
                        <c:choose>
                            <c:when test="${not empty USER_LIST}">
                                <c:forEach var="user" items="${USER_LIST}">
                                    <tr>
                                        <td>${user.userID}</td>
                                        <td><c:out value="${user.username}" /></td>
                                        <td><c:out value="${user.fullName}" /></td>
                                        <td>
                                            <c:choose>
                                                <c:when test="${user.username == sessionScope.USER_SESSION.username || user.role == 'Admin'}">
                                                    <span class="role-badge ${user.role == 'Admin' ? 'role-admin' : (user.role == 'Manager' ? 'role-manager' : (user.role == 'Shipper' ? 'role-shipper' : 'role-staff'))}">
                                                        ${user.role}
                                                    </span>
                                                </c:when>
                                                <c:otherwise>
                                                    <form action="${pageContext.request.contextPath}/AdminDashboardController" method="POST" class="d-flex gap-5 flex-align-center m-0">
                                                        <input type="hidden" name="action" value="changeRole" />
                                                        <input type="hidden" name="targetUserId" value="${user.userID}" />
                                                        <select name="newRole" class="select-role-inline">
                                                            <option value="Manager" ${user.role == 'Manager' ? 'selected' : ''}>Manager</option>
                                                            <option value="Staff" ${user.role == 'Staff' ? 'selected' : ''}>Staff</option>
                                                            <option value="Shipper" ${user.role == 'Shipper' ? 'selected' : ''}>Shipper</option>
                                                        </select>
                                                        <button type="submit" class="btn-login btn-sm" title="<fmt:message key='admin.dashboard.btn.save_role' />">
                                                            <fmt:message key="admin.dashboard.btn.save_role" />
                                                        </button>
                                                    </form>
                                                </c:otherwise>
                                            </c:choose>
                                        </td>
                                        <td>
                                            <c:choose>
                                                <c:when test="${not empty user.hireDate}">
                                                    <fmt:formatDate value="${user.hireDate}" pattern="dd/MM/yyyy" />
                                                </c:when>
                                                <c:otherwise>-</c:otherwise>
                                            </c:choose>
                                        </td>
                                        <td>
                                            <span class="${user.active ? 'msg-success' : 'msg-error'}">
                                                <fmt:message key="${user.active ? 'admin.dashboard.status.active' : 'admin.dashboard.status.locked'}" />
                                            </span>
                                        </td>
                                        <td>
                                            <c:choose>
                                                <c:when test="${user.username == sessionScope.USER_SESSION.username}">
                                                    <span class="msg-error"><fmt:message key="admin.dashboard.status.current_user" /></span>
                                                </c:when>
                                                <c:otherwise>
                                                    <form action="${pageContext.request.contextPath}/AdminDashboardController" method="POST" class="m-0">
                                                        <input type="hidden" name="action" value="toggleUser" />
                                                        <input type="hidden" name="userId" value="${user.userID}" />
                                                        <button type="submit" class="btn-login btn-sm">
                                                            <fmt:message key="admin.dashboard.btn.toggle" />
                                                        </button>
                                                    </form>
                                                </c:otherwise>
                                            </c:choose>
                                        </td>
                                    </tr>
                                </c:forEach>
                            </c:when>
                            <c:otherwise>
                                <tr>
                                    <td colspan="7" class="text-center"><fmt:message key="admin.dashboard.empty.users" /></td>
                                </tr>
                            </c:otherwise>
                        </c:choose>
                    </tbody>
                </table>
            </div>

            <div id="tab-keys" class="tab-content ${param.tab == 'tab-keys' ? 'active' : 'd-none'}">
                <div class="flex-between">
                    <h3><fmt:message key="admin.dashboard.tab2.title" /></h3>

                    <form action="${pageContext.request.contextPath}/AdminDashboardController" method="POST" class="d-flex gap-10 flex-align-center m-0">
                        <input type="hidden" name="action" value="generateKey" />
                        <label for="ddlRole"><fmt:message key="admin.dashboard.label.grant_role" /></label>
                        <select name="ddlRole" id="ddlRole" class="register-select w-auto mt-0">
                            <option value="Manager">Manager</option>
                            <option value="Staff">Staff</option>
                            <option value="Shipper">Shipper</option>
                        </select>
                        <input type="submit" class="btn-register-action mt-0" value="<fmt:message key='admin.dashboard.btn.create_key' />" />
                    </form>
                </div>

                <table class="admin-table mt-15">
                    <thead>
                        <tr>
                            <th><fmt:message key="admin.dashboard.table.key" /></th>
                            <th><fmt:message key="admin.dashboard.table.grant_role" /></th>
                            <th><fmt:message key="admin.dashboard.table.user_id" /></th>
                            <th><fmt:message key="admin.dashboard.table.status" /></th>
                            <th><fmt:message key="admin.dashboard.table.created_date" /></th>
                            <th><fmt:message key="admin.dashboard.table.action" /></th>
                        </tr>
                    </thead>
                    <tbody>
                        <c:choose>
                            <c:when test="${not empty KEY_LIST}">
                                <c:forEach var="key" items="${KEY_LIST}">
                                    <tr>
                                        <td><strong>${key.securityKey}</strong></td>
                                        <td>${key.role}</td>
                                        <td>
                                            <c:choose>
                                                <c:when test="${key.userId != null}">${key.userId}</c:when>
                                                <c:otherwise><fmt:message key="admin.dashboard.status.unused" /></c:otherwise>
                                            </c:choose>
                                        </td>
                                        <td>
                                            <c:choose>
                                                <c:when test="${!key.active}">
                                                    <span class="msg-error">
                                                        <fmt:message key="admin.dashboard.status.locked_key" />
                                                    </span>
                                                </c:when>
                                                <c:when test="${key.userId != null}">
                                                    <span class="msg-warning">
                                                        <fmt:message key="admin.dashboard.status.used_key" />
                                                    </span>
                                                </c:when>
                                                <c:otherwise>
                                                    <span class="msg-success">
                                                        <fmt:message key="admin.dashboard.status.unused_key" />
                                                    </span>
                                                </c:otherwise>
                                            </c:choose>
                                        </td>
                                        <td><fmt:formatDate value="${key.createdAt}" pattern="dd/MM/yyyy HH:mm" /></td>
                                        <td>
                                            <c:choose>
                                                <c:when test="${key.active and empty key.userId}">
                                                    <form action="${pageContext.request.contextPath}/AdminDashboardController" method="POST" class="m-0">
                                                        <input type="hidden" name="action" value="revokeKey" />
                                                        <input type="hidden" name="keyId" value="${key.keyId}" />
                                                        <button type="submit" class="btn-reject btn-sm" data-confirm="<fmt:message key="admin.dashboard.confirm.revoke_key" />">
                                                            <fmt:message key="admin.dashboard.btn.revoke_key" />
                                                        </button>
                                                    </form>
                                                </c:when>
                                                <c:otherwise>
                                                    -
                                                </c:otherwise>
                                            </c:choose>
                                        </td>
                                    </tr>
                                </c:forEach>
                            </c:when>
                            <c:otherwise>
                                <tr>
                                    <td colspan="6" class="text-center"><fmt:message key="admin.dashboard.empty.keys" /></td>
                                </tr>
                            </c:otherwise>
                        </c:choose>
                    </tbody>
                </table>
            </div>

            <div id="tab-passwords" class="tab-content ${param.tab == 'tab-passwords' ? 'active' : 'd-none'}">
                <h3><fmt:message key="admin.dashboard.tab3.title" /></h3>
                <p class="text-muted"><fmt:message key="admin.dashboard.tab3.desc" /></p>
                <div class="admin-password-box mt-15">
                    <form action="${pageContext.request.contextPath}/AdminDashboardController" method="POST" class="m-0">
                        <input type="hidden" name="action" value="resetPassword" />

                        <div class="form-group mb-15">
                            <label for="targetUserId" class="d-block font-weight-bold mb-5">
                                <fmt:message key="admin.dashboard.label.select_user" />:
                            </label>
                            <select name="targetUserId" id="targetUserId" class="register-select w-100 mt-0" required>
                                <option value=""><fmt:message key="admin.dashboard.select.choose_user" /></option>
                                <c:forEach var="user" items="${USER_LIST}">
                                    <c:if test="${user.username != sessionScope.USER_SESSION.username}">
                                        <option value="${user.userID}">
                                            <c:out value="${user.fullName}" /> (@<c:out value="${user.username}" />) - [${user.role}]
                                        </option>
                                    </c:if>
                                </c:forEach>
                            </select>
                        </div>

                        <div class="form-group mb-15">
                            <label for="newPassword" class="d-block font-weight-bold mb-5">
                                <fmt:message key="admin.dashboard.label.new_password" />:
                            </label>
                            <input type="password" name="newPassword" id="newPassword" class="register-input w-100 mt-0" required minlength="3" placeholder="<fmt:message key='admin.dashboard.placeholder.new_password' />" />
                        </div>

                        <div class="form-group mb-20">
                            <label for="confirmPassword" class="d-block font-weight-bold mb-5">
                                <fmt:message key="admin.dashboard.label.confirm_password" />:
                            </label>
                            <input type="password" name="confirmPassword" id="confirmPassword" class="register-input w-100 mt-0" required minlength="3" placeholder="<fmt:message key='admin.dashboard.placeholder.confirm_password' />" />
                        </div>

                        <input type="submit" class="btn-register-action mt-0" value="<fmt:message key='admin.dashboard.btn.reset_password' />" />
                    </form>
                </div>
            </div>
        </div>
</main>
<jsp:include page="footer.jsp" />
</file>

<file path="web/dispatch_dashboard.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<c:set var="currentLang" value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setLocale value="${currentLang}" />
<fmt:setBundle basename="resources.messages" />

<jsp:include page="header.jsp" />

<%-- Gom tên khu vực (không trùng) của các đơn chờ gán, ngăn bởi "|"; đơn chưa có khu vực gom vào "-" --%>
<c:set var="areas" value="|" />
<c:forEach var="task" items="${UNASSIGNED_TASKS}">
    <c:set var="areaKey" value="${empty task.areaName ? '-' : fn:replace(task.areaName, '|', '/')}" />
    <c:set var="needle" value="|${areaKey}|" />
    <c:if test="${not fn:contains(areas, needle)}">
        <c:set var="areas" value="${areas}${areaKey}|" />
    </c:if>
</c:forEach>

<%-- Bố cục F: khu vực + hàng chờ. Trái: mỗi khu vực 1 cột đơn chờ gán (chọn shipper ngay trên thẻ);
     phải: tải từng shipper + đơn đã gán đang chờ shipper nhận (thu hồi được). Giữ nguyên form gán / thu hồi của DispatchController --%>
<main class="main-content">
    <div class="page-head">
        <h2><fmt:message key="dispatch.title" /></h2>
    </div>

    <c:if test="${not empty SUCCESS_MESSAGE}">
        <div class="alert alert-success"><fmt:message key="${SUCCESS_MESSAGE}" /></div>
    </c:if>
    <c:if test="${not empty ERROR_MESSAGE}">
        <div class="alert alert-danger"><fmt:message key="${ERROR_MESSAGE}" /></div>
    </c:if>

    <div class="dispatch-board">
        <section>
            <h3 class="panel-title"><fmt:message key="dispatch.list.title" /> (${fn:length(UNASSIGNED_TASKS)})</h3>
            <c:choose>
                <c:when test="${empty UNASSIGNED_TASKS}">
                    <p class="panel todo-empty"><fmt:message key="dispatch.msg.empty" /></p>
                </c:when>
                <c:otherwise>
                    <div class="area-columns">
                        <c:forTokens var="area" items="${areas}" delims="|">
                            <div class="kanban-col">
                                <div class="kanban-col-head">
                                    <span><c:choose><c:when test="${area == '-'}"><fmt:message key="dispatch.area.none" /></c:when><c:otherwise><c:out value="${area}" /></c:otherwise></c:choose></span>
                                </div>
                                <c:forEach var="task" items="${UNASSIGNED_TASKS}">
                                    <c:set var="taskArea" value="${empty task.areaName ? '-' : fn:replace(task.areaName, '|', '/')}" />
                                    <c:if test="${taskArea == area}">
                                        <article class="kanban-card">
                                            <div class="kanban-card-head"><span>${task.orderCode}</span><span>${task.totalAmount} đ</span></div>
                                            <div><c:out value="${task.customerName}" /> <span class="muted"><c:out value="${task.customerPhone}" /></span></div>
                                            <div class="muted"><c:out value="${task.customerAddress}" /></div>
                                            <form action="DispatchController" method="POST" class="assign-inline">
                                                <input type="hidden" name="taskId" value="${task.taskId}">
                                                <select name="shipperUsername" class="filter-input" required aria-label="<fmt:message key="dispatch.select.default" />">
                                                    <option value="" disabled selected><fmt:message key="dispatch.select.default" /></option>
                                                    <c:forEach var="shipper" items="${SHIPPER_LIST}">
                                                        <option value="${shipper.username}" ${shipper.activeOrders >= shipper.maxOrders ? 'disabled' : ''}>
                                                            <c:out value="${shipper.fullName}" /> (${shipper.activeOrders}/${shipper.maxOrders})
                                                        </option>
                                                    </c:forEach>
                                                </select>
                                                <button type="submit" class="btn-next"><fmt:message key="dispatch.btn.assign" /></button>
                                            </form>
                                        </article>
                                    </c:if>
                                </c:forEach>
                            </div>
                        </c:forTokens>
                    </div>
                </c:otherwise>
            </c:choose>
        </section>

        <aside class="dispatch-side">
            <section class="panel">
                <h3 class="panel-title"><fmt:message key="dispatch.shipper_list_title" /></h3>
                <c:choose>
                    <c:when test="${empty SHIPPER_LIST}">
                        <p class="todo-empty"><fmt:message key="dispatch.msg.no_active_shippers" /></p>
                    </c:when>
                    <c:otherwise>
                        <ul class="md-rows">
                            <c:forEach var="shipper" items="${SHIPPER_LIST}">
                                <li class="shipper-load">
                                    <div class="md-row-top">
                                        <strong><c:out value="${shipper.fullName}" /></strong>
                                        <span>${shipper.activeOrders}/${shipper.maxOrders}</span>
                                    </div>
                                    <meter min="0" max="${shipper.maxOrders}" value="${shipper.activeOrders}" low="${shipper.maxOrders - 1}" high="${shipper.maxOrders}" optimum="0"></meter>
                                    <div class="muted"><fmt:message key="shipper.work.${shipper.workingStatus}" /> · <c:out value="${shipper.address}" /></div>
                                </li>
                            </c:forEach>
                        </ul>
                    </c:otherwise>
                </c:choose>
            </section>

            <section class="panel">
                <h3 class="panel-title"><fmt:message key="dispatch.pending_list_title" /> (${fn:length(ASSIGNED_PENDING_TASKS)})</h3>
                <c:choose>
                    <c:when test="${empty ASSIGNED_PENDING_TASKS}">
                        <p class="todo-empty"><fmt:message key="dispatch.msg.no_pending_tasks" /></p>
                    </c:when>
                    <c:otherwise>
                        <ul class="md-rows">
                            <c:forEach var="task" items="${ASSIGNED_PENDING_TASKS}">
                                <li class="shipper-load">
                                    <div class="md-row-top">
                                        <strong>${task.orderCode}</strong>
                                        <span class="muted"><c:out value="${task.shipperFullName}" /></span>
                                    </div>
                                    <div class="muted"><c:out value="${task.customerAddress}" /></div>
                                    <form action="DispatchController" method="POST" class="m-0 form-revoke-task" data-confirm-msg="<fmt:message key="dispatch.confirm.revoke" />">
                                        <input type="hidden" name="action" value="revoke" />
                                        <input type="hidden" name="taskId" value="${task.taskId}" />
                                        <button type="submit" class="btn-plain"><fmt:message key="dispatch.btn.revoke" /></button>
                                    </form>
                                </li>
                            </c:forEach>
                        </ul>
                    </c:otherwise>
                </c:choose>
            </section>
        </aside>
    </div>
</main>

<jsp:include page="footer.jsp" />
</file>

<file path="web/menu_management.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<fmt:setLocale value="${not empty cookie.LANG.value ? cookie.LANG.value : 'vi'}" />
<fmt:setBundle basename="resources.messages" />

<jsp:include page="header.jsp" />

<main class="main-content">
    <div class="flex-between mt-15 mb-20">
        <h2 class="m-0"><fmt:message key="menu.mgmt.heading" /></h2>
        <div class="d-flex gap-10">
            <button type="button" class="btn-login btn-secondary" data-action="open-menu-category">
                <fmt:message key="menu.category.btn.manage" />
            </button>
            <button type="button" class="btn-login btn-secondary" data-action="open-menu-options">
                <fmt:message key="menu.mgmt.btn.options" />
            </button>
            <button type="button" class="btn-login" data-action="open-create-product">
                + <fmt:message key="menu.mgmt.btn.add" />
            </button>
        </div>
    </div>

    <%-- Flash Message Thông Báo Một Lần (Chuẩn PRG) --%>
    <c:if test="${not empty sessionScope.ERROR_MESSAGE}">
        <p class="msg-error text-center"><fmt:message key="${sessionScope.ERROR_MESSAGE}" /></p>
        <c:remove var="ERROR_MESSAGE" scope="session" />
    </c:if>
    <c:if test="${not empty ERROR_MESSAGE}">
        <p class="msg-error text-center"><fmt:message key="${ERROR_MESSAGE}" /></p>
    </c:if>

    <c:if test="${not empty sessionScope.SUCCESS_MESSAGE}">
        <p class="msg-success text-center"><fmt:message key="${sessionScope.SUCCESS_MESSAGE}" /></p>
        <c:remove var="SUCCESS_MESSAGE" scope="session" />
    </c:if>
    <c:if test="${not empty SUCCESS_MESSAGE}">
        <p class="msg-success text-center"><fmt:message key="${SUCCESS_MESSAGE}" /></p>
    </c:if>

    <%-- Thanh Bộ Lọc Danh Mục Thực Đơn --%>
    <form action="${pageContext.request.contextPath}/MenuManagementController" method="GET" class="order-filter-panel mb-20">
        <div class="filter-item">
            <label for="filterCategory"><fmt:message key="menu.mgmt.filter.category" /></label>
            <select id="filterCategory" name="filterCategory" class="filter-input" data-auto-submit="true">
                <option value="ALL" ${empty CURRENT_FILTER_CATEGORY or CURRENT_FILTER_CATEGORY == 'ALL' ? 'selected' : ''}>
                    <fmt:message key="menu.mgmt.filter.all" />
                </option>
                <c:forEach var="cat" items="${CATEGORY_LIST}">
                    <c:set var="catIdStr">${cat.categoryId}</c:set>
                    <option value="${cat.categoryId}" ${CURRENT_FILTER_CATEGORY == catIdStr ? 'selected' : ''}>
                        <c:out value="${cat.categoryName}" />
                    </option>
                </c:forEach>
            </select>
        </div>
        <button type="submit" class="btn-login"><fmt:message key="menu.mgmt.filter.btn" /></button>
    </form>

    <%-- Bảng Quản Lý Thực Đơn --%>
    <c:choose>
        <c:when test="${empty PRODUCT_LIST}">
            <div class="empty-cart-container">
                <h3 class="msg-info"><fmt:message key="menu.mgmt.empty" /></h3>
            </div>
        </c:when>
        <c:otherwise>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th><fmt:message key="menu.mgmt.table.id" /></th>
                        <th><fmt:message key="menu.mgmt.table.image" /></th>
                        <th><fmt:message key="menu.mgmt.table.name" /></th>
                        <th><fmt:message key="menu.mgmt.table.category" /></th>
                        <th><fmt:message key="menu.mgmt.table.price" /></th>
                        <th><fmt:message key="menu.mgmt.table.status" /></th>
                        <th><fmt:message key="menu.mgmt.table.stock" /></th>
                        <th><fmt:message key="menu.mgmt.table.action" /></th>
                    </tr>
                </thead>
                <tbody>
                    <c:forEach var="product" items="${PRODUCT_LIST}">
                        <tr>
                            <td><strong>#${product.productId}</strong></td>
                            <td class="text-center">
                                <c:choose>
                                    <c:when test="${not empty product.imageUrl}">
                                        <c:choose>
                                            <c:when test="${fn:startsWith(product.imageUrl, 'http')}">
                                                <img src="${product.imageUrl}" alt="${fn:escapeXml(product.productName)}" class="menu-thumb" />
                                            </c:when>
                                            <c:otherwise>
                                                <img src="${pageContext.request.contextPath}/${product.imageUrl}" alt="${fn:escapeXml(product.productName)}" class="menu-thumb" />
                                            </c:otherwise>
                                        </c:choose>
                                    </c:when>
                                    <c:otherwise>
                                        <div class="menu-thumb-placeholder"><i class="fi fi-rr-mug-hot" aria-hidden="true"></i></div>
                                    </c:otherwise>
                                </c:choose>
                            </td>
                            <td>
                                <strong><c:out value="${product.productName}" /></strong>
                            </td>
                            <td>
                                <span class="badge-category"><c:out value="${product.categoryName}" /></span>
                            </td>
                            <td class="font-bold text-nowrap">
                                <fmt:formatNumber value="${product.price}" pattern="#,###" /> ₫
                            </td>
                            <td>
                                <c:choose>
                                    <c:when test="${product.isAvailable}">
                                        <span class="badge-status-active"><fmt:message key="menu.mgmt.status.active" /></span>
                                    </c:when>
                                    <c:otherwise>
                                        <span class="badge-status-inactive"><fmt:message key="menu.mgmt.status.inactive" /></span>
                                    </c:otherwise>
                                </c:choose>
                            </td>
                            <td>
                                <c:choose>
                                    <c:when test="${product.availableInStock}">
                                        <span class="badge-stock-ok"><fmt:message key="menu.mgmt.stock.sufficient" /></span>
                                    </c:when>
                                    <c:otherwise>
                                        <span class="badge-stock-out"><fmt:message key="menu.mgmt.stock.insufficient" /></span>
                                    </c:otherwise>
                                </c:choose>
                            </td>
                            <td>
                                <div class="menu-action-buttons">
                                    <button type="button" class="btn-action-edit"
                                            data-action="edit-product"
                                            data-id="${product.productId}"
                                            data-name="${fn:escapeXml(product.productName)}"
                                            data-cat-id="${product.categoryId}"
                                            data-price="${product.price}"
                                            data-img="${fn:escapeXml(product.imageUrl)}"
                                            data-avail="${product.isAvailable}"
                                            data-recipe="${fn:escapeXml(product.recipeData)}"
                                            data-desc="${fn:escapeXml(product.description)}"
                                            data-video="${fn:escapeXml(product.videoUrl)}"
                                            data-featured="${product.featured}"
                                            data-has-options="${product.hasOptions}">
                                        <fmt:message key="menu.mgmt.btn.edit" />
                                    </button>

                                    <form action="${pageContext.request.contextPath}/MenuManagementController" method="POST" class="m-0 d-inline">
                                        <input type="hidden" name="action" value="toggleStatus" />
                                        <input type="hidden" name="productId" value="${product.productId}" />
                                        <input type="hidden" name="filterCategory" value="${CURRENT_FILTER_CATEGORY}" />
                                        <c:choose>
                                            <c:when test="${product.isAvailable}">
                                                <button type="submit" class="btn-action-toggle-stop">
                                                    <fmt:message key="menu.mgmt.btn.toggle_stop" />
                                                </button>
                                            </c:when>
                                            <c:otherwise>
                                                <button type="submit" class="btn-action-toggle-resume">
                                                    <fmt:message key="menu.mgmt.btn.toggle_resume" />
                                                </button>
                                            </c:otherwise>
                                        </c:choose>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    </c:forEach>
                </tbody>
            </table>
        </c:otherwise>
    </c:choose>

    <jsp:include page="components/product_form_modal.jsp" />
    <jsp:include page="components/menu_option_modal.jsp" />
</main>

<jsp:include page="footer.jsp" />
</file>

