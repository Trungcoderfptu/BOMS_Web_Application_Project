 * Click nbfs://nbhost/SystemFileSystem/Templates/Classes/Class.java to edit this template
 */
package service;

import dao.IngredientDAO;
import dao.MenuOptionDAO;
import dao.OrderDAO;
import dao.ProductDAO;
import java.sql.Timestamp;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.TreeSet;
import model.Ingredient;
import model.MenuSize;
import model.MenuTopping;
import model.Order;
import model.OrderDetail;
import model.Product;
import model.ProductIngredient;
import utility.Constants;
import utility.ValidationException;
import utility.Validator;

public class CartService {

    private ProductDAO productDAO;
    private OrderDAO orderDAO;
    private IngredientDAO ingredientDAO;
    private MenuOptionDAO menuOptionDAO;

    public CartService() {
        this.productDAO = new ProductDAO();
        this.orderDAO = new OrderDAO();
        this.ingredientDAO = new IngredientDAO();
        this.menuOptionDAO = new MenuOptionDAO();
    }

    // ==========================================
    // ========== 1. MAIN SERVICE (FACADE) ======
    // ==========================================
    /**
     * Thêm nhanh 1 phần với tuỳ chọn mặc định (size đầu tiên, 100% đá, 100% đường, không topping).
     */
    public Object addProductToCart(Object sessionCart, int productId) throws ValidationException {
        return addProductToCart(sessionCart, productId, "1", null, null, null, null, null);
    }

    /**
     * Thêm món kèm tuỳ chọn từ popup chi tiết món (size, đá, đường, topping, ghi chú, số lượng).
     * Cùng món + cùng tuỳ chọn thì cộng dồn số lượng; khác tuỳ chọn thì tách thành dòng mới.
     */
    public Object addProductToCart(Object sessionCart, int productId, String quantityStr, String sizeIdStr,
            String iceLevel, String sugarLevel, String[] toppingIdStrs, String note) throws ValidationException {
        Product product = validateAndGetProduct(productId);
        int quantity = validateQuantity(quantityStr);
        OrderDetail newLine = buildCartLine(product, quantity, sizeIdStr, iceLevel, sugarLevel, toppingIdStrs, note);
        Order cart = getOrCreateCart(sessionCart);
        mergeOrAddLine(cart, newLine);
        recalculateTotal(cart);
        return cart;
    }

    public int checkout(Object sessionCart, String tableIdStr, Map<String, String> userSession) throws ValidationException {
        Order cart = validateAndGetCart(sessionCart);
        validateOrderSource(tableIdStr, userSession);
        validateCartItemsAvailability(cart);
        validateInventoryStock(cart);
        setupOrderDetails(cart, tableIdStr, userSession);
        int generatedOrderId = orderDAO.insertOrder(cart);
        deductIngredientsStock(cart);
        return generatedOrderId;
    }

    /**
     * Cập nhật số lượng 1 dòng giỏ hàng (xác định bằng lineKey). Số lượng <= 0 thì xóa dòng.
     */
    public Object updateItemQuantity(Object sessionCart, String lineKey, int newQuantity) throws ValidationException {
        Order cart = validateAndGetCart(sessionCart);
        if (newQuantity > Constants.MAX_ITEM_QUANTITY) {
            throw new ValidationException(Constants.ERROR_INVALID_ITEM_QUANTITY);
        }
        updateQuantityOrRemove(cart, lineKey, newQuantity);
        recalculateTotal(cart);
        return cart;
    }

    public Object removeItemFromCart(Object sessionCart, String lineKey) throws ValidationException {
        Order cart = validateAndGetCart(sessionCart);
        removeItemByLineKey(cart, lineKey);
        recalculateTotal(cart);
        return cart;
    }

    public void clearCart(Object sessionCart) throws ValidationException {
        Order cart = validateAndGetCart(sessionCart);
        clearCartDetails(cart);
    }

    // ==========================================
    // ========== 2. CART MANIPULATION ==========
    // ==========================================
    private Order getOrCreateCart(Object sessionCart) {
        if (sessionCart instanceof Order) {
            return (Order) sessionCart;
        }
        return new Order();
    }

    private void updateQuantityOrRemove(Order cart, String lineKey, int newQuantity) {
        if (newQuantity <= 0) {
            removeItemByLineKey(cart, lineKey);
        } else {
            setItemQuantity(cart, lineKey, newQuantity);
        }
    }

    private void setItemQuantity(Order cart, String lineKey, int newQuantity) {
        OrderDetail item = findItemByLineKey(cart, lineKey);
        if (item != null) {
            item.setQuantity(newQuantity);
        }
    }

    private void removeItemByLineKey(Order cart, String lineKey) {
        cart.getOrderDetails().removeIf(item -> item.getLineKey() != null && item.getLineKey().equals(lineKey));
    }

    private void clearCartDetails(Order cart) {
        cart.getOrderDetails().clear();
        cart.setTotalAmount(0);
    }

    private void mergeOrAddLine(Order cart, OrderDetail newLine) throws ValidationException {
        OrderDetail existing = findItemByLineKey(cart, newLine.getLineKey());
        if (existing == null) {
            cart.getOrderDetails().add(newLine);
            return;
        }
        int merged = existing.getQuantity() + newLine.getQuantity();
        if (merged > Constants.MAX_ITEM_QUANTITY) {
            throw new ValidationException(Constants.ERROR_INVALID_ITEM_QUANTITY);
        }
        existing.setQuantity(merged);
    }

    private OrderDetail findItemByLineKey(Order cart, String lineKey) {
        if (lineKey == null) {
            return null;
        }
        for (OrderDetail item : cart.getOrderDetails()) {
            if (lineKey.equals(item.getLineKey())) {
                return item;
            }
        }
        return null;
    }

    // ==========================================
    // ========== 2b. TUỲ CHỌN MÓN (SIZE/ĐÁ/ĐƯỜNG/TOPPING/GHI CHÚ)
    // ==========================================
    /**
     * Dựng 1 dòng giỏ hàng: đơn giá = giá món + tiền size + tổng giá topping.
     * Món không có tuỳ chọn (HasOptions = 0, ví dụ kem) chỉ nhận ghi chú.
     */
    private OrderDetail buildCartLine(Product product, int quantity, String sizeIdStr, String iceLevel,
            String sugarLevel, String[] toppingIdStrs, String note) throws ValidationException {
        OrderDetail line = new OrderDetail(0, product.getProductId(), quantity, product.getPrice());
        line.setProduct(product);
        String sizeKey = "";
        String toppingKey = "";
        if (product.isHasOptions()) {
            MenuSize size = resolveSize(sizeIdStr);
            if (size != null) {
                line.setSizeName(size.getSizeName());
                line.setUnitPrice(line.getUnitPrice() + size.getExtraPrice());
                sizeKey = String.valueOf(size.getSizeId());
            }
            line.setIceLevel(resolveLevel(iceLevel, Constants.ICE_LEVELS, Constants.DEFAULT_ICE_LEVEL, Constants.ERROR_INVALID_ICE_LEVEL));
            line.setSugarLevel(resolveLevel(sugarLevel, Constants.SUGAR_LEVELS, Constants.DEFAULT_SUGAR_LEVEL, Constants.ERROR_INVALID_SUGAR_LEVEL));
            List<MenuTopping> toppings = resolveToppings(toppingIdStrs);
            applyToppings(line, toppings);
            toppingKey = buildToppingKey(toppings);
        }
        line.setNote(validateNote(note));
        line.setLineKey(product.getProductId() + "|" + sizeKey + "|" + nullToEmpty(line.getIceLevel()) + "|"
                + nullToEmpty(line.getSugarLevel()) + "|" + toppingKey + "|" + nullToEmpty(line.getNote()));
        return line;
    }

    /**
     * Size bắt buộc chọn nếu cửa hàng đang bán theo size. Không gửi size thì lấy size đầu tiên (thêm nhanh).
     */
    private MenuSize resolveSize(String sizeIdStr) throws ValidationException {
        List<MenuSize> activeSizes = menuOptionDAO.getSizes(true);
        if (activeSizes.isEmpty()) {
            return null;
        }
        if (sizeIdStr == null || sizeIdStr.trim().isEmpty()) {
            return activeSizes.get(0);
        }
        int sizeId = Validator.checkInteger(sizeIdStr, Constants.ERROR_INVALID_MENU_SIZE);
        for (MenuSize s : activeSizes) {
            if (s.getSizeId() == sizeId) {
                return s;
            }
        }
        throw new ValidationException(Constants.ERROR_INVALID_MENU_SIZE);
    }

    private String resolveLevel(String level, String[] allowed, String defaultLevel, String errorCode) throws ValidationException {
        if (level == null || level.trim().isEmpty()) {
            return defaultLevel;
        }
        for (String a : allowed) {
            if (a.equals(level.trim())) {
                return a;
            }
        }
        throw new ValidationException(errorCode);
    }

    private List<MenuTopping> resolveToppings(String[] toppingIdStrs) throws ValidationException {
        List<MenuTopping> result = new ArrayList<>();
        if (toppingIdStrs == null) {
            return result;
        }
        Set<Integer> seen = new TreeSet<>();
        for (String idStr : toppingIdStrs) {
            seen.add(Validator.checkInteger(idStr, Constants.ERROR_INVALID_MENU_TOPPING));
        }
        for (Integer toppingId : seen) {
            MenuTopping topping = menuOptionDAO.getToppingById(toppingId);
            if (topping == null || !topping.isActive()) {
                throw new ValidationException(Constants.ERROR_INVALID_MENU_TOPPING);
            }
            result.add(topping);
        }
        return result;
    }

    private void applyToppings(OrderDetail line, List<MenuTopping> toppings) {
        if (toppings.isEmpty()) {
            return;
        }
        List<String> names = new ArrayList<>();
        double toppingTotal = 0;
        for (MenuTopping t : toppings) {
            names.add(t.getToppingName());
            toppingTotal += t.getPrice();
        }
        line.setToppings(String.join(Constants.TOPPING_SEPARATOR, names));
        line.setUnitPrice(line.getUnitPrice() + toppingTotal);
    }

    private String buildToppingKey(List<MenuTopping> toppings) {
        List<String> ids = new ArrayList<>();
        for (MenuTopping t : toppings) {
            ids.add(String.valueOf(t.getToppingId()));
        }
        return String.join(",", ids);
    }

    private String validateNote(String note) throws ValidationException {
        if (note == null || note.trim().isEmpty()) {
            return null;
        }
        Validator.checkMaxLength(note, Constants.MAX_ITEM_NOTE_LENG, Constants.ERROR_ITEM_NOTE_TOO_LONG);
        return note.trim();
    }

    private int validateQuantity(String quantityStr) throws ValidationException {
        if (quantityStr == null || quantityStr.trim().isEmpty()) {
            return 1;
        }
        int quantity = Validator.checkInteger(quantityStr, Constants.ERROR_INVALID_ITEM_QUANTITY);
        if (quantity < 1 || quantity > Constants.MAX_ITEM_QUANTITY) {
            throw new ValidationException(Constants.ERROR_INVALID_ITEM_QUANTITY);
        }
        return quantity;
    }

    private String nullToEmpty(String value) {
        return value == null ? "" : value;
    }

    // ==========================================
    // ========== 3. CHECKOUT PREPARATION =======
    // ==========================================
    private void setupOrderDetails(Order cart, String tableIdStr, Map<String, String> userSession) {
        assignOrderSource(cart, tableIdStr, userSession);
        setupOrderMetadata(cart);
        recalculateTotal(cart);
    }

    private void assignOrderSource(Order cart, String tableIdStr, Map<String, String> userSession) {
        if (isTableOrder(tableIdStr)) {
            cart.setOrderType("Table");
            cart.setTableId(parseTableId(tableIdStr));
            cart.setStaffId(null);
        } else {
            cart.setOrderType("Counter");
            cart.setStaffId(parseStaffId(userSession));
            cart.setTableId(null);
        }
    }

    private void validateOrderSource(String tableIdStr, Map<String, String> userSession) throws ValidationException {
        if (!isTableOrder(tableIdStr) && parseStaffId(userSession) == null) {
            throw new ValidationException(Constants.ERROR_INVALID_TABLE);
        }
    }

    private boolean isTableOrder(String tableIdStr) {
        return tableIdStr != null && !tableIdStr.trim().isEmpty();
    }

    private int parseTableId(String tableIdStr) {
        try {
            return Integer.parseInt(tableIdStr.replaceAll("\\D+", ""));
        } catch (NumberFormatException e) {
            return 1;
        }
    }

    private Integer parseStaffId(Map<String, String> userSession) {
        if (userSession == null || userSession.get("userId") == null) {
            return null;
        }
        try {
            return Integer.parseInt(userSession.get("userId"));
        } catch (NumberFormatException e) {
            return null;
        }
    }

    private void setupOrderMetadata(Order cart) {
        cart.setStatus("Accepted");
        cart.setCreatedAt(new Timestamp(System.currentTimeMillis()));
        cart.setCookingStartedAt(null);
    }

    private void recalculateTotal(Order cart) {
        double total = 0;
        for (OrderDetail item : cart.getOrderDetails()) {
            total += (item.getUnitPrice() * item.getQuantity());
        }
        cart.setTotalAmount(total);
    }

    // ==========================================
    // ========== 4. VALIDATION SERVICE (TẦNG 2) =
    // ==========================================
    private Product validateAndGetProduct(int productId) throws ValidationException {
        if (productId <= 0) {
            throw new ValidationException(Constants.ERROR_PRODUCT_NOT_AVAILABLE);
        }
        Product product = productDAO.getProductById(productId);
        if (product == null || !product.isAvailable() || !ingredientDAO.hasSufficientStockForProduct(productId, 1)) {
            throw new ValidationException(Constants.ERROR_PRODUCT_NOT_AVAILABLE);
        }
        return product;
    }

    private Order validateAndGetCart(Object sessionCart) throws ValidationException {
        Validator.checkNotNull(sessionCart, Constants.ERROR_EMPTY_CART);

        if (!(sessionCart instanceof Order)) {
            throw new ValidationException(Constants.ERROR_EMPTY_CART);
        }
        Order cart = (Order) sessionCart;
        List<OrderDetail> items = cart.getOrderDetails();
        if (items == null || items.isEmpty()) {
            throw new ValidationException(Constants.ERROR_EMPTY_CART);
        }
        return cart;
    }

    private void validateCartItemsAvailability(Order cart) throws ValidationException {
        for (OrderDetail item : cart.getOrderDetails()) {
            validateItemAvailability(item);
        }
    }

    private void validateItemAvailability(OrderDetail item) throws ValidationException {
        Product product = productDAO.getProductById(item.getProductId());
        if (product == null || !product.isAvailable()) {
            throw new ValidationException(Constants.ERROR_PRODUCT_NOT_AVAILABLE);
        }
    }

    // ==========================================
    // ========== 5. INVENTORY LOGIC (UC-01 POST-3)
    // ==========================================
    private void validateInventoryStock(Order cart) throws ValidationException {
        Map<Integer, Double> neededMap = calculateTotalIngredientsNeeded(cart);
        for (Map.Entry<Integer, Double> entry : neededMap.entrySet()) {
            int ingredientId = entry.getKey();
            double neededAmount = entry.getValue();
            Ingredient ingredient = ingredientDAO.getIngredientById(ingredientId);

            if (ingredient == null || ingredient.getQuantity() < neededAmount) {
                throw new ValidationException(Constants.ERROR_INSUFFICIENT_INGREDIENTS);
            }
        }
    }

    private Map<Integer, Double> calculateTotalIngredientsNeeded(Order cart) throws ValidationException {
        Map<Integer, Double> neededMap = new HashMap<>();
        for (OrderDetail item : cart.getOrderDetails()) {
            List<ProductIngredient> recipes = ingredientDAO.getIngredientsByProductId(item.getProductId());
            for (ProductIngredient pi : recipes) {
                double totalItemNeeded = pi.getQuantityUsed() * item.getQuantity();
                neededMap.put(pi.getIngredientId(), neededMap.getOrDefault(pi.getIngredientId(), 0.0) + totalItemNeeded);
            }
        }
        return neededMap;
    }

    private void deductIngredientsStock(Order cart) throws ValidationException {
        Map<Integer, Double> neededMap = calculateTotalIngredientsNeeded(cart);
        for (Map.Entry<Integer, Double> entry : neededMap.entrySet()) {
            int ingredientId = entry.getKey();
            double amount = entry.getValue();
            ingredientDAO.deductStock(ingredientId, amount);
        }
    }
}
</file>

<file path="web/components/delivery_orders_table.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<%@taglib prefix="bx" tagdir="/WEB-INF/tags"%>
<c:set var="currentLang" value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setLocale value="${currentLang}" />
<fmt:setBundle basename="resources.messages" />

<c:choose>
    <c:when test="${empty ORDER_LIST or ORDER_COUNTS.delivery == 0}">
        <div class="empty-cart-container">
            <h3 class="msg-info"><fmt:message key="order.management.empty.delivery" /></h3>
        </div>
    </c:when>
    <c:otherwise>
        <table class="admin-table">
            <thead>
                <tr>
                    <th><fmt:message key="order.management.table.id" /></th>
                    <th><fmt:message key="order.management.table.recipient" /></th>
                    <th><fmt:message key="order.management.table.delivery_address" /></th>
                    <th><fmt:message key="order.management.table.shipper" /></th>
                    <th><fmt:message key="order.management.table.created_at" /></th>
                    <th><fmt:message key="order.management.table.items" /></th>
                    <th><fmt:message key="order.management.table.total" /></th>
                    <th><fmt:message key="order.management.table.status" /></th>
                    <th><fmt:message key="order.management.table.action" /></th>
                </tr>
            </thead>
            <tbody>
                <c:forEach var="order" items="${ORDER_LIST}">
                    <c:if test="${order.orderType == 'Delivery'}">
                        <tr>
                            <td><strong>#${order.orderId}</strong></td>
                            <td>
                                <strong><c:out value="${order.customerName}" /></strong>
                                <c:if test="${not empty order.customerPhone}">
                                    <br><span class="text-secondary"><c:out value="${order.customerPhone}" /></span>
                                </c:if>
                            </td>
                            <td>
                                <div><c:out value="${order.deliveryAddress}" /></div>
                                <c:if test="${not empty order.areaName}">
                                    <div class="mt-5"><span class="badge-table"><i class="fi fi-rr-marker" aria-hidden="true"></i> <c:out value="${order.areaName}" /></span></div>
                                </c:if>
                            </td>
                            <td>
                                <c:choose>
                                    <c:when test="${not empty order.shipperName}">
                                        <span class="badge-stock-ok"><i class="fi fi-rr-truck-side" aria-hidden="true"></i> <c:out value="${order.shipperName}" /></span>
                                    </c:when>
                                    <c:otherwise>
                                        <span class="text-secondary"><em><fmt:message key="order.management.shipper.unassigned" /></em></span>
                                    </c:otherwise>
                                </c:choose>
                            </td>
                            <td>${order.createdAt}</td>
                            <td>
                                <ul class="order-items-summary">
                                    <c:forEach var="detail" items="${order.details}">
                                        <li class="order-item-row">
                                            <div class="order-item-info">
                                                <strong><c:out value="${detail.productName}" /></strong> x${detail.quantity} 
                                                (<fmt:formatNumber value="${detail.unitPrice}" pattern="#,###" /> ₫)
                                                <bx:itemOptions sizeName="${detail.sizeName}" iceLevel="${detail.iceLevel}" sugarLevel="${detail.sugarLevel}" toppings="${detail.toppings}" note="${detail.note}" />
                                            </div>
                                        </li>
                                    </c:forEach>
                                </ul>
                            </td>
                            <td><strong><fmt:formatNumber value="${order.totalAmount}" pattern="#,###" /> ₫</strong></td>
                            <td>
                                <c:choose>
                                    <c:when test="${order.status == 'Waiting for dispatch'}">
                                        <span class="order-badge order-badge-dispatch"><fmt:message key="order.status.waiting_dispatch" /></span>
                                    </c:when>
                                    <c:when test="${order.status == 'Waiting for delivery'}">
                                        <span class="order-badge order-badge-prepared"><fmt:message key="status.${order.status}" /></span>
                                    </c:when>
                                    <c:when test="${order.status == 'Picked up'}">
                                        <span class="order-badge order-badge-prepared"><fmt:message key="status.${order.status}" /></span>
                                    </c:when>
                                    <c:when test="${order.status == 'Delivering'}">
                                        <span class="order-badge order-badge-delivering"><fmt:message key="status.${order.status}" /></span>
                                    </c:when>
                                    <c:when test="${order.status == 'Delivered'}">
                                        <span class="order-badge order-badge-delivered"><fmt:message key="status.${order.status}" /></span>
                                    </c:when>
                                    <c:when test="${order.status == 'Returned'}">
                                        <span class="order-badge order-badge-cancelled"><fmt:message key="status.${order.status}" /></span>
                                    </c:when>
                                    <c:when test="${order.status == 'Paid'}">
                                        <span class="order-badge order-badge-paid"><fmt:message key="status.${order.status}" /></span>
                                    </c:when>
                                    <c:when test="${order.status == 'Cancelled'}">
                                        <span class="order-badge order-badge-cancelled"><fmt:message key="status.${order.status}" /></span>
                                        <c:choose>
                                            <c:when test="${order.isCancelLocked}">
                                                <div class="mt-5"><span class="badge-locked"><fmt:message key="order.cancel.locked" /></span></div>
                                            </c:when>
                                            <c:otherwise>
                                                <div class="cancel-countdown-wrapper mt-5" id="deliveryCancelCountdownWrapper-${order.orderId}">
                                                    <span class="text-secondary text-sm"><fmt:message key="order.cancel.countdown" /></span>
                                                    <span class="cancel-countdown-timer font-bold"
                                                          data-order-id="${order.orderId}"
                                                          data-seconds="${order.remainingCancelSeconds}"
                                                          data-locked-text="<fmt:message key="order.cancel.locked" />">--:--</span>
                                                </div>
                                            </c:otherwise>
                                        </c:choose>
                                    </c:when>
                                    <c:otherwise>
                                        <span class="order-badge">${order.status}</span>
                                    </c:otherwise>
                                </c:choose>
                            </td>
                            <td>
                                <div class="order-action-group">
                                    <c:choose>
                                        <c:when test="${order.isDeliveryUnderShipper}">
                                            <span class="badge-locked text-sm"><i class="fi fi-rr-lock" aria-hidden="true"></i> <fmt:message key="order.management.action.under_shipper" /></span>
                                        </c:when>
                                        <c:when test="${order.isClosedStatus}">
                                            <span class="text-secondary text-sm"><i class="fi fi-rr-lock" aria-hidden="true"></i> <fmt:message key="order.management.action.closed" /></span>
                                        </c:when>
                                        <c:otherwise>
                                            <form action="${pageContext.request.contextPath}/OrderManagementController" method="POST" class="m-0 flex-align-center order-status-form"
                                                  data-customer-name="${fn:escapeXml(order.customerName)}"
                                                  data-customer-phone="${fn:escapeXml(order.customerPhone)}"
                                                  data-delivery-address="${fn:escapeXml(order.deliveryAddress)}"
                                                  data-area-id="${order.areaId}"
                                                  data-order-type="${order.orderType}"
                                                  data-current-status="${order.status}"
                                                  data-order-id="${order.orderId}">
                                                <input type="hidden" name="action" value="updateStatus" />
                                                <input type="hidden" name="orderId" value="${order.orderId}" />
                                                <input type="hidden" name="filterDate" value="${CURRENT_FILTER_DATE}" />
                                                <input type="hidden" name="filterStatus" value="${CURRENT_FILTER_STATUS}" />
                                                <input type="hidden" name="activeTab" value="tab-delivery-orders" />
                                                <select name="newStatus" class="status-select status-select-${order.orderId}" ${order.isStatusUpdateLocked ? 'disabled' : ''}>
                                                    <option value="Accepted" ${order.status == 'Accepted' ? 'selected' : ''}>Accepted (<fmt:message key="order.revert.option.label" />)</option>
                                                    <option value="Prepared" ${order.status == 'Prepared' ? 'selected' : ''}>Prepared</option>
                                                    <option value="Waiting for dispatch" ${order.status == 'Waiting for dispatch' ? 'selected' : ''}><fmt:message key="order.status.waiting_dispatch" /></option>
                                                    <option value="Waiting for delivery" ${order.status == 'Waiting for delivery' ? 'selected' : ''}>Waiting for delivery</option>
                                                    <option value="Delivering" ${order.status == 'Delivering' ? 'selected' : ''}>Delivering</option>
                                                    <option value="Delivered" ${order.status == 'Delivered' ? 'selected' : ''}>Delivered</option>
                                                    <option value="Returned" ${order.status == 'Returned' ? 'selected' : ''}>Returned</option>
                                                    <option value="Paid" ${order.status == 'Paid' ? 'selected' : ''}>Paid</option>
                                                    <option value="Cancelled" ${order.status == 'Cancelled' ? 'selected' : ''}>Cancelled</option>
                                                </select>
                                                <button type="submit" class="btn-status-save btn-status-save-${order.orderId}" ${order.isStatusUpdateLocked ? 'disabled' : ''}><fmt:message key="order.management.btn.update" /></button>
                                            </form>

                                            <c:if test="${order.canCancelOrder}">
                                                <button type="button" class="btn-order-cancel btn-open-staff-cancel mt-5" data-order-id="${order.orderId}" data-tab-key="tab-delivery-orders"><fmt:message key="order.management.btn.cancel" /></button>
                                            </c:if>
                                        </c:otherwise>
                                    </c:choose>
                                </div>
                            </td>
                        </tr>
                    </c:if>
                </c:forEach>
            </tbody>
        </table>
    </c:otherwise>
</c:choose>
</file>

<file path="web/components/inventory_form_modal.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<fmt:setLocale value="${not empty cookie.LANG.value ? cookie.LANG.value : 'vi'}" />
<fmt:setBundle basename="resources.messages" />

<%-- MODAL 1: THÊM / CHỈNH SỬA THÔNG TIN NGUYÊN LIỆU --%>
<div id="inventoryModal" class="modal-overlay d-none"
     data-title-add="<fmt:message key="inventory.modal.title.add" />"
     data-title-edit="<fmt:message key="inventory.modal.title.edit" />"
>
    <div class="modal-card">
        <div class="modal-header">
            <h3 id="inventoryModalTitle" class="m-0"><fmt:message key="inventory.modal.title.add" /></h3>
            <button type="button" class="btn-modal-close" data-close-modal="inventoryModal"><i class="fi fi-rr-cross-small" aria-hidden="true"></i></button>
        </div>

        <form id="inventoryForm" action="${pageContext.request.contextPath}/InventoryManagementController" method="POST" class="m-0">
            <div class="modal-body">
                <input type="hidden" id="inventoryModalAction" name="action" value="create" />
                <input type="hidden" id="inventoryModalId" name="ingredientId" value="" />

                <div class="form-group mb-15">
                    <label for="ingredientNameInput" class="form-label font-bold">
                        <fmt:message key="inventory.modal.label.name" /> <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="ingredientNameInput" name="ingredientName" required
                           class="filter-input w-100" />
                </div>

                <div class="form-group mb-15">
                    <label for="ingredientCategorySelect" class="form-label font-bold">
                        <fmt:message key="inventory.modal.label.category" /> <span class="text-danger">*</span>
                    </label>
                    <select id="ingredientCategorySelect" name="categoryId" required class="filter-input w-100">
                        <c:forEach var="cat" items="${CATEGORY_LIST}">
                            <option value="${cat.categoryId}"><c:out value="${cat.categoryName}" /></option>
                        </c:forEach>
                    </select>
                </div>

                <div class="d-flex gap-10 mb-15">
                    <div class="form-group flex-grow-1">
                        <label for="ingredientUnitInput" class="form-label font-bold">
                            <fmt:message key="inventory.modal.label.unit" /> <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="ingredientUnitInput" name="unit" required
                               placeholder="kg, lít, hộp..." class="filter-input w-100" />
                    </div>
                    <div class="form-group flex-grow-1">
                        <label for="ingredientQtyInput" class="form-label font-bold">
                            <fmt:message key="inventory.modal.label.quantity" /> <span class="text-danger">*</span>
                        </label>
                        <input type="number" id="ingredientQtyInput" name="quantity" min="0" step="0.1" required
                               class="filter-input w-100" />
                    </div>
                </div>

                <div class="d-flex gap-10 mb-15">
                    <div class="form-group flex-grow-1">
                        <label for="ingredientPriceInput" class="form-label font-bold">
                            <fmt:message key="inventory.modal.label.price" /> <span class="text-danger">*</span>
                        </label>
                        <input type="number" id="ingredientPriceInput" name="price" min="0" step="1000" required
                               class="filter-input w-100" />
                    </div>
                    <div class="form-group flex-grow-1">
                        <label for="ingredientThresholdInput" class="form-label font-bold">
                            <fmt:message key="inventory.modal.label.threshold" /> <span class="text-danger">*</span>
                        </label>
                        <input type="number" id="ingredientThresholdInput" name="warningThreshold" min="0" step="0.1" required
                               class="filter-input w-100" />
                    </div>
                </div>

                <div class="form-group mb-15">
                    <label for="ingredientLocationInput" class="form-label font-bold">
                        <fmt:message key="inventory.modal.label.location" />
                    </label>
                    <input type="text" id="ingredientLocationInput" name="storageLocation"
                           placeholder="Tủ lạnh 1, Kệ A..." class="filter-input w-100" />
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-order-cancel" data-close-modal="inventoryModal">
                    <fmt:message key="inventory.modal.btn.close" />
                </button>
                <button type="submit" class="btn-login">
                    <fmt:message key="inventory.modal.btn.save" />
                </button>
            </div>
        </form>
    </div>
</div>

<%-- MODAL 2: CẬP NHẬT NHANH NGƯỠNG CẢNH BÁO TỒN KHO --%>
<div id="thresholdModal" class="modal-overlay d-none"
>
    <div class="modal-card">
        <div class="modal-header">
            <h3 class="m-0"><fmt:message key="inventory.modal.title.threshold" /></h3>
            <button type="button" class="btn-modal-close" data-close-modal="thresholdModal"><i class="fi fi-rr-cross-small" aria-hidden="true"></i></button>
        </div>

        <form id="thresholdForm" action="${pageContext.request.contextPath}/InventoryManagementController" method="POST" class="m-0">
            <div class="modal-body">
                <input type="hidden" name="action" value="updateThreshold" />
                <input type="hidden" id="thresholdIngredientId" name="ingredientId" value="" />

                <div class="mb-15">
                    <p class="m-0 font-bold"><fmt:message key="inventory.table.name" />: <span id="thresholdIngredientName"></span></p>
                </div>

                <div class="form-group mb-15">
                    <label for="thresholdValueInput" class="form-label font-bold">
                        <fmt:message key="inventory.modal.label.threshold" /> <span class="text-danger">*</span>
                    </label>
                    <input type="number" id="thresholdValueInput" name="threshold" min="0" step="0.1" required
                           class="filter-input w-100" />
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-order-cancel" data-close-modal="thresholdModal">
                    <fmt:message key="inventory.modal.btn.close" />
                </button>
                <button type="submit" class="btn-login">
                    <fmt:message key="inventory.modal.btn.save" />
                </button>
            </div>
        </form>
    </div>
</div>

<%-- MODAL 3: QUẢN LÝ DANH MỤC KHO NGUYÊN LIỆU --%>
<div id="inventoryCategoryModal" class="modal-overlay d-none">
    <div class="modal-card modal-card-md">
        <div class="modal-header">
            <h3 class="m-0"><fmt:message key="inventory.category.modal.title" /></h3>
            <button type="button" class="btn-modal-close" data-close-modal="inventoryCategoryModal"><i class="fi fi-rr-cross-small" aria-hidden="true"></i></button>
        </div>

        <div class="modal-body">
            <%-- Form thêm danh mục nguyên liệu mới --%>
            <form action="${pageContext.request.contextPath}/InventoryManagementController" method="POST" class="mb-20 p-15 card bg-light">
                <input type="hidden" name="action" value="createCategory" />
                <label for="newInventoryCategoryName" class="form-label font-bold mb-5 d-block">
                    <fmt:message key="inventory.category.label.name" /> <span class="text-danger">*</span>
                </label>
                <div class="d-flex gap-10">
                    <input type="text" id="newInventoryCategoryName" name="categoryName" required maxlength="100"
                           class="filter-input flex-grow-1"
                           placeholder="<fmt:message key="inventory.category.placeholder.name" />" />
                    <button type="submit" class="btn-login btn-sm">
                        + <fmt:message key="inventory.category.btn.create" />
                    </button>
                </div>
            </form>

            <%-- Bảng danh sách danh mục nguyên liệu hiện có --%>
            <h4 class="mb-10"><fmt:message key="inventory.category.table.title" /></h4>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="w-60">ID</th>
                        <th><fmt:message key="inventory.category.table.name" /></th>
                        <th class="w-140 text-center"><fmt:message key="inventory.category.table.status" /></th>
                        <th class="w-100 text-center"><fmt:message key="inventory.category.table.action" /></th>
                    </tr>
                </thead>
                <tbody>
                    <c:choose>
                        <c:when test="${not empty CATEGORY_LIST}">
                            <c:forEach var="cat" items="${CATEGORY_LIST}">
                                <tr>
                                    <td>${cat.categoryId}</td>
                                    <td><strong><c:out value="${cat.categoryName}" /></strong></td>
                                    <td class="text-center">
                                        <c:choose>
                                            <c:when test="${cat.inUse}">
                                                <span class="role-badge role-manager">
                                                    <fmt:message key="inventory.category.status.in_use" />
                                                </span>
                                            </c:when>
                                            <c:otherwise>
                                                <span class="role-badge role-staff">
                                                    <fmt:message key="inventory.category.status.empty" />
                                                </span>
                                            </c:otherwise>
                                        </c:choose>
                                    </td>
                                    <td class="text-center">
                                        <c:choose>
                                            <c:when test="${not cat.inUse}">
                                                <form action="${pageContext.request.contextPath}/InventoryManagementController" method="POST" class="m-0 d-inline">
                                                    <input type="hidden" name="action" value="deleteCategory" />
                                                    <input type="hidden" name="categoryId" value="${cat.categoryId}" />
                                                    <button type="submit" class="btn-reject btn-sm"
                                                            data-confirm="<fmt:message key="inventory.category.confirm.delete" />">
                                                        <fmt:message key="inventory.category.btn.delete" />
                                                    </button>
                                                </form>
                                            </c:when>
                                            <c:otherwise>
                                                <span class="text-muted">-</span>
                                            </c:otherwise>
                                        </c:choose>
                                    </td>
                                </tr>
                            </c:forEach>
                        </c:when>
                        <c:otherwise>
                            <tr>
                                <td colspan="4" class="text-center"><fmt:message key="inventory.category.empty" /></td>
                            </tr>
                        </c:otherwise>
                    </c:choose>
                </tbody>
            </table>
        </div>

        <div class="modal-actions">
            <button type="button" class="btn-order-cancel" data-close-modal="inventoryCategoryModal">
                <fmt:message key="inventory.modal.btn.close" />
            </button>
        </div>
    </div>
</div>
</file>

<file path="web/attendance.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<c:set var="currentLang" value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setLocale value="${currentLang}" />
<fmt:setBundle basename="resources.messages" />

<jsp:include page="header.jsp" />

<main class="main-content">
    <div class="flex-between mt-15 mb-20">
        <h2 class="m-0"><fmt:message key="attendance.heading" /></h2>
    </div>

    <%-- Flash Message Thông Báo Một Lần (Chuẩn PRG) --%>
    <c:if test="${not empty sessionScope.ERROR_MESSAGE}">
        <p class="msg-error text-center"><fmt:message key="${sessionScope.ERROR_MESSAGE}" /></p>
        <c:remove var="ERROR_MESSAGE" scope="session" />
    </c:if>
    <c:if test="${not empty ERROR_MESSAGE}">
        <p class="msg-error text-center"><fmt:message key="${ERROR_MESSAGE}" /></p>
    </c:if>

    <c:if test="${not empty sessionScope.SUCCESS_MESSAGE}">
        <p class="msg-success text-center"><fmt:message key="${sessionScope.SUCCESS_MESSAGE}" /></p>
        <c:remove var="SUCCESS_MESSAGE" scope="session" />
    </c:if>
    <c:if test="${not empty SUCCESS_MESSAGE}">
        <p class="msg-success text-center"><fmt:message key="${SUCCESS_MESSAGE}" /></p>
    </c:if>

    <%-- KHỐI 1: TRẠNG THÁI CA LÀM HÔM NAY & ĐỒNG HỒ MÁY CHỦ --%>
    <div class="attendance-top-grid mb-25">
        <%-- Thẻ Thông tin Ca làm việc hôm nay --%>
        <div class="attendance-card">
            <h3 class="attendance-card-title">
                <fmt:message key="attendance.card.today_shift" />
            </h3>
            <c:choose>
                <c:when test="${TODAY_ATTENDANCE.hasShift}">
                    <div class="attendance-info-row">
                        <span class="info-label"><fmt:message key="attendance.label.shift" /></span>
                        <strong class="info-value font-highlight">${TODAY_ATTENDANCE.shiftName}</strong>
                    </div>
                    <div class="attendance-info-row">
                        <span class="info-label"><fmt:message key="attendance.label.time" /></span>
                        <span class="info-value">${TODAY_ATTENDANCE.startTime} - ${TODAY_ATTENDANCE.endTime}</span>
                    </div>
                    <div class="attendance-info-row">
                        <span class="info-label"><fmt:message key="attendance.label.status" /></span>
                        <span class="info-value">
                            <c:choose>
                                <c:when test="${TODAY_ATTENDANCE.systemStatus == 'On Shift / Working'}">
                                    <span class="badge-status-working"><fmt:message key="attendance.status.on_shift" /></span>
                                </c:when>
                                <c:when test="${TODAY_ATTENDANCE.systemStatus == 'Shift Ended / Off Shift'}">
                                    <span class="badge-status-ended"><fmt:message key="attendance.status.shift_ended" /></span>
                                </c:when>
                                <c:otherwise>
                                    <span class="badge-status-waiting"><fmt:message key="attendance.status.not_started" /></span>
                                </c:otherwise>
                            </c:choose>
                        </span>
                    </div>

                    <%-- Nút bấm hành động Chấm công --%>
                    <div class="attendance-actions mt-20">
                        <c:if test="${not TODAY_ATTENDANCE.hasCheckedIn}">
                            <c:choose>
                                <c:when test="${TODAY_ATTENDANCE.canCheckIn}">
                                    <form action="${pageContext.request.contextPath}/AttendanceController" method="POST" class="m-0">
                                        <input type="hidden" name="action" value="checkIn" />
                                        <button type="submit" class="btn-clock-in w-100">
                                            <i class="fi fi-rr-sign-in-alt" aria-hidden="true"></i> <fmt:message key="attendance.btn.checkin" />
                                        </button>
                                    </form>
                                </c:when>
                                <c:otherwise>
                                    <button type="button" class="btn-clock-in w-100 opacity-50 cursor-not-allowed" disabled>
                                        <i class="fi fi-rr-lock" aria-hidden="true"></i> <fmt:message key="attendance.btn.checkin_locked" /> (${TODAY_ATTENDANCE.startTime})
                                    </button>
                                    <p class="font-xs text-muted text-center mt-5">
                                        <fmt:message key="attendance.hint.checkin_locked" />
                                    </p>
                                </c:otherwise>
                            </c:choose>
                        </c:if>

                        <c:if test="${TODAY_ATTENDANCE.hasCheckedIn and not TODAY_ATTENDANCE.hasCheckedOut}">
                            <c:choose>
                                <c:when test="${not TODAY_ATTENDANCE.canCheckOut}">
                                    <button type="button" class="btn-clock-out w-100 opacity-50 cursor-not-allowed" disabled>
                                        <i class="fi fi-rr-lock" aria-hidden="true"></i> <fmt:message key="attendance.btn.checkout_locked" /> (${TODAY_ATTENDANCE.endTime})
                                    </button>
                                    <p class="font-xs text-muted text-center mt-5">
                                        <fmt:message key="attendance.hint.checkout_locked" />
                                    </p>
                                </c:when>
                                <c:when test="${TODAY_ATTENDANCE.isOvertimeEligible}">
                                    <button type="button" id="btnOpenOtModal" class="btn-clock-out w-100">
                                        <i class="fi fi-rr-sign-out-alt" aria-hidden="true"></i> <fmt:message key="attendance.btn.checkout" /> (OT)
                                    </button>
                                </c:when>
                                <c:otherwise>
                                    <form action="${pageContext.request.contextPath}/AttendanceController" method="POST" class="m-0">
                                        <input type="hidden" name="action" value="checkOut" />
                                        <button type="submit" class="btn-clock-out w-100">
                                            <i class="fi fi-rr-sign-out-alt" aria-hidden="true"></i> <fmt:message key="attendance.btn.checkout" />
                                        </button>
                                    </form>
                                </c:otherwise>
                            </c:choose>
                        </c:if>
                    </div>
                </c:when>
                <c:otherwise>
                    <div class="empty-shift-box">
                        <p class="msg-info"><fmt:message key="attendance.status.no_shift" /></p>
                    </div>
                </c:otherwise>
            </c:choose>
        </div>

        <%-- Thẻ Đồng hồ đếm giờ máy chủ (Server Time) --%>
        <div class="attendance-card text-center">
            <h3 class="attendance-card-title">
                <fmt:message key="attendance.card.clock" />
            </h3>
            <div id="serverClockDisplay" class="clock-display" data-server-date="${TODAY_ATTENDANCE.serverCurrentDate}" data-server-time="${TODAY_ATTENDANCE.serverCurrentTime}">
                ${TODAY_ATTENDANCE.serverCurrentTime}
            </div>
            <div class="clock-date-text mt-5 font-bold">
                ${TODAY_ATTENDANCE.serverCurrentDate}
            </div>

            <c:if test="${TODAY_ATTENDANCE.hasCheckedIn}">
                <div class="shift-summary-box mt-15">
                    <div class="flex-between mb-5">
                        <span><fmt:message key="attendance.label.checkin_time" />:</span>
                        <strong>${TODAY_ATTENDANCE.checkInTime} (${TODAY_ATTENDANCE.checkInStatus})</strong>
                    </div>
                    <c:if test="${TODAY_ATTENDANCE.hasCheckedOut}">
                        <div class="flex-between mb-5">
                            <span><fmt:message key="attendance.label.checkout_time" />:</span>
                            <strong>${TODAY_ATTENDANCE.checkOutTime} (${TODAY_ATTENDANCE.checkOutStatus})</strong>
                        </div>
                        <div class="flex-between border-top pt-5">
                            <span><fmt:message key="attendance.label.working_hours" />:</span>
                            <strong class="font-highlight">${TODAY_ATTENDANCE.workingHours} hrs</strong>
                        </div>
                    </c:if>
                </div>
            </c:if>
        </div>
    </div>

    <%-- ================= THỜI KHÓA BIỂU TUẦN CHO NHÂN VIÊN (TASK 14.2 - FAP STYLE) ================= --%>
    <div class="panel-card mb-25">
        <div class="panel-header flex-between align-center mb-15">
            <div>
                <h3 class="panel-title font-md m-0">
                    <fmt:message key="attendance.timetable.title" />
                </h3>
                <span class="text-muted font-xs font-bold">${WEEKLY_TIMETABLE.weekLabel}</span>
            </div>
            <div class="week-nav-bar flex-center gap-5">
                <a href="${pageContext.request.contextPath}/AttendanceController?weekDate=${WEEKLY_TIMETABLE.prevWeekDate}&month=${CURRENT_MONTH}&year=${CURRENT_YEAR}" class="btn-secondary btn-xs">
                    <fmt:message key="attendance.timetable.prev_week" />
                </a>
                <a href="${pageContext.request.contextPath}/AttendanceController?weekDate=${WEEKLY_TIMETABLE.currentWeekDate}&month=${CURRENT_MONTH}&year=${CURRENT_YEAR}" class="btn-secondary btn-xs font-bold">
                    <fmt:message key="attendance.timetable.current_week" />
                </a>
                <a href="${pageContext.request.contextPath}/AttendanceController?weekDate=${WEEKLY_TIMETABLE.nextWeekDate}&month=${CURRENT_MONTH}&year=${CURRENT_YEAR}" class="btn-secondary btn-xs">
                    <fmt:message key="attendance.timetable.next_week" />
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="data-table timetable-grid">
                <thead>
                    <tr>
                        <th class="w-180"><fmt:message key="attendance.timetable.shift_col" /></th>
                        <c:forEach var="day" items="${WEEKLY_TIMETABLE.days}">
                            <th class="text-center ${day.isToday ? 'th-today' : ''}">
                                <c:choose>
                                    <c:when test="${not empty day.dayKey}"><fmt:message key="${day.dayKey}" /></c:when>
                                    <c:otherwise>${day.dayName}</c:otherwise>
                                </c:choose><br>
                                <span class="font-xs text-muted">${day.shortDate}</span>
                            </th>
                        </c:forEach>
                    </tr>
                </thead>
                <tbody>
                    <c:choose>
                        <c:when test="${not empty WEEKLY_TIMETABLE.matrix}">
                            <c:forEach var="shiftRow" items="${WEEKLY_TIMETABLE.matrix}">
                                <tr>
                                    <td class="timetable-shift-info font-bold">
                                        ${shiftRow.shiftName}<br>
                                        <small class="text-muted font-normal">${shiftRow.timeRange}</small>
                                    </td>
                                    <c:forEach var="slot" items="${shiftRow.slots}">
                                        <td class="timetable-cell ${slot.isToday ? 'cell-today' : ''}">
                                            <c:choose>
                                                <c:when test="${slot.hasShift}">
                                                    <div class="timetable-slot-card">
                                                        <div class="font-xs font-bold">${slot.shiftName}</div>
                                                        <div class="font-xxs text-muted mb-5">${slot.timeRange}</div>
                                                        <c:choose>
                                                            <c:when test="${slot.hasCheckedOut}">
                                                                <span class="badge-status-ended font-xxs">
                                                                    <fmt:message key="attendance.status.shift_ended" /> (${slot.workingHours}h)
                                                                </span>
                                                            </c:when>
                                                            <c:when test="${slot.hasCheckedIn}">
                                                                <span class="badge-status-working font-xxs">
                                                                    <fmt:message key="attendance.status.on_shift" /> (${slot.checkInTime})
                                                                </span>
                                                                <c:if test="${slot.isToday and slot.canCheckOut}">
                                                                    <form action="${pageContext.request.contextPath}/AttendanceController" method="POST" class="mt-5 m-0">
                                                                        <input type="hidden" name="action" value="checkOut" />
                                                                        <button type="submit" class="btn-clock-out btn-xs w-100">
                                                                            <i class="fi fi-rr-sign-out-alt" aria-hidden="true"></i> <fmt:message key="attendance.btn.checkout" />
                                                                        </button>
                                                                    </form>
                                                                </c:if>
                                                            </c:when>
                                                            <c:otherwise>
                                                                <span class="badge-status-waiting font-xxs">
                                                                    <fmt:message key="attendance.status.not_started" />
                                                                </span>
                                                                <c:if test="${slot.isToday and slot.canCheckIn}">
                                                                    <form action="${pageContext.request.contextPath}/AttendanceController" method="POST" class="mt-5 m-0">
                                                                        <input type="hidden" name="action" value="checkIn" />
                                                                        <button type="submit" class="btn-clock-in btn-xs w-100">
                                                                            <i class="fi fi-rr-sign-in-alt" aria-hidden="true"></i> <fmt:message key="attendance.btn.checkin" />
                                                                        </button>
                                                                    </form>
                                                                </c:if>
                                                            </c:otherwise>
                                                        </c:choose>
                                                    </div>
                                                </c:when>
                                                <c:otherwise>
                                                    <span class="text-muted font-bold">-</span>
                                                </c:otherwise>
                                            </c:choose>
                                        </td>
                                    </c:forEach>
                                </tr>
                            </c:forEach>
                        </c:when>
                        <c:otherwise>
                            <tr>
                                <td colspan="8" class="text-center text-muted p-20">
                                    <fmt:message key="attendance.status.no_shift" />
                                </td>
                            </tr>
                        </c:otherwise>
                    </c:choose>
                </tbody>
            </table>
        </div>
    </div>

    <%-- KHỐI 2: CHỈ SỐ TỔNG KẾT THÁNG (TIMESHEET SUMMARY METRICS) --%>
    <div class="attendance-summary-cards mb-25">
        <div class="summary-metric-card">
            <div class="metric-number">${ATTENDANCE_SUMMARY.totalShifts}</div>
            <div class="metric-label"><fmt:message key="attendance.summary.total_shifts" /></div>
        </div>
        <div class="summary-metric-card">
            <div class="metric-number font-highlight">${ATTENDANCE_SUMMARY.totalHours}</div>
            <div class="metric-label"><fmt:message key="attendance.summary.total_hours" /> (h)</div>
        </div>
        <div class="summary-metric-card">
            <div class="metric-number text-success">${ATTENDANCE_SUMMARY.onTimeCount}</div>
            <div class="metric-label"><fmt:message key="attendance.summary.on_time" /></div>
        </div>
        <div class="summary-metric-card">
            <div class="metric-number text-warning">${ATTENDANCE_SUMMARY.lateCount}</div>
            <div class="metric-label"><fmt:message key="attendance.summary.late" /></div>
        </div>
        <div class="summary-metric-card">
            <div class="metric-number text-danger">${ATTENDANCE_SUMMARY.otCount}</div>
            <div class="metric-label"><fmt:message key="attendance.summary.ot" /></div>
        </div>
    </div>

    <%-- KHỐI 3: BẢNG LỊCH SỬ ĐIỂM DANH THEO THÁNG --%>
    <div class="attendance-history-panel">
        <div class="flex-between mb-15">
            <h3 class="m-0"><fmt:message key="attendance.history.title" /></h3>
            <form action="${pageContext.request.contextPath}/AttendanceController" method="GET" class="order-filter-panel m-0">
                <div class="filter-item">
                    <label for="filterMonth"><fmt:message key="attendance.history.filter_month" /></label>
                    <select id="filterMonth" name="month" class="filter-input" data-auto-submit="true">
                        <c:forEach var="m" begin="1" end="12">
                            <option value="${m}" ${CURRENT_MONTH == m ? 'selected' : ''}>
                                ${m}
                            </option>
                        </c:forEach>
                    </select>
                </div>
                <div class="filter-item">
                    <label for="filterYear"><fmt:message key="attendance.history.filter_year" /></label>
                    <select id="filterYear" name="year" class="filter-input" data-auto-submit="true">
                        <c:forEach var="y" begin="2024" end="2027">
                            <option value="${y}" ${CURRENT_YEAR == y ? 'selected' : ''}>
                                ${y}
                            </option>
                        </c:forEach>
                    </select>
                </div>
            </form>
        </div>

        <c:choose>
            <c:when test="${empty ATTENDANCE_HISTORY}">
                <div class="empty-cart-container">
                    <h3 class="msg-info"><fmt:message key="attendance.history.empty" /></h3>
                </div>
            </c:when>
            <c:otherwise>
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th><fmt:message key="attendance.history.table.date" /></th>
                            <th><fmt:message key="attendance.history.table.shift" /></th>
                            <th><fmt:message key="attendance.history.table.time_range" /></th>
                            <th><fmt:message key="attendance.history.table.checkin" /></th>
                            <th><fmt:message key="attendance.history.table.checkout" /></th>
                            <th><fmt:message key="attendance.history.table.hours" /></th>
                            <th><fmt:message key="attendance.history.table.status" /></th>
                            <th><fmt:message key="attendance.history.table.ot_reason" /></th>
                        </tr>
                    </thead>
                    <tbody>
                        <c:forEach var="row" items="${ATTENDANCE_HISTORY}">
                            <tr>
                                <td><strong>${row.workDate}</strong></td>
                                <td>${row.shiftName}</td>
                                <td>${row.shiftTimeRange}</td>
                                <td>
                                    <strong>${row.checkInTime}</strong>
                                    <span class="badge-sub-status ${row.checkInStatus == 'On Time' ? 'text-success' : 'text-danger'}">
                                        (${row.checkInStatus})
                                    </span>
                                </td>
                                <td>
                                    <strong>${row.checkOutTime}</strong>
                                    <c:if test="${row.checkOutStatus != 'Working'}">
                                        <span class="badge-sub-status ${row.checkOutStatus == 'On Time' ? 'text-success' : 'text-danger'}">
                                            (${row.checkOutStatus})
                                        </span>
                                    </c:if>
                                </td>
                                <td class="font-bold">
                                    ${row.workingHours}
                                </td>
                                <td>
                                    <c:choose>
                                        <c:when test="${row.checkOutStatus == 'Working'}">
                                            <span class="badge-status-working"><fmt:message key="attendance.status.on_shift" /></span>
                                        </c:when>
                                        <c:otherwise>
                                            <span class="badge-status-ended"><fmt:message key="attendance.status.shift_ended" /></span>
                                        </c:otherwise>
                                    </c:choose>
                                </td>
                                <td>
                                    <c:choose>
                                        <c:when test="${not empty row.otReason}">
                                            <span class="ot-reason-bubble" title="<c:out value='${row.otReason}' />"><c:out value="${row.otReason}" /></span>
                                        </c:when>
                                        <c:otherwise>
                                            <span class="text-muted">---</span>
                                        </c:otherwise>
                                    </c:choose>
                                </td>
                            </tr>
                        </c:forEach>
                    </tbody>
                </table>
            </c:otherwise>
        </c:choose>
    </div>
</main>

<jsp:include page="components/ot_reason_modal.jsp" />
<jsp:include page="footer.jsp" />
</file>

<file path="web/index.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>

<c:set var="currentLang" value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setLocale value="${currentLang}" />
<fmt:setBundle basename="resources.messages" />

<%-- Tự động chuyển tiếp đến DashboardController để nạp dữ liệu cá nhân hóa nếu chưa nạp --%>
<c:if test="${not empty sessionScope.USER_SESSION and empty DASHBOARD_ATTENDANCE}">
    <c:redirect url="/DashboardController" />
</c:if>

<jsp:include page="header.jsp" />
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<c:set var="role" value="${sessionScope.USER_SESSION.role}" />

<main class="main-content dashboard-main">
    <c:choose>
        <%-- TRƯỜNG HỢP 1: KHÁCH VÃNG LAI (CHƯA ĐĂNG NHẬP) --%>
        <c:when test="${empty sessionScope.USER_SESSION}">
            <div class="guest-hero-container text-center">
                <img class="auth-logo guest-logo" src="${ctx}/images/brand/bingxue-logo.png" alt="" />
                <h1 class="guest-hero-title mb-15 font-xxl font-bold">
                    <fmt:message key="dashboard.guest.hero_title" />
                </h1>
                <p class="guest-hero-desc mb-25 text-muted mx-auto max-w-600">
                    <fmt:message key="dashboard.guest.hero_desc" />
                </p>
                <div class="flex-center gap-15">
                    <a href="${ctx}/login.jsp" class="btn-primary btn-lg">
                        <fmt:message key="dashboard.guest.btn_login" />
                    </a>
                </div>
            </div>
        </c:when>

        <%-- TRƯỜNG HỢP 2: ĐÃ ĐĂNG NHẬP - Bố cục E "trung tâm việc cần làm":
             hàng số liệu -> trái: việc đang chờ chính người này xử lý (mỗi dòng có nút làm luôn) -> phải: hoạt động gần đây --%>
        <c:otherwise>
            <div class="page-head">
                <h2><fmt:message key="dashboard.welcome_user" /> <c:out value="${sessionScope.USER_SESSION.fullName}" /></h2>
                <span class="muted">@<c:out value="${sessionScope.USER_SESSION.username}" /></span>
            </div>

            <section class="kpi-row">
                <div class="kpi">
                    <span class="kpi-label"><fmt:message key="attendance.card.clock" /></span>
                    <span id="serverClockDisplay" class="kpi-value" data-server-date="${DASHBOARD_SERVER_DATE}" data-server-time="${DASHBOARD_SERVER_TIME}">${DASHBOARD_SERVER_TIME}</span>
                    <span class="muted">${DASHBOARD_SERVER_DATE}</span>
                </div>
                <div class="kpi">
                    <span class="kpi-label"><fmt:message key="dashboard.stats.unread_notifs" /></span>
                    <span class="kpi-value">${DASHBOARD_UNREAD_COUNT}</span>
                </div>
                <c:if test="${role == 'Manager'}">
                    <div class="kpi">
                        <span class="kpi-label"><fmt:message key="dashboard.stats.pending_approvals" /></span>
                        <span class="kpi-value">${DASHBOARD_PENDING_APPROVALS}</span>
                    </div>
                    <div class="kpi">
                        <span class="kpi-label"><fmt:message key="dashboard.stats.inventory_alerts" /></span>
                        <span class="kpi-value">${DASHBOARD_ACTIVE_ALERTS}</span>
                    </div>
                </c:if>
                <c:if test="${role == 'Staff' and DASHBOARD_ATTENDANCE.hasShift}">
                    <div class="kpi">
                        <span class="kpi-label"><fmt:message key="attendance.card.today_shift" /></span>
                        <span class="kpi-value"><c:out value="${DASHBOARD_ATTENDANCE.shiftName}" /></span>
                        <span class="muted">${DASHBOARD_ATTENDANCE.startTime} - ${DASHBOARD_ATTENDANCE.endTime}</span>
                    </div>
                </c:if>
            </section>

            <div class="home-grid">
                <section class="panel">
                    <h3 class="panel-title"><fmt:message key="home.todo.title" /></h3>
                    <c:set var="hasTodo" value="false" />
                    <ul class="todo-list">
                        <c:if test="${role == 'Manager' and DASHBOARD_PENDING_APPROVALS > 0}">
                            <c:set var="hasTodo" value="true" />
                            <li class="todo-item">
                                <span class="todo-count">${DASHBOARD_PENDING_APPROVALS}</span>
                                <span class="todo-text"><fmt:message key="home.todo.approvals" /></span>
                                <a href="${ctx}/HrManagementController?tab=tracking" class="btn-next"><fmt:message key="home.todo.btn" /></a>
                            </li>
                        </c:if>
                        <c:if test="${role == 'Manager' and DASHBOARD_ACTIVE_ALERTS > 0}">
                            <c:set var="hasTodo" value="true" />
                            <li class="todo-item">
                                <span class="todo-count">${DASHBOARD_ACTIVE_ALERTS}</span>
                                <span class="todo-text"><fmt:message key="home.todo.alerts" /></span>
                                <button type="button" class="btn-next" data-action="open-inventory-alert"><fmt:message key="home.todo.btn" /></button>
                            </li>
                        </c:if>
                        <c:if test="${role == 'Staff' and DASHBOARD_ATTENDANCE.hasShift and not DASHBOARD_ATTENDANCE.hasCheckedOut}">
                            <c:set var="hasTodo" value="true" />
                            <li class="todo-item">
                                <span class="todo-count">${DASHBOARD_ATTENDANCE.startTime}</span>
                                <span class="todo-text">
                                    <c:choose>
                                        <c:when test="${DASHBOARD_ATTENDANCE.hasCheckedIn}"><fmt:message key="home.todo.shift_on" /></c:when>
                                        <c:otherwise><fmt:message key="home.todo.shift_wait" /></c:otherwise>
                                    </c:choose>
                                </span>
                                <a href="${ctx}/AttendanceController" class="btn-next"><fmt:message key="home.todo.btn" /></a>
                            </li>
                        </c:if>
                        <c:if test="${role == 'Shipper'}">
                            <c:set var="hasTodo" value="true" />
                            <li class="todo-item">
                                <span class="todo-text"><fmt:message key="home.todo.delivery" /></span>
                                <a href="${ctx}/ShipperController" class="btn-next"><fmt:message key="home.todo.btn" /></a>
                            </li>
                        </c:if>
                        <c:if test="${role == 'Admin'}">
                            <c:set var="hasTodo" value="true" />
                            <li class="todo-item">
                                <span class="todo-text"><fmt:message key="home.todo.users" /></span>
                                <a href="${ctx}/AdminDashboardController" class="btn-next"><fmt:message key="home.todo.btn" /></a>
                            </li>
                        </c:if>
                        <c:if test="${DASHBOARD_UNREAD_COUNT > 0}">
                            <c:set var="hasTodo" value="true" />
                            <li class="todo-item">
                                <span class="todo-count">${DASHBOARD_UNREAD_COUNT}</span>
                                <span class="todo-text"><fmt:message key="home.todo.notifs" /></span>
                                <button type="button" class="btn-plain" data-action="mark-all-notifications"><fmt:message key="dashboard.notifications.mark_all_read" /></button>
                            </li>
                        </c:if>
                    </ul>
                    <c:if test="${not hasTodo}">
                        <p class="todo-empty"><fmt:message key="home.todo.none" /></p>
                    </c:if>
                </section>

                <section class="panel">
                    <h3 class="panel-title"><fmt:message key="home.activity.title" /></h3>
                    <c:choose>
                        <c:when test="${empty DASHBOARD_NOTIFICATIONS}">
                            <p class="todo-empty"><fmt:message key="dashboard.notifications.empty" /></p>
                        </c:when>
                        <c:otherwise>
                            <ul class="activity-list">
                                <c:forEach var="notif" items="${DASHBOARD_NOTIFICATIONS}">
                                    <li id="feedItem_${notif.notificationId}" class="activity-item ${notif.isRead ? '' : 'unread'}" data-action="mark-notification" data-notif-id="${notif.notificationId}">
                                        <c:out value="${notif.message}" />
                                        <div class="muted">${notif.createdAt}</div>
                                    </li>
                                </c:forEach>
                            </ul>
                        </c:otherwise>
                    </c:choose>
                </section>
            </div>
        </c:otherwise>
    </c:choose>
</main>

<jsp:include page="footer.jsp" />
</file>

<file path="web/inventory_managerment.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<fmt:setLocale value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setBundle basename="resources.messages" />

<jsp:include page="header.jsp" />
<c:set var="ctx" value="${pageContext.request.contextPath}" />

<%-- Bố cục B: danh sách + chi tiết. Trái: tìm kiếm + danh sách nguyên liệu (bấm 1 dòng);
     phải: chi tiết + thao tác của dòng đang chọn (main.js pickIngredient chép data-* của dòng sang khung chi tiết) --%>
<main class="main-content">
    <div class="page-head">
        <h2><fmt:message key="inventory.heading" /></h2>
        <c:if test="${IS_MANAGER}">
            <div class="d-flex gap-10">
                <button type="button" class="btn-plain" data-action="open-inventory-category"><fmt:message key="inventory.category.btn.manage" /></button>
                <button type="button" class="btn-next" data-action="open-create-ingredient">+ <fmt:message key="inventory.btn.add" /></button>
            </div>
        </c:if>
    </div>

    <c:if test="${not empty sessionScope.ERROR_MESSAGE}">
        <p class="msg-error text-center"><fmt:message key="${sessionScope.ERROR_MESSAGE}" /></p>
        <c:remove var="ERROR_MESSAGE" scope="session" />
    </c:if>
    <c:if test="${not empty ERROR_MESSAGE}">
        <p class="msg-error text-center"><fmt:message key="${ERROR_MESSAGE}" /></p>
    </c:if>
    <c:if test="${not empty sessionScope.SUCCESS_MESSAGE}">
        <p class="msg-success text-center"><fmt:message key="${sessionScope.SUCCESS_MESSAGE}" /></p>
        <c:remove var="SUCCESS_MESSAGE" scope="session" />
    </c:if>
    <c:if test="${not empty SUCCESS_MESSAGE}">
        <p class="msg-success text-center"><fmt:message key="${SUCCESS_MESSAGE}" /></p>
    </c:if>

    <div class="md-layout">
        <section class="panel md-list">
            <form action="${ctx}/InventoryManagementController" method="GET" class="md-filter">
                <input type="text" id="searchIngredient" name="search" value="${fn:escapeXml(SEARCH_TERM)}" class="filter-input"
                       placeholder="<fmt:message key="inventory.search.placeholder" />" aria-label="<fmt:message key="inventory.table.name" />" />
                <button type="submit" class="btn-plain"><fmt:message key="inventory.btn.search" /></button>
                <c:if test="${not empty SEARCH_TERM}">
                    <a href="${ctx}/InventoryManagementController" class="btn-plain"><fmt:message key="inventory.btn.clear_search" /></a>
                </c:if>
            </form>

            <c:choose>
                <c:when test="${empty INGREDIENT_LIST}">
                    <p class="todo-empty"><fmt:message key="inventory.empty" /></p>
                </c:when>
                <c:otherwise>
                    <ul class="md-rows">
                        <c:forEach var="item" items="${INGREDIENT_LIST}">
                            <c:choose>
                                <c:when test="${item.stockStatus == 'OUT_OF_STOCK'}"><c:set var="stKey" value="inventory.status.out_of_stock" /><c:set var="stCls" value="badge-status-inactive" /></c:when>
                                <c:when test="${item.stockStatus == 'LOW_STOCK'}"><c:set var="stKey" value="inventory.status.low_stock" /><c:set var="stCls" value="badge-stock-out" /></c:when>
                                <c:otherwise><c:set var="stKey" value="inventory.status.in_stock" /><c:set var="stCls" value="badge-stock-ok" /></c:otherwise>
                            </c:choose>
                            <fmt:message key="${stKey}" var="stText" />
                            <li>
                                <button type="button" class="md-row" data-action="pick-ingredient"
                                        data-id="${item.ingredientId}"
                                        data-cat-id="${item.categoryId}"
                                        data-cat-name="${fn:escapeXml(item.categoryName)}"
                                        data-name="${fn:escapeXml(item.ingredientName)}"
                                        data-unit="${fn:escapeXml(item.unit)}"
                                        data-qty="${item.quantity}"
                                        data-price="${item.price}"
                                        data-loc="${fn:escapeXml(item.storageLocation)}"
                                        data-threshold="${item.warningThreshold}"
                                        data-status-text="${fn:escapeXml(stText)}">
                                    <span class="md-row-top">
                                        <strong><c:out value="${item.ingredientName}" /></strong>
                                        <span class="${stCls}">${stText}</span>
                                    </span>
                                    <span class="muted"><c:out value="${item.categoryName}" /> · <fmt:formatNumber value="${item.quantity}" maxFractionDigits="2" /> <c:out value="${item.unit}" /></span>
                                </button>
                            </li>
                        </c:forEach>
                    </ul>
                </c:otherwise>
            </c:choose>
        </section>

        <section id="invDetail" class="panel md-detail">
            <p id="invDetailEmpty" class="md-placeholder"><fmt:message key="md.pick.ingredient" /></p>
            <div id="invDetailBody" class="d-none">
                <h3 id="invDName" class="panel-title"></h3>
                <table class="admin-table report-info-table">
                    <tr><th><fmt:message key="inventory.table.category" /></th><td id="invDCat"></td></tr>
                    <tr><th><fmt:message key="inventory.table.quantity" /></th><td id="invDQty"></td></tr>
                    <tr><th><fmt:message key="inventory.table.threshold" /></th><td id="invDThreshold"></td></tr>
                    <tr><th><fmt:message key="inventory.table.status" /></th><td id="invDStatus"></td></tr>
                    <tr><th><fmt:message key="inventory.table.price" /></th><td id="invDPrice"></td></tr>
                    <tr><th><fmt:message key="inventory.table.location" /></th><td id="invDLoc"></td></tr>
                </table>
                <c:if test="${IS_MANAGER}">
                    <div class="kanban-actions mt-15">
                        <button type="button" id="invDEdit" class="btn-next" data-action="edit-ingredient"><fmt:message key="inventory.btn.edit" /></button>
                        <button type="button" id="invDThresholdBtn" class="btn-plain" data-action="open-threshold"><fmt:message key="inventory.btn.update_threshold" /></button>
                        <form action="${ctx}/InventoryManagementController" method="POST" class="m-0" data-confirm="<fmt:message key="inventory.confirm.delete" />">
                            <input type="hidden" name="action" value="delete" />
                            <input type="hidden" id="invDDeleteId" name="ingredientId" value="" />
                            <button type="submit" class="btn-plain"><fmt:message key="inventory.btn.delete" /></button>
                        </form>
                    </div>
                </c:if>
            </div>
        </section>
    </div>

    <jsp:include page="components/inventory_form_modal.jsp" />
</main>

<jsp:include page="footer.jsp" />
</file>

