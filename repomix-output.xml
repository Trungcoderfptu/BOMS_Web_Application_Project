            ps.setInt(1, shiftId);
            try (ResultSet rs = ps.executeQuery()) {
                if (rs.next()) {
                    return new Shift(
                            rs.getInt("ShiftID"),
                            rs.getNString("ShiftName"),
                            rs.getTime("StartTime"),
                            rs.getTime("EndTime")
                    );
                }
            }
