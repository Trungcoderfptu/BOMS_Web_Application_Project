<file path="web/css/global.css">
/* ====== TOÀN CỤC (GLOBAL) +++++++ */
/* ===== Biến Màu (CSS Variables) ===== */
:root {
    --bg-primary: #ffffff;
    --bg-secondary: #f4f4f4;
    --bg-tertiary: #dddddd;
    --text-primary: #000000;
    --border-main: #000000;
    --border-light: #cccccc;
    --color-danger: red;
    --color-success: green;
}

body.dark-theme {
    --bg-primary: #0f172a;
    --bg-secondary: #1e1e1e;
    --bg-tertiary: #333333;
    --text-primary: #ffffff;
    --border-main: #555555;
    --border-light: #444444;
    --color-danger: #ff5252;
    --color-success: #4caf50;
}

/* ===== Cấu Trúc Lõi (Base Tags) ===== */
body {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

a {
    color: var(--text-primary);
    text-decoration: none;
}

ul.no-bullet {
    list-style-type: none;
    padding: 0;
    margin: 0;
}

/* ===== Bố Cục Chung (Global Layout) ===== */
.main-content {
    min-height: 400px;
    padding: 20px;
}

.d-flex {
    display: flex;
}

.flex-between {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.flex-align-center {
    display: flex;
    align-items: center;
    gap: 10px;
}

.gap-20 {
    gap: 20px;
}
.gap-30 {
    gap: 30px;
}
.flex-grow-1 {
    flex-grow: 1;
}

/* ===== Thông Báo Lỗi & Thành Công ===== */
.msg-error {
    color: var(--color-danger);
    font-weight: bold;
}

.msg-success {
    color: var(--color-success);
    font-weight: bold;
}

.text-danger {
    color: var(--color-danger);
}
.msg-warning {
    color: #ff9800; /* Màu cam vàng */
    font-weight: bold;
}

.text-danger {
    color: var(--color-danger);
}


/* ====== HEADER & FOOTER +++++++ */
/* ===== Khung Header & Footer ===== */
.app-header {
    border-bottom: 2px solid var(--border-main);
    padding-bottom: 10px;
    margin-bottom: 20px;
}

.app-footer {
    border-top: 2px solid var(--border-main);
    padding-top: 10px;
    text-align: center;
}
/* =====header COMPONENT BANNER HỆ THỐNG ===== */
.system-banner {
    flex-grow: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
}

.banner-text {
    font-size: 22px;
    font-weight: 900;
    color: var(--text-primary);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 0 20px;
    text-shadow: 1px 1px 2px var(--border-light);
}

/* ===== Menu & Navigation ===== */
#btnHamburger {
    font-size: 20px;
    cursor: pointer;
    background: transparent;
    border: none;
    color: var(--text-primary);
}

#btnDongMenuDoc {
