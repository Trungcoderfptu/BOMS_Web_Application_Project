<file path="web/css/global.css">
/* ====== TOÀN CỤC (GLOBAL) +++++++ */
/* ===== Biến Màu (CSS Variables) ===== */
:root {
    --bg-primary: #ffffff;
    --bg-secondary: #f4f4f4;
    --bg-tertiary: #dddddd;
    --bg-card: #ffffff;
    --bg-hover: #f1f5f9;
    --text-primary: #000000;
    --text-muted: #64748b;
    --border-main: #000000;
    --border-light: #cccccc;
    --border-color: #e2e8f0;
    --color-primary: #2563eb;
    --color-danger: red;
    --color-success: green;
}

body.dark-theme {
    --bg-primary: #0f172a;
    --bg-secondary: #1e293b;
    --bg-tertiary: #334155;
    --bg-card: #1e293b;
    --bg-hover: #334155;
    --text-primary: #f8fafc;
    --text-muted: #94a3b8;
    --border-main: #64748b;
    --border-light: #334155;
    --border-color: #334155;
    --color-primary: #60a5fa;
    --color-danger: #ff5252;
    --color-success: #4caf50;
}

/* ===== Cấu Trúc Lõi (Base Tags) ===== */
body {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

a {
    color: var(--text-primary);
    text-decoration: none;
}

ul.no-bullet {
    list-style-type: none;
    padding: 0;
    margin: 0;
}

/* ===== Bố Cục Chung (Global Layout) ===== */
.main-content {
    min-height: 400px;
    padding: 20px;
}

.d-flex {
    display: flex;
}

.flex-between {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.flex-align-center {
    display: flex;
    align-items: center;
    gap: 10px;
}

.gap-20 {
    gap: 20px;
}
.gap-30 {
    gap: 30px;
}
.flex-grow-1 {
    flex-grow: 1;
}

/* ===== Thông Báo Lỗi & Thành Công ===== */
.msg-error {
    color: var(--color-danger);
    font-weight: bold;
}

.msg-success {
    color: var(--color-success);
    font-weight: bold;
}

.text-danger {
    color: var(--color-danger);
}
.msg-warning {
    color: #ff9800; /* Màu cam vàng */
    font-weight: bold;
}

.text-danger {
    color: var(--color-danger);
}


/* ====== HEADER & FOOTER +++++++ */
/* ===== Khung Header & Footer ===== */
.app-header {
    border-bottom: 2px solid var(--border-main);
    padding-bottom: 10px;
    margin-bottom: 20px;
}

.app-footer {
    border-top: 2px solid var(--border-main);
    padding-top: 10px;
    text-align: center;
}
/* =====header COMPONENT BANNER HỆ THỐNG ===== */
.system-banner {
    flex-grow: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
}

.banner-text {
    font-size: 22px;
    font-weight: 900;
    color: var(--text-primary);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 0 20px;
    text-shadow: 1px 1px 2px var(--border-light);
}

/* ===== Menu & Navigation ===== */
#btnHamburger {
    font-size: 20px;
    cursor: pointer;
    background: transparent;
    border: none;
    color: var(--text-primary);
}

#btnDongMenuDoc {
    margin-bottom: 20px;
    cursor: pointer;
}

#menuDoc {
    display: none;
    position: fixed;
    left: 0;
    top: 0;
    width: 200px;
    height: 100%;
    border-right: 2px solid var(--border-main);
    background: var(--bg-secondary);
    padding: 15px;
    z-index: 1001;
}

#menuDoc li {
    margin-bottom: 10px;
}

.dropdown-wrapper {
    position: relative;
}

/* ===== Nút & Avatar (Header) ===== */
.btn-login {
    padding: 8px 15px;
    border: 1px solid var(--border-main);
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    font-weight: bold;
}

#btnAvatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    font-weight: bold;
    background-color: var(--bg-tertiary);
    border: 1px solid var(--border-main);
    color: var(--text-primary);
    padding: 0;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.header-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
}

#menuTaiKhoan {
    display: none;
    position: absolute;
    right: 0;
    border: 1px solid var(--border-main);
    background: var(--bg-primary);
    padding: 10px;
    width: 150px;
    z-index: 1000;
}


/* ====== TRANG SETTINGS +++++++ */
/* ===== Giao diện Sidebar ===== */
.settings-sidebar {
    width: 200px;
    border-right: 2px solid var(--border-main);
    padding-right: 10px;
}

.btn-menu-tab {
    width: 100%;
    margin-bottom: 10px;
    padding: 5px;
    cursor: pointer;
}

.d-none, .hidden {
    display: none !important;
}


/* ====== TRANG PROFILE +++++++ */
/* ===== Giao diện Avatar ===== */
.profile-avatar-col {
    width: 250px;
    text-align: center;
    border: 1px solid var(--border-light);
    padding: 20px;
}

.profile-avatar-circle {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: var(--bg-tertiary);
    margin: 0 auto;
    line-height: 150px;
    font-weight: bold;
    font-size: 40px;
    color: var(--text-primary);
}

.profile-avatar-wrapper {
    width: 150px;
    height: 150px;
    margin: 0 auto;
    position: relative;
}

.profile-avatar-img {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--border-light);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    display: block;
    margin: 0 auto;
}

.btn-delete-avatar {
    padding: 6px 14px;
    font-size: 13px;
    margin-top: 8px;
    background-color: var(--bg-tertiary);
    color: #ef4444;
    border: 1px solid var(--border-light);
    border-radius: 6px;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.2s ease;
}

.btn-delete-avatar:hover {
    background-color: #fee2e2;
    border-color: #fca5a5;
    color: #b91c1c;
}

.input-full-width {
    width: 100%;
    margin-bottom: 10px;
}

/* ===== Giao diện Bảng Thông Tin ===== */
.profile-detail-col {
    border: 1px solid var(--border-light);
    padding: 20px;
}

.profile-table {
    width: 100%;
    line-height: 2.5;
}

.profile-table td:first-child {
    width: 30%;
}


/* ===== Giao diện trang đăng ký ===== */
.register-wrapper {
    max-width: 500px;
    margin: 0 auto;
    padding: 20px;
}

.register-title {
    color: var(--text-primary);
    margin-bottom: 20px;
    text-align: center;
}

.register-layout {
    display: flex;
    flex-direction: column;
}

.register-layout input[type="text"],
.register-layout input[type="password"],
.register-layout input[type="email"],
.register-select {
    width: 100%;
    padding: 10px;
    margin-top: 5px;
    border: 1px solid var(--border-main);
    border-radius: 4px;
    background-color: var(--bg-secondary);
    color: var(--text-primary);
}

.btn-register-action {
    background-color: #28a745;
    color: white;
    padding: 12px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px;
    font-weight: bold;
    margin-top: 15px;
    transition: background-color 0.3s;
}

.btn-register-action:hover {
    background-color: #218838;
}

.register-nav-link {
    display: block;
    text-align: center;
    margin-top: 15px;
    color: #007bff;
    text-decoration: none;
}

.register-nav-link:hover {
    text-decoration: underline;
}
/* ===== COMPONENT NGÔN NGỮ (LANGUAGE SWITCHER) ===== */
.lang-switcher-wrapper {
    position: relative;
    display: inline-block;
}

.floating-lang {
    position: absolute;
    top: 20px;
    right: 20px;
}

.lang-btn {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-main);
    padding: 8px 15px;
    cursor: pointer;
    border-radius: 4px;
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 5px;
}

.lang-dropdown-menu {
    position: absolute;
    top: 100%;
    right: 0;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-main);
    list-style: none;
    padding: 0;
    margin: 5px 0 0 0;
    width: 140px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    border-radius: 4px;
    z-index: 1000;
}

.lang-dropdown-menu li {
    border-bottom: 1px solid var(--border-light);
}

.lang-dropdown-menu li:last-child {
    border-bottom: none;
}

.lang-dropdown-menu a {
    display: block;
    padding: 10px;
    color: var(--text-primary);
    text-decoration: none;
}

.lang-dropdown-menu a:hover {
    background-color: var(--bg-tertiary);
}

/* ===== COMPONENT DARK MODE ===== */
#btnDarkModeGlobal {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    border: 2px solid var(--border-main);
    background-color: var(--bg-tertiary);
    color: var(--text-primary);
    font-size: 20px;
    cursor: pointer;
    z-index: 9999;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
}

#btnDarkModeGlobal:hover {
    transform: scale(1.1);
}
/*=======ADDMIN_DASHBOARD_CSS*/
/* ===== COMPONENT TAB UI (ADMIN DASHBOARD) ===== */
.dashboard-wrapper {
    max-width: 1200px;
    margin: 0 auto;
}

.tab-nav {
    border-bottom: 2px solid var(--border-main);
    margin-bottom: 20px;
}

.tab-btn {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-main);
    border-bottom: none;
    padding: 10px 20px;
    cursor: pointer;
    font-weight: bold;
    font-size: 16px;
    border-radius: 5px 5px 0 0;
    margin-right: 5px;
    transition: background-color 0.3s;
}

.tab-btn:hover {
    background-color: var(--bg-tertiary);
}

.tab-btn.active {
    background-color: var(--bg-primary);
    border-top: 4px solid var(--color-success); /* Vạch xanh đánh dấu tab đang mở */
}

.tab-content {
    animation: fadeIn 0.3s ease-in-out;
}

@keyframes fadeIn {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

/* ===== COMPONENT BẢNG ADMIN (TABLE) ===== */
.admin-table {
    width: 100%;
    border-collapse: collapse;
    background-color: var(--bg-primary);
    color: var(--text-primary);
}

.admin-table th, .admin-table td {
    border: 1px solid var(--border-light);
    padding: 12px;
    text-align: left;
}

.admin-table th {
    background-color: var(--bg-secondary);
    font-weight: bold;
}

.admin-table tr:hover {
    background-color: var(--bg-tertiary); /* Highlight hàng khi di chuột qua */
}

.text-center {
    text-align: center;
}

.mt-15 {
    margin-top: 15px;
}
.gap-10 {
    gap: 10px;
}
/* ===== Tiện ích (Utilities) ===== */
.m-0 {
    margin: 0 !important;
}
.mt-0 {
    margin-top: 0 !important;
}
.w-auto {
    width: auto !important;
}
.btn-sm {
    padding: 4px 8px;
    font-size: 12px;
    cursor: pointer;
}
/* ===== COMPONENT BANNED POPUP (LOGIN) ===== */
.popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
}
.popup-content {
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: 30px;
    border-radius: 8px;
    text-align: center;
    max-width: 400px;
    border: 1px solid var(--border-main);
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
}
.popup-title {
    color: var(--color-danger);
    margin-bottom: 10px;
    font-size: 20px;
}
/* ====== COMPONENT MENU & CART +++++++ */
.menu-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding: 20px;
}

.product-card {
    border: 1px solid var(--border-light);
    border-radius: 8px;
