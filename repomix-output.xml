<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><fmt:message key="menu.title" /></title>
        <link rel="icon" href="${pageContext.request.contextPath}/images/brand/bingxue-favicon-32.png">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&amp;display=swap">
        <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/4.0.0/uicons-regular-rounded/css/uicons-regular-rounded.css">
        <link rel="stylesheet" type="text/css" href="${pageContext.request.contextPath}/css/global.css">
        <link rel="stylesheet" type="text/css" href="${pageContext.request.contextPath}/css/layout.css">
    </head>
    <%-- Màn khách quét QR (bố cục G trên điện thoại: tab xuống đáy, lưới 2 cột). data-open-checkout: sau "Thanh toán ngay" main.js tự mở hộp xác nhận đơn --%>
    <body class="main-content qr-page" data-open-checkout="${OPEN_CHECKOUT ? 'true' : 'false'}">
        <c:choose>
            <c:when test="${not empty CURRENT_TABLE}">
                <div class="flex-between menu-header-bar">
                    <div class="qr-brand"><span class="brand-mark"><img src="${pageContext.request.contextPath}/images/brand/bingxue-logo.png" alt="" /></span><h2 class="m-0"><fmt:message key="menu.heading.customer" />: <c:out value="${CURRENT_TABLE}" /></h2></div>
                    <div class="flex-align-center">
                        <jsp:include page="/components/language_switcher.jsp" />
                        <jsp:include page="/components/theme_toggle.jsp" />
                    </div>
                </div>
            </c:when>
            <c:otherwise>
                <div class="menu-empty-container">
                    <h2 class="msg-error"><fmt:message key="menu.access.denied" /></h2>
                    <p><fmt:message key="menu.access.scan_qr" /> 
                        <a href="${pageContext.request.contextPath}/login.jsp" class="text-link-success"><fmt:message key="menu.access.login" /></a>
                        <fmt:message key="menu.access.as_staff" />.
                    </p>
                </div>
            </c:otherwise>
        </c:choose>

        <c:if test="${not empty ERROR_MESSAGE}">
            <p class="msg-error text-center"><fmt:message key="${ERROR_MESSAGE}" /></p>
        </c:if>
        <c:if test="${not empty SUCCESS_MESSAGE}">
            <p class="msg-success text-center">
                <fmt:message key="${SUCCESS_MESSAGE}" />
                <c:if test="${not empty LAST_ORDER_ID}">
                    <strong> (#${LAST_ORDER_ID})</strong>
                </c:if>
            </p>
        </c:if>
        <c:set var="activeTab" value="${not empty ACTIVE_TAB ? ACTIVE_TAB : 'menu'}" />
        <c:if test="${not empty CURRENT_TABLE or not empty sessionScope.USER_SESSION}">
            <div class="tab-nav d-flex mt-15 mb-20">
                <button type="button" class="tab-btn ${(activeTab == 'cart' or activeTab == 'orders') ? '' : 'active'}" data-tab="tab-menu"><fmt:message key="menu.tab.menu" /></button>
                <button type="button" class="tab-btn ${activeTab == 'cart' ? 'active' : ''}" data-tab="tab-cart">
                    <fmt:message key="menu.tab.cart" /> 
                    <c:if test="${totalCartQuantity > 0}">
                        <span class="msg-error tab-badge">${totalCartQuantity}</span>
                    </c:if>
                </button>
                <c:if test="${not empty CURRENT_TABLE}">
                    <button type="button" class="tab-btn ${activeTab == 'orders' ? 'active' : ''}" data-tab="tab-orders">
                        <fmt:message key="menu.tab.orders" />
                        <c:if test="${not empty TABLE_ORDERS and fn:length(TABLE_ORDERS) > 0}">
                            <span class="msg-success tab-badge">${fn:length(TABLE_ORDERS)}</span>
                        </c:if>
                    </button>
                </c:if>
            </div>
        </c:if>
        <div id="tab-menu" class="tab-content ${(activeTab == 'cart' or activeTab == 'orders') ? 'd-none' : 'active'}">
            <c:if test="${not empty CURRENT_TABLE or not empty sessionScope.USER_SESSION}">
                <%-- Lọc món theo nhóm + nhóm "Bán chạy" (main.js: filterMenuByCategory) --%>
                <jsp:include page="/components/menu_cats.jsp" />
                <jsp:include page="/components/menu_grid.jsp" />
            </c:if>
        </div>
        <div id="tab-cart" class="tab-content ${activeTab == 'cart' ? 'active' : 'd-none'}">
            <c:choose>
                <c:when test="${empty sessionScope.CURRENT_CART or empty sessionScope.CURRENT_CART.orderDetails}">
                    <div class="empty-cart-container">
                        <h3><fmt:message key="menu.cart.empty" /></h3>
                        <button type="button" class="btn-login mt-15" data-tab="tab-menu"><fmt:message key="menu.cart.back_to_menu" /></button>
                    </div>
                </c:when>
                <c:otherwise>
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th><fmt:message key="menu.cart.table.product" /></th>
                                <th><fmt:message key="menu.cart.table.price" /></th>
                                <th><fmt:message key="menu.cart.table.quantity" /></th>
                                <th><fmt:message key="menu.cart.table.total" /></th>
                                <th><fmt:message key="menu.cart.table.action" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            <c:forEach var="cartItem" items="${sessionScope.CURRENT_CART.orderDetails}">
                                <tr>
                                    <td>
                                        <strong><c:out value="${cartItem.product.productName}" /></strong>
                                        <bx:itemOptions sizeName="${cartItem.sizeName}" iceLevel="${cartItem.iceLevel}" sugarLevel="${cartItem.sugarLevel}" toppings="${cartItem.toppings}" note="${cartItem.note}" />
                                    </td>
                                    <td><fmt:formatNumber value="${cartItem.unitPrice}" pattern="#,###" /> ₫</td>
                                    <td>
                                        <div class="cart-qty-control">
                                            <form action="${pageContext.request.contextPath}/CartController" method="POST" class="m-0">
                                                <input type="hidden" name="action" value="update" />
                                                <input type="hidden" name="lineKey" value="${fn:escapeXml(cartItem.lineKey)}" />
                                                <input type="hidden" name="quantity" value="${cartItem.quantity - 1}" />
                                                <c:if test="${not empty CURRENT_TABLE}">
                                                    <input type="hidden" name="tableId" value="${CURRENT_TABLE}" />
                                                </c:if>
                                                <button type="submit" class="btn-qty">-</button>
                                            </form>
                                            <span>${cartItem.quantity}</span>
                                            <form action="${pageContext.request.contextPath}/CartController" method="POST" class="m-0">
                                                <input type="hidden" name="action" value="update" />
                                                <input type="hidden" name="lineKey" value="${fn:escapeXml(cartItem.lineKey)}" />
                                                <input type="hidden" name="quantity" value="${cartItem.quantity + 1}" />
                                                <c:if test="${not empty CURRENT_TABLE}">
                                                    <input type="hidden" name="tableId" value="${CURRENT_TABLE}" />
                                                </c:if>
                                                <button type="submit" class="btn-qty">+</button>
                                            </form>
                                        </div>
                                    </td>
                                    <td><fmt:formatNumber value="${cartItem.unitPrice * cartItem.quantity}" pattern="#,###" /> ₫</td>
                                    <td>
                                        <form action="${pageContext.request.contextPath}/CartController" method="POST" class="m-0">
                                            <input type="hidden" name="action" value="remove" />
                                            <input type="hidden" name="lineKey" value="${fn:escapeXml(cartItem.lineKey)}" />
                                            <c:if test="${not empty CURRENT_TABLE}">
                                                <input type="hidden" name="tableId" value="${CURRENT_TABLE}" />
                                            </c:if>
                                            <button type="submit" class="btn-cart-remove"><fmt:message key="menu.cart.btn.remove" /></button>
                                        </form>
                                    </td>
                                </tr>
                            </c:forEach>
                        </tbody>
                    </table>

                    <div class="flex-between mt-15 cart-summary">
                        <h3 class="m-0"><fmt:message key="menu.cart.total_amount" />: <fmt:formatNumber value="${sessionScope.CURRENT_CART.totalAmount}" pattern="#,###" /> ₫</h3>
                        <div class="cart-actions-group">
                            <form action="${pageContext.request.contextPath}/CartController" method="POST" class="m-0">
                                <input type="hidden" name="action" value="clear" />
                                <c:if test="${not empty CURRENT_TABLE}">
                                    <input type="hidden" name="tableId" value="${CURRENT_TABLE}" />
                                </c:if>
                                <button type="submit" class="btn-cart-clear"><fmt:message key="menu.cart.btn.clear" /></button>
                            </form>
                            <button type="button" class="btn-register-action m-0 btn-checkout" id="btnOpenCheckoutModal"><fmt:message key="menu.btn.checkout" /></button>
                        </div>
                    </div>
                </c:otherwise>
            </c:choose>
        </div>
        <c:if test="${not empty CURRENT_TABLE}">
            <div id="tab-orders" class="tab-content ${activeTab == 'orders' ? 'active' : 'd-none'}">
                <c:choose>
                    <c:when test="${empty TABLE_ORDERS}">
                        <div class="empty-cart-container">
                            <h3><fmt:message key="menu.orders.empty" /></h3>
                            <button type="button" class="btn-login mt-15" data-tab="tab-menu"><fmt:message key="menu.cart.back_to_menu" /></button>
                        </div>
                    </c:when>
                    <c:otherwise>
                        <div class="orders-list-container">
                            <c:forEach var="tableOrder" items="${TABLE_ORDERS}">
                                <div class="order-summary-card mb-15">
                                    <div class="flex-between order-header-row">
                                        <div>
                                            <strong>#${tableOrder.orderId}</strong>
                                            <span class="order-time-text"> - ${tableOrder.createdAt}</span>
                                        </div>
                                        <div>
                                            <span class="order-badge order-badge-${fn:toLowerCase(tableOrder.status)}">
                                                <c:choose>
                                                    <c:when test="${tableOrder.status == 'Accepted'}">
                                                        <fmt:message key="menu.orders.status.accepted" />
                                                    </c:when>
                                                    <c:when test="${tableOrder.status == 'Prepared' or tableOrder.status == 'Delivering'}">
                                                        <fmt:message key="menu.orders.status.cooking" />
                                                    </c:when>
                                                    <c:when test="${tableOrder.status == 'Delivered'}">
                                                        <fmt:message key="menu.orders.status.delivered" />
                                                    </c:when>
                                                    <c:when test="${tableOrder.status == 'Cancelled'}">
                                                        <fmt:message key="menu.orders.status.cancelled" />
                                                    </c:when>
                                                    <c:otherwise>${tableOrder.status}</c:otherwise>
                                                </c:choose>
                                            </span>
                                        </div>
                                    </div>

                                    <table class="table-items-breakdown mt-10">
                                        <c:forEach var="item" items="${tableOrder.details}">
                                            <tr>
                                                <td>
                                                    <c:out value="${item.productName}" />
                                                    <bx:itemOptions sizeName="${item.sizeName}" iceLevel="${item.iceLevel}" sugarLevel="${item.sugarLevel}" toppings="${item.toppings}" note="${item.note}" />
                                                </td>
                                                <td class="text-center">x${item.quantity}</td>
                                                <td class="text-right"><fmt:formatNumber value="${item.unitPrice * item.quantity}" pattern="#,###" /> ₫</td>
                                            </tr>
                                        </c:forEach>
                                    </table>

                                    <div class="flex-between mt-10 order-footer-row">
                                        <h4 class="m-0"><fmt:message key="menu.cart.total_amount" />: <fmt:formatNumber value="${tableOrder.totalAmount}" pattern="#,###" /> ₫</h4>
                                        <c:if test="${tableOrder.canCancelOrder}">
                                            <form action="${pageContext.request.contextPath}/CartController" method="POST" class="m-0 form-cancel-table-order" data-confirm-msg="<fmt:message key="menu.orders.confirm_cancel" />">
                                                <input type="hidden" name="action" value="cancelTableOrder" />
                                                <input type="hidden" name="orderId" value="${tableOrder.orderId}" />
                                                <input type="hidden" name="tableId" value="${CURRENT_TABLE}" />
                                                <button type="submit" class="btn-order-cancel"><fmt:message key="menu.orders.btn.cancel" /></button>
                                            </form>
                                        </c:if>
                                    </div>
                                </div>
                            </c:forEach>
                        </div>
                    </c:otherwise>
                </c:choose>
            </div>
        </c:if>
        <jsp:include page="/components/floating_cart.jsp" />
        <jsp:include page="/components/order_confirm_modal.jsp" />
        <jsp:include page="/components/product_option_modal.jsp" />
        <p class="qr-credit"><fmt:message key="footer.icons.credit" /> <a href="https://www.flaticon.com/uicons" target="_blank" rel="noopener">Flaticon</a></p>
        <script src="${pageContext.request.contextPath}/js/main.js"></script>
    </body>
</html>
</file>

<file path="web/components/menu_grid.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<fmt:setLocale value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setBundle basename="resources.messages" />
<%-- Lưới món: thẻ món mang data-* cho popup chọn tùy chọn (product_option_modal.jsp). Dùng chung: màn khách QR và POS quầy --%>
<c:if test="${not empty MENU_LIST}">
    <div class="menu-grid">
        <c:forEach var="item" items="${MENU_LIST}">
            <c:set var="isBestSeller" value="false" />
            <c:forEach var="bestId" items="${BEST_SELLER_IDS}">
                <c:if test="${bestId == item.productId}"><c:set var="isBestSeller" value="true" /></c:if>
            </c:forEach>
            <c:set var="itemImageSrc" value="" />
            <c:if test="${not empty item.imageUrl}">
                <c:choose>
                    <c:when test="${fn:startsWith(item.imageUrl, 'http')}"><c:set var="itemImageSrc" value="${item.imageUrl}" /></c:when>
                    <c:otherwise><c:set var="itemImageSrc" value="${pageContext.request.contextPath}/${item.imageUrl}" /></c:otherwise>
                </c:choose>
            </c:if>
            <%-- data-* dùng cho popup chọn size / đá / đường / topping / ghi chú (product_option_modal.jsp) --%>
            <div class="product-card ${item.available ? '' : 'out-of-stock'}"
                 data-category="${item.categoryId}"
                 data-bestseller="${isBestSeller}"
                 data-product-id="${item.productId}"
                 data-name="${fn:escapeXml(item.productName)}"
                 data-price="${item.price}"
                 data-image="${fn:escapeXml(itemImageSrc)}"
                 data-desc="${fn:escapeXml(item.description)}"
                 data-video="${fn:escapeXml(item.videoUrl)}"
                 data-has-options="${item.hasOptions}">
                <div class="product-img-placeholder">
                    <c:if test="${item.featured}">
                        <span class="badge-featured"><fmt:message key="menu.badge.featured" /></span>
                    </c:if>
                    <c:if test="${not item.available}">
                        <span class="badge-out-of-stock"><fmt:message key="menu.badge.out_of_stock" /></span>
                    </c:if>
                    <c:choose>
                        <c:when test="${not empty item.imageUrl}">
                            <c:choose>
                                <c:when test="${fn:startsWith(item.imageUrl, 'http')}">
                                    <img src="${item.imageUrl}" alt="${fn:escapeXml(item.productName)}" class="product-card-img" />
                                </c:when>
                                <c:otherwise>
                                    <img src="${pageContext.request.contextPath}/${item.imageUrl}" alt="${fn:escapeXml(item.productName)}" class="product-card-img" />
                                </c:otherwise>
                            </c:choose>
                        </c:when>
                        <c:otherwise>
                            <span class="placeholder-icon"><i class="fi fi-rr-mug-hot" aria-hidden="true"></i></span>
                        </c:otherwise>
                    </c:choose>
                </div>

                <h3><c:out value="${item.productName}" /></h3>
                <div class="product-price"><fmt:formatNumber value="${item.price}" pattern="#,###" /> ₫</div>

                <c:choose>
                    <c:when test="${item.available}">
                        <%-- Mở popup chọn tùy chọn; form thêm giỏ nằm trong popup --%>
                        <button type="button" class="btn-add-cart" data-action="open-product-option"><fmt:message key="menu.btn.add_to_cart" /></button>
                    </c:when>
                    <c:otherwise>
                        <button type="button" class="btn-add-cart btn-disabled" disabled><fmt:message key="menu.btn.out_of_stock" /></button>
                    </c:otherwise>
                </c:choose>
            </div>
        </c:forEach>
    </div>
</c:if>
</file>

<file path="web/components/menu_option_modal.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<fmt:setLocale value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setBundle basename="resources.messages" />
<%-- Quản lý size ly & topping dùng chung. Manager/Admin: thêm, sửa giá, bật/tắt. Staff: chỉ xem. --%>
<div id="menuOptionModal" class="modal-overlay d-none">
    <div class="modal-card modal-card-md">
        <div class="modal-header">
            <h3 class="m-0"><fmt:message key="options.modal.title" /></h3>
            <button type="button" class="btn-modal-close" data-close-modal="menuOptionModal"><i class="fi fi-rr-cross-small" aria-hidden="true"></i></button>
        </div>
        <div class="modal-body">
            <c:if test="${not CAN_MANAGE_OPTIONS}">
                <p class="msg-warning"><fmt:message key="options.readonly_note" /></p>
            </c:if>

            <%-- ===== SIZE LY ===== --%>
            <h4 class="option-admin-heading"><fmt:message key="options.size.heading" /></h4>
            <c:if test="${CAN_MANAGE_OPTIONS}">
                <form action="${pageContext.request.contextPath}/MenuManagementController" method="POST" class="option-admin-row option-admin-new">
                    <input type="hidden" name="action" value="createSize" />
                    <input type="text" name="sizeName" required maxlength="50" class="filter-input" placeholder="<fmt:message key='options.label.name' />" />
                    <input type="number" name="extraPrice" min="0" step="1000" value="0" class="filter-input" title="<fmt:message key='options.label.extra_price' />" />
                    <input type="number" name="sortOrder" value="0" class="filter-input option-admin-sort" title="<fmt:message key='options.label.sort' />" />
                    <button type="submit" class="btn-status-save"><fmt:message key="options.btn.add" /></button>
                </form>
            </c:if>
            <c:choose>
                <c:when test="${empty SIZE_LIST}">
                    <p class="option-admin-empty"><fmt:message key="options.empty" /></p>
                </c:when>
                <c:otherwise>
                    <div class="option-admin-list">
                        <div class="option-admin-row option-admin-head">
                            <span><fmt:message key="options.label.name" /></span>
                            <span><fmt:message key="options.label.extra_price" /></span>
                            <span><fmt:message key="options.label.sort" /></span>
                            <span><fmt:message key="options.label.status" /></span>
                        </div>
                        <c:forEach var="s" items="${SIZE_LIST}">
                            <div class="option-admin-row ${s.active ? '' : 'is-inactive'}">
                                <c:choose>
                                    <c:when test="${CAN_MANAGE_OPTIONS}">
                                        <form action="${pageContext.request.contextPath}/MenuManagementController" method="POST" class="option-admin-edit">
                                            <input type="hidden" name="action" value="updateSize" />
                                            <input type="hidden" name="sizeId" value="${s.sizeId}" />
                                            <input type="text" name="sizeName" required maxlength="50" class="filter-input" value="<c:out value='${s.sizeName}' />" />
                                            <input type="number" name="extraPrice" min="0" step="1000" class="filter-input" value="<fmt:formatNumber value='${s.extraPrice}' pattern='0' />" />
                                            <input type="number" name="sortOrder" class="filter-input option-admin-sort" value="${s.sortOrder}" />
                                            <button type="submit" class="btn-status-save"><fmt:message key="options.btn.save" /></button>
                                        </form>
                                        <form action="${pageContext.request.contextPath}/MenuManagementController" method="POST" class="m-0">
                                            <input type="hidden" name="action" value="toggleSize" />
                                            <input type="hidden" name="sizeId" value="${s.sizeId}" />
                                            <button type="submit" class="btn-option-toggle">
                                                <fmt:message key="${s.active ? 'options.btn.toggle_off' : 'options.btn.toggle_on'}" />
                                            </button>
                                        </form>
                                    </c:when>
                                    <c:otherwise>
                                        <span><c:out value="${s.sizeName}" /></span>
                                        <span>+<fmt:formatNumber value="${s.extraPrice}" pattern="#,##0" /> ₫</span>
                                        <span>${s.sortOrder}</span>
                                        <span><fmt:message key="${s.active ? 'options.status.active' : 'options.status.inactive'}" /></span>
                                    </c:otherwise>
                                </c:choose>
                            </div>
                        </c:forEach>
                    </div>
                </c:otherwise>
            </c:choose>

            <%-- ===== TOPPING ===== --%>
            <h4 class="option-admin-heading"><fmt:message key="options.topping.heading" /></h4>
            <c:if test="${CAN_MANAGE_OPTIONS}">
                <form action="${pageContext.request.contextPath}/MenuManagementController" method="POST" class="option-admin-row option-admin-new">
                    <input type="hidden" name="action" value="createTopping" />
                    <input type="text" name="toppingName" required maxlength="50" class="filter-input" placeholder="<fmt:message key='options.label.name' />" />
                    <input type="number" name="toppingPrice" min="0" step="1000" value="0" class="filter-input" title="<fmt:message key='options.label.price' />" />
                    <button type="submit" class="btn-status-save"><fmt:message key="options.btn.add" /></button>
                </form>
            </c:if>
            <c:choose>
                <c:when test="${empty TOPPING_LIST}">
                    <p class="option-admin-empty"><fmt:message key="options.empty" /></p>
                </c:when>
                <c:otherwise>
                    <div class="option-admin-list">
                        <c:forEach var="t" items="${TOPPING_LIST}">
                            <div class="option-admin-row ${t.active ? '' : 'is-inactive'}">
                                <c:choose>
                                    <c:when test="${CAN_MANAGE_OPTIONS}">
                                        <form action="${pageContext.request.contextPath}/MenuManagementController" method="POST" class="option-admin-edit">
                                            <input type="hidden" name="action" value="updateTopping" />
                                            <input type="hidden" name="toppingId" value="${t.toppingId}" />
                                            <input type="text" name="toppingName" required maxlength="50" class="filter-input" value="<c:out value='${t.toppingName}' />" />
                                            <input type="number" name="toppingPrice" min="0" step="1000" class="filter-input" value="<fmt:formatNumber value='${t.price}' pattern='0' />" />
                                            <button type="submit" class="btn-status-save"><fmt:message key="options.btn.save" /></button>
                                        </form>
                                        <form action="${pageContext.request.contextPath}/MenuManagementController" method="POST" class="m-0">
                                            <input type="hidden" name="action" value="toggleTopping" />
                                            <input type="hidden" name="toppingId" value="${t.toppingId}" />
                                            <button type="submit" class="btn-option-toggle">
                                                <fmt:message key="${t.active ? 'options.btn.toggle_off' : 'options.btn.toggle_on'}" />
                                            </button>
                                        </form>
                                    </c:when>
                                    <c:otherwise>
                                        <span><c:out value="${t.toppingName}" /></span>
                                        <span>+<fmt:formatNumber value="${t.price}" pattern="#,##0" /> ₫</span>
                                        <span><fmt:message key="${t.active ? 'options.status.active' : 'options.status.inactive'}" /></span>
                                    </c:otherwise>
                                </c:choose>
                            </div>
                        </c:forEach>
                    </div>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</div>
</file>

<file path="web/components/pos_counter.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<%@taglib prefix="bx" tagdir="/WEB-INF/tags"%>
<fmt:setLocale value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setBundle basename="resources.messages" />
<c:set var="ctx" value="${pageContext.request.contextPath}" />

<jsp:include page="/header.jsp" />

<%-- Bố cục C: POS 3 vùng cho nhân viên quầy - nhóm món (trái) | lưới món (giữa) | hóa đơn luôn hiện (phải).
     Giữ nguyên CartController (lineKey), #btnOpenCheckoutModal, popup chọn món; data-open-checkout cho "Thanh toán ngay" --%>
<main class="main-content" data-open-checkout="${OPEN_CHECKOUT ? 'true' : 'false'}">
    <div class="page-head">
        <h2>
            <c:choose>
                <c:when test="${not empty CURRENT_TABLE}"><fmt:message key="menu.heading.customer" />: <c:out value="${CURRENT_TABLE}" /></c:when>
                <c:otherwise><fmt:message key="menu.heading.counter" /></c:otherwise>
            </c:choose>
        </h2>
        <span class="muted"><fmt:message key="menu.cashier" />: <c:out value="${sessionScope.USER_SESSION.fullName}" /></span>
    </div>

    <c:if test="${not empty ERROR_MESSAGE}">
        <p class="msg-error text-center"><fmt:message key="${ERROR_MESSAGE}" /></p>
    </c:if>
    <c:if test="${not empty SUCCESS_MESSAGE}">
        <p class="msg-success text-center">
            <fmt:message key="${SUCCESS_MESSAGE}" />
            <c:if test="${not empty LAST_ORDER_ID}"><strong> (#${LAST_ORDER_ID})</strong></c:if>
        </p>
    </c:if>

    <div class="pos">
        <jsp:include page="/components/menu_cats.jsp">
            <jsp:param name="layout" value="pos" />
        </jsp:include>

        <section class="pos-items">
            <jsp:include page="/components/menu_grid.jsp" />
        </section>

        <aside class="panel pos-ticket">
            <h3 class="panel-title"><fmt:message key="pos.ticket.title" /></h3>
            <c:choose>
                <c:when test="${empty sessionScope.CURRENT_CART or empty sessionScope.CURRENT_CART.orderDetails}">
                    <p class="pos-empty"><fmt:message key="pos.ticket.empty" /></p>
                </c:when>
                <c:otherwise>
                    <ul class="pos-ticket-lines">
                        <c:forEach var="line" items="${sessionScope.CURRENT_CART.orderDetails}">
                            <li class="pos-line">
                                <div class="pos-line-main">
                                    <strong><c:out value="${line.product.productName}" /></strong>
                                    <bx:itemOptions sizeName="${line.sizeName}" iceLevel="${line.iceLevel}" sugarLevel="${line.sugarLevel}" toppings="${line.toppings}" note="${line.note}" />
                                    <div class="pos-line-qty">
                                        <form action="${ctx}/CartController" method="POST">
                                            <input type="hidden" name="action" value="update" />
                                            <input type="hidden" name="lineKey" value="${fn:escapeXml(line.lineKey)}" />
                                            <input type="hidden" name="quantity" value="${line.quantity - 1}" />
                                            <c:if test="${not empty CURRENT_TABLE}"><input type="hidden" name="tableId" value="${fn:escapeXml(CURRENT_TABLE)}" /></c:if>
                                            <button type="submit" class="btn-qty">-</button>
                                        </form>
                                        <span>${line.quantity}</span>
                                        <form action="${ctx}/CartController" method="POST">
                                            <input type="hidden" name="action" value="update" />
                                            <input type="hidden" name="lineKey" value="${fn:escapeXml(line.lineKey)}" />
                                            <input type="hidden" name="quantity" value="${line.quantity + 1}" />
                                            <c:if test="${not empty CURRENT_TABLE}"><input type="hidden" name="tableId" value="${fn:escapeXml(CURRENT_TABLE)}" /></c:if>
                                            <button type="submit" class="btn-qty">+</button>
                                        </form>
                                        <form action="${ctx}/CartController" method="POST">
                                            <input type="hidden" name="action" value="remove" />
                                            <input type="hidden" name="lineKey" value="${fn:escapeXml(line.lineKey)}" />
                                            <c:if test="${not empty CURRENT_TABLE}"><input type="hidden" name="tableId" value="${fn:escapeXml(CURRENT_TABLE)}" /></c:if>
                                            <button type="submit" class="btn-cart-remove"><fmt:message key="menu.cart.btn.remove" /></button>
                                        </form>
                                    </div>
                                </div>
                                <span class="pos-line-price"><fmt:formatNumber value="${line.unitPrice * line.quantity}" pattern="#,###" /> ₫</span>
                            </li>
                        </c:forEach>
                    </ul>

                    <div class="pos-total">
                        <span><fmt:message key="menu.cart.total_amount" /></span>
                        <span><fmt:formatNumber value="${sessionScope.CURRENT_CART.totalAmount}" pattern="#,###" /> ₫</span>
                    </div>
                    <div class="pos-actions">
                        <form action="${ctx}/CartController" method="POST" class="m-0">
                            <input type="hidden" name="action" value="clear" />
                            <c:if test="${not empty CURRENT_TABLE}"><input type="hidden" name="tableId" value="${fn:escapeXml(CURRENT_TABLE)}" /></c:if>
                            <button type="submit" class="btn-plain"><fmt:message key="menu.cart.btn.clear" /></button>
                        </form>
                        <button type="button" class="btn-next" id="btnOpenCheckoutModal"><fmt:message key="menu.btn.checkout" /></button>
                    </div>
                </c:otherwise>
            </c:choose>
        </aside>
    </div>

    <jsp:include page="/components/order_confirm_modal.jsp" />
    <jsp:include page="/components/product_option_modal.jsp" />
</main>
<jsp:include page="/footer.jsp" />
</file>

<file path="web/components/product_option_modal.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<c:set var="optLocale" value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setLocale value="${optLocale}" />
<fmt:setBundle basename="resources.messages" />
<%-- Popup chi tiết món kiểu menu online: ảnh lớn, mô tả, video, size (bắt buộc), mức đá, mức đường,
     topping (chọn nhiều), ghi chú, số lượng. Dữ liệu từng món lấy từ data-* của .product-card (main.js điền vào).
     Bố cục: ảnh đứng yên phía trên, chỉ .option-scroll cuộn, chân popup (số lượng + nút) luôn ở đáy. --%>
<div id="productOptionModal" class="modal-overlay d-none">
    <div class="modal-card option-modal">
        <button type="button" class="btn-modal-close option-modal-close" data-close-modal="productOptionModal"
                aria-label="<fmt:message key='option.close' />">&times;</button>

        <div class="option-media" data-action="toggle-option-zoom">
            <img id="optModalImg" class="option-img d-none" src="" alt="" />
            <span id="optModalLetter" class="option-img-letter d-none"></span>
            <span class="option-zoom-hint"><fmt:message key="option.zoom_hint" /></span>
        </div>

        <form id="productOptionForm" action="${pageContext.request.contextPath}/CartController" method="POST"
              class="option-form" data-locale="${fn:escapeXml(optLocale)}">
            <input type="hidden" name="action" value="add" />
            <input type="hidden" id="optModalProductId" name="productId" value="" />
            <input type="hidden" id="optModalBuyNow" name="buyNow" value="false" />
            <c:if test="${not empty CURRENT_TABLE}">
                <input type="hidden" name="tableId" value="${fn:escapeXml(CURRENT_TABLE)}" />
            </c:if>

            <div class="option-scroll">
                <div class="option-title-row">
                    <h3 id="optModalName" class="option-name"></h3>
                    <a id="optModalVideo" class="option-video d-none" href="#" target="_blank" rel="noopener noreferrer">
                        <fmt:message key="option.video" />
                    </a>
                </div>
                <p id="optModalDesc" class="option-desc d-none"></p>

                <%-- Phần tuỳ chọn: ẩn với món không có tuỳ chọn (HasOptions = 0) --%>
                <div id="optModalChoices">
                    <c:if test="${not empty MENU_SIZES}">
                        <fieldset class="option-group option-box">
                            <legend><fmt:message key="option.size" /> <span class="option-required"><fmt:message key="option.required" /></span></legend>
                            <c:forEach var="size" items="${MENU_SIZES}" varStatus="st">
                                <label class="option-choice">
                                    <input type="radio" name="sizeId" value="${size.sizeId}" data-extra="${size.extraPrice}" ${st.first ? 'checked' : ''} />
                                    <span class="option-choice-name"><c:out value="${size.sizeName}" /></span>
                                    <span class="option-choice-price">+<fmt:formatNumber value="${size.extraPrice}" pattern="#,##0" /> ₫</span>
                                </label>
                            </c:forEach>
                        </fieldset>
                    </c:if>

                    <div class="option-pair">
                        <fieldset class="option-group option-box">
                            <legend><fmt:message key="option.ice" /></legend>
                            <c:forEach var="lv" items="${ICE_LEVELS}" varStatus="st">
                                <label class="option-choice">
                                    <input type="radio" name="iceLevel" value="${lv}" ${st.first ? 'checked' : ''} />
                                    <span class="option-choice-name"><fmt:message key="option.ice.${lv}" /></span>
                                </label>
                            </c:forEach>
                        </fieldset>

                        <fieldset class="option-group option-box">
                            <legend><fmt:message key="option.sugar" /></legend>
                            <c:forEach var="lv" items="${SUGAR_LEVELS}" varStatus="st">
                                <label class="option-choice">
                                    <input type="radio" name="sugarLevel" value="${lv}" ${st.first ? 'checked' : ''} />
                                    <span class="option-choice-name"><fmt:message key="option.sugar.${lv}" /></span>
                                </label>
                            </c:forEach>
                        </fieldset>
                    </div>

                    <c:if test="${not empty MENU_TOPPINGS}">
                        <fieldset class="option-group option-box">
                            <legend><fmt:message key="option.toppings" /></legend>
                            <c:forEach var="tp" items="${MENU_TOPPINGS}">
                                <label class="option-choice">
                                    <input type="checkbox" name="toppingId" value="${tp.toppingId}" data-extra="${tp.price}" />
                                    <span class="option-choice-name"><c:out value="${tp.toppingName}" /></span>
                                    <span class="option-choice-price">+<fmt:formatNumber value="${tp.price}" pattern="#,##0" /> ₫</span>
                                </label>
                            </c:forEach>
                        </fieldset>
                    </c:if>
                </div>

                <fieldset class="option-group">
                    <legend><label for="optModalNote"><fmt:message key="option.note" /></label></legend>
                    <textarea id="optModalNote" name="itemNote" rows="2" maxlength="200" class="filter-input option-note"
                              placeholder="<fmt:message key='option.note.placeholder' />"></textarea>
                </fieldset>
            </div>

            <div class="option-footer">
                <div class="option-qty" aria-label="<fmt:message key='option.quantity' />">
                    <button type="button" class="btn-qty" data-action="opt-qty" data-step="-1">-</button>
                    <input type="number" id="optModalQty" name="quantity" value="1" min="1" max="99" readonly />
                    <button type="button" class="btn-qty" data-action="opt-qty" data-step="1">+</button>
                </div>
                <button type="submit" class="btn-option-add"><fmt:message key="menu.btn.add_to_cart" /></button>
                <button type="button" class="btn-option-buy" data-action="opt-buy-now">
                    <fmt:message key="option.btn.buy_now" /> - <span id="optModalTotal">0</span> ₫
                </button>
            </div>
        </form>
    </div>
</div>
</file>

<file path="web/components/report_detail_panel.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<c:set var="currentLang" value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setLocale value="${currentLang}" />
<fmt:setBundle basename="resources.messages" />
<%-- Khung chi tiết báo cáo (cột phải của bố cục danh sách + chi tiết trong report_management.jsp) --%>
<section class="panel md-detail">
<h2><fmt:message key="report.detail.heading" />: <c:out value="${REPORT_DETAIL.ticketId}" /></h2>


<%-- Bước 4: Hiển thị chi tiết báo cáo --%>
<table class="admin-table report-info-table">
    <tr><th><fmt:message key="report.label.category" /></th><td><c:out value="${REPORT_DETAIL.categoryName}" /></td></tr>
    <tr><th><fmt:message key="report.label.status" /></th>
        <td><span class="order-badge report-badge-${fn:toLowerCase(REPORT_DETAIL.statusKey)}"><fmt:message key="report.status.${REPORT_DETAIL.statusKey}" /></span></td></tr>
    <tr><th><fmt:message key="report.label.submitted_at" /></th><td>${REPORT_DETAIL.submittedAt}</td></tr>
    <tr><th><fmt:message key="report.label.updated_at" /></th><td>${empty REPORT_DETAIL.updatedAt ? '-' : REPORT_DETAIL.updatedAt}</td></tr>
    <tr><th><fmt:message key="report.label.title" /></th><td><strong><c:out value="${REPORT_DETAIL.title}" /></strong></td></tr>
    <tr><th><fmt:message key="report.label.description" /></th><td class="report-pre"><c:out value="${REPORT_DETAIL.description}" /></td></tr>
    <tr><th><fmt:message key="report.label.evidence" /></th>
        <td>
            <c:choose>
                <c:when test="${empty REPORT_DETAIL.evidences}"><fmt:message key="report.evidence.none" /></c:when>
                <c:otherwise>
                    <%-- 8.2 Download Evidence --%>
                    <ul class="no-bullet evidence-list">
                        <c:forEach var="ev" items="${REPORT_DETAIL.evidences}">
                            <li>
                                <a href="${pageContext.request.contextPath}/EvidenceController?id=${ev.evidenceId}&reportId=${REPORT_DETAIL.reportId}">
                                    <c:out value="${ev.fileName}" />
                                </a>
                                <span class="report-hint">(${fn:toUpperCase(ev.fileType)}, ${ev.fileSizeKb} KB)</span>
                            </li>
                        </c:forEach>
                    </ul>
                </c:otherwise>
            </c:choose>
        </td></tr>
    <tr><th><fmt:message key="report.label.feedback" /></th>
        <td class="report-pre">
            <c:choose>
                <c:when test="${not empty REPORT_DETAIL.feedback}"><c:out value="${REPORT_DETAIL.feedback}" /></c:when>
                <c:otherwise><fmt:message key="report.feedback.none" /></c:otherwise>
            </c:choose>
        </td></tr>
</table>

<c:choose>
    <c:when test="${REPORT_DETAIL.closed}">
        <p class="msg-warning mt-15"><fmt:message key="report.detail.closed" /></p>
    </c:when>
    <c:otherwise>
        <%-- Bước 6 - 8: Chọn trạng thái mới, nhập phản hồi và gửi --%>
        <h3 class="mt-15"><fmt:message key="report.detail.process_heading" /></h3>
        <form action="${pageContext.request.contextPath}/ReportManagementController" method="POST" class="report-form">
            <input type="hidden" name="reportId" value="${REPORT_DETAIL.reportId}" />
            <div class="report-field">
                <label for="newStatus"><fmt:message key="report.label.new_status" /> *</label>
                <select id="newStatus" name="newStatus" class="filter-input ${ERROR_MESSAGE == 'E0310' ? 'input-error' : ''}" required>
                    <option value="In Progress" ${param.newStatus == 'In Progress' ? 'selected' : ''}><fmt:message key="report.status.In_Progress" /></option>
                    <option value="Resolved" ${param.newStatus == 'Resolved' ? 'selected' : ''}><fmt:message key="report.status.Resolved" /></option>
                    <option value="Rejected" ${param.newStatus == 'Rejected' ? 'selected' : ''}><fmt:message key="report.status.Rejected" /></option>
                </select>
            </div>
            <div class="report-field">
                <label for="txtFeedback"><fmt:message key="report.label.feedback_notes" /></label>
                <textarea id="txtFeedback" name="txtFeedback" rows="5"
                          class="filter-input ${ERROR_MESSAGE == 'E0311' ? 'input-error' : ''}"><c:out value="${param.txtFeedback}" /></textarea>
                <small class="report-hint"><fmt:message key="report.hint.reject_feedback" /></small>
            </div>
            <div class="report-actions">
                <button type="submit" class="btn-register-action m-0 w-auto"><fmt:message key="report.btn.submit_update" /></button>
                <%-- 8.1 Cancel Action: bỏ dữ liệu đã nhập, giữ trạng thái cũ, quay lại màn hình chi tiết --%>
                <a href="${pageContext.request.contextPath}/ReportManagementController?reportId=${REPORT_DETAIL.reportId}" class="btn-report-cancel"><fmt:message key="report.btn.cancel" /></a>
            </div>
        </form>
    </c:otherwise>
</c:choose>
</section>
</file>

<file path="web/css/layout.css">
/* =====================================================================
   BỐ CỤC NGHIỆP VỤ (lượt 1, bản cơ bản - màu trung tính, dùng biến của global.css)
   H: khung app theo phân hệ | E: trang chủ việc cần làm | A: Kanban đơn | C: POS quầy
   ===================================================================== */


/* =====================================================================
   PHONG CÁCH (người dùng chọn 2026-10-28)
   - Chế độ sáng = MẪU C "Trắng + nét cam": nền trắng, chữ gần đen, nút viền cam chữ cam (không tô nền).
   - Chế độ tối  = MẪU D "Nền tối + cam": nền nâu đen, chữ trắng ngà, nút tô cam chữ tối.
   - Chữ: Be Vietnam Pro cho cả tiêu đề và nội dung.
   - Icon: Uicons by Flaticon, kiểu Regular Rounded (fi-rr-*), nạp qua CDN trong header.jsp.
   - Ánh xạ lại biến màu cũ của global.css để các trang cũ đổi theo.
   ===================================================================== */
:root {
    --bx-bg: #FAF7F4;
    --bx-side: #FFFFFF;
    --bx-col: #F3ECE6;
    --bx-card: #FFFFFF;
    --bx-line: #EFE5DD;
    --bx-ink: #2B1A10;
    --bx-mute: #7E6A5C;
    --bx-acc: #F26B2A;
    --bx-acc-dark: #D9531E;
    --bx-soft: #FDE6DA;
    --bx-ok: #2E7D32;
    --bx-danger: #C62828;
    /* Nút chính và tab đang chọn: mẫu C = viền cam, nền trắng */
    --bx-btn-bg: #F26B2A;
    --bx-btn-ink: #FFFFFF;
    --bx-btn-line: #F26B2A;
    --bx-btn-hover: #D9531E;
    --bx-tab-on-bg: #2B1A10;
    --bx-tab-on-ink: #FFFFFF;
    /* Thanh trên + cột menu trái: tô cam tươi, chữ trắng, mục đang chọn = ô trắng chữ cam */
    --bx-bar-bg: #F26B2A;
    --bx-bar-ink: #FFFFFF;
    --bx-bar-mute: #FFFFFF;
    --bx-bar-hover: rgba(255, 255, 255, 0.16);
    --bx-bar-line: rgba(255, 255, 255, 0.45);
    --bx-bar-on-bg: #FFFFFF;
    --bx-bar-on-ink: #D9531E;
    /* Thanh trên: nền trắng, tab đang chọn = ô nâu đậm chữ trắng (mẫu G) */
    --bx-top-bg: #FFFFFF;
    --bx-top-ink: #2B1A10;
    --bx-top-mute: #7E6A5C;
    --bx-top-hover: #F3ECE6;
    --bx-top-line: #EFE5DD;
    --bx-top-brand: #F26B2A;
    --bx-top-on-bg: #2B1A10;
    --bx-top-on-ink: #FFFFFF;
    --bx-top-avatar-bg: #F26B2A;
    --bx-top-avatar-ink: #FFFFFF;
    --font-body: 'Be Vietnam Pro', system-ui, sans-serif;
    --font-head: var(--font-body);

    --bg-primary: var(--bx-card);
    --bg-secondary: var(--bx-col);
    --bg-tertiary: var(--bx-line);
    --bg-card: var(--bx-card);
    --bg-hover: var(--bx-soft);
    --text-primary: var(--bx-ink);
    --text-muted: var(--bx-mute);
    --border-main: var(--bx-line);
    --border-light: var(--bx-line);
    --border-color: var(--bx-line);
    --color-primary: var(--bx-acc);
    --primary-color: var(--bx-acc);
    --color-danger: var(--bx-danger);
    --color-success: var(--bx-ok);
}

/* Chế độ tối = mẫu D (nút sáng/tối thêm class dark-theme vào body). Mọi chữ dùng màu sáng */
body.dark-theme {
    --bx-bg: #16130F;
    --bx-side: #1E1A15;
    --bx-col: #1E1A15;
    --bx-card: #26211B;
    --bx-line: #352D25;
    --bx-ink: #F2EAE2;
    --bx-mute: #B5A697;
    --bx-acc: #FF7A45;
    --bx-acc-dark: #FF8A57;
    --bx-soft: #3A2A20;
    --bx-ok: #81C784;
    --bx-danger: #FF6B5B;
    --bx-btn-bg: #FF7A45;
    --bx-btn-ink: #1A120C;
    --bx-btn-line: #FF7A45;
    --bx-btn-hover: #FF8A57;
    --bx-tab-on-bg: #FF7A45;
    --bx-tab-on-ink: #1A120C;
    /* Mẫu D: thanh trên + cột trái giữ nền tối, mục đang chọn tô cam */
    --bx-bar-bg: #1E1A15;
    --bx-bar-ink: #F2EAE2;
    --bx-bar-mute: #B5A697;
    --bx-bar-hover: #2E2620;
    --bx-bar-line: #352D25;
    --bx-bar-on-bg: #FF7A45;
    --bx-bar-on-ink: #1A120C;
    --bx-top-bg: #1E1A15;
    --bx-top-ink: #F2EAE2;
    --bx-top-mute: #B5A697;
    --bx-top-hover: #2E2620;
    --bx-top-line: #352D25;
    --bx-top-brand: #FF7A45;
    --bx-top-on-bg: #FF7A45;
    --bx-top-on-ink: #1A120C;
    --bx-top-avatar-bg: #FF7A45;
    --bx-top-avatar-ink: #1A120C;
    --bg-primary: var(--bx-card);
    --bg-secondary: var(--bx-col);
    --bg-tertiary: var(--bx-line);
    --bg-card: var(--bx-card);
    --bg-hover: var(--bx-soft);
    --text-primary: var(--bx-ink);
    --text-muted: var(--bx-mute);
    --border-main: var(--bx-line);
    --border-light: var(--bx-line);
    --border-color: var(--bx-line);
    --color-primary: var(--bx-acc);
    --primary-color: var(--bx-acc);
    --color-danger: var(--bx-danger);
    --color-success: var(--bx-ok);
}

body {
    background: var(--bx-bg);
    color: var(--bx-ink);
    font-family: var(--font-body);
}

h1, h2, h3, h4, .panel-title, .topbar-brand-text {
    font-family: var(--font-head);
    color: var(--bx-ink);
}

/* Ô nhập/nút không tự kế thừa màu chữ -> ép theo theme để chế độ tối không ra chữ đen */
button, input, select, textarea {
    font-family: var(--font-body);
    color: var(--bx-ink);
}

/* Nền mặc định của trình duyệt cho nút là xám sáng -> đặt theo theme (các class riêng vẫn ghi đè được) */
button, input, select, textarea {
    background-color: var(--bx-card);
}

a {
    color: inherit;
}

/* Icon Uicons: canh giữa theo dòng chữ */
.fi {
    display: inline-flex;
    line-height: 1;
    vertical-align: -0.125em;
}

/* Logo: ảnh PNG nền trong suốt, cắt lấy phần biểu tượng gấu (không khung, không nền) */
.brand-mark {
    width: 38px;
    height: 38px;
    flex: none;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.brand-mark img {
    width: 88px;
    height: 88px;
    object-fit: cover;
    transform: translateY(12px);
}


.topbar-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
}

.topbar-brand-text {
    font-size: 21px;
    font-weight: 700;
    color: var(--bx-acc);
}

/* ---------- Thành phần cũ của global.css: nút, tab, bảng, ô nhập ---------- */
.btn-login,
.btn-primary,
.btn-register-action,
.btn-status-save,
.btn-checkout,
.btn-add-cart,
.btn-assign,
.btn-claim,
.btn-accept,
.btn-clock-in {
    border: 1.5px solid var(--bx-btn-line);
    border-radius: 4px;
    background: var(--bx-btn-bg);
    color: var(--bx-btn-ink);
    font-weight: 700;
    cursor: pointer;
}

.btn-login:hover,
.btn-primary:hover,
.btn-register-action:hover,
.btn-status-save:hover,
.btn-checkout:hover,
.btn-add-cart:hover,
.btn-assign:hover,
.btn-claim:hover,
.btn-accept:hover,
.btn-clock-in:hover {
    background: var(--bx-btn-hover);
    color: var(--bx-btn-ink);
}

.btn-secondary,
.btn-login.btn-secondary,
.btn-action-edit,
.btn-modal-cancel,
.btn-modal-back {
    border: 1px solid var(--bx-line);
    border-radius: 4px;
    background: var(--bx-card);
    color: var(--bx-ink);
}

.btn-danger,
.btn-reject,
.btn-order-cancel,
.btn-action-toggle-stop,
.btn-clock-out,
.btn-cart-remove,
.btn-cart-clear {
    border: 1px solid var(--bx-danger);
    border-radius: 4px;
    background: transparent;
    color: var(--bx-danger);
}

.btn-add-cart.btn-disabled {
    background: var(--bx-line);
    color: var(--bx-mute);
}

.tab-btn {
    border: 1px solid var(--bx-line);
    border-bottom: none;
    border-radius: 4px 2px 0 0;
    background: var(--bx-col);
    color: var(--bx-ink);
}

.tab-btn.active {
    background: var(--bx-card);
    border-top: 3px solid var(--bx-acc);
}

.admin-table th,
.data-table th {
    background: var(--bx-col);
}

.admin-table tr:hover,
.data-table tr:hover {
    background: var(--bx-soft);
}

.filter-input,
.form-input,
.status-select {
    border: 1px solid var(--bx-line);
    border-radius: 4px;
    background: var(--bx-card);
    color: var(--bx-ink);
}

.product-price {
    color: var(--bx-acc-dark);
}

.modal-card {
    border-radius: 4px;
    border-color: var(--bx-line);
}

#btnDarkModeGlobal {
    background: var(--bx-card);
    border: 1px solid var(--bx-line);
    color: var(--bx-ink);
}

.btn-icon-alert,
#btnHamburger,
.lang-btn {
    border: 1px solid var(--bx-line);
    border-radius: 4px;
    background: var(--bx-card);
    color: var(--bx-ink);
}

.app-footer {
    border-top: 1px solid var(--bx-line);
    color: var(--bx-mute);
    font-size: 12px;
}

.app-footer a {
    color: var(--bx-acc-dark);
}

/* ---------- H. Khung app ---------- */
.topbar {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0;
    padding: 8px 16px;
    border-bottom: 1px solid var(--border-light);
    background: var(--bg-primary);
    position: sticky;
    top: 0;
    z-index: 900;
}

.topbar-left {
    display: flex;
    align-items: center;
    gap: 8px;
}

.topbar-brand {
    font-size: 18px;
    font-weight: bold;
}

.module-tabs {
    display: flex;
    gap: 4px;
    flex: 1;
    overflow-x: auto;
}

.module-tab {
    padding: 8px 14px;
    border-radius: 4px;
    white-space: nowrap;
    color: var(--text-muted);
    font-weight: bold;
}

.module-tab:hover {
    background: var(--bg-secondary);
    color: var(--text-primary);
}

.module-tab.active {
    background: var(--bx-tab-on-bg);
    color: var(--bx-tab-on-ink);
}

.topbar-tools {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
}

.subnav-title {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: bold;
    text-transform: uppercase;
    color: var(--text-muted);
}

.subnav li {
    margin-bottom: 2px;
}

.subnav a {
    display: block;
    padding: 8px 10px;
    border-radius: 4px;
}

.subnav a:hover {
    background: var(--bg-tertiary);
}

.subnav a.active {
    background: var(--bx-soft);
    color: var(--bx-acc-dark);
    font-weight: bold;
}

/* Màn rộng: menu con luôn hiện cột trái, nội dung bên phải */
@media (min-width: 1024px) {
    body.has-shell {
        display: grid;
        grid-template-columns: 210px minmax(0, 1fr);
        grid-template-rows: auto 1fr auto;
        min-height: 100vh;
    }

    body.has-shell > .topbar {
        grid-column: 1 / -1;
    }

    body.has-shell > #menuDoc {
        display: block !important;
        position: static;
        width: auto;
        height: auto;
        grid-column: 1;
        grid-row: 2 / 4;
        border-right: 1px solid var(--border-light);
        padding: 16px 12px;
    }

    body.has-shell > main,
    body.has-shell > .app-footer {
        grid-column: 2;
    }

    body.has-shell #btnHamburger,
    body.has-shell #btnDongMenuDoc {
        display: none;
    }
}

/* ---------- Dùng chung ---------- */
.page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.page-head h2 {
    margin: 0;
}

.panel {
    border: 1px solid var(--border-light);
    border-radius: 4px;
    background: var(--bg-primary);
    padding: 14px;
}

.panel-title {
    margin: 0 0 10px;
    font-size: 16px;
}

.muted {
    color: var(--text-muted);
    font-size: 13px;
}

.chip-filter {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}

.chip-filter button {
    padding: 6px 12px;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    background: var(--bg-primary);
    color: var(--text-primary);
    cursor: pointer;
    font-weight: bold;
}

.chip-filter button.active {
    background: var(--text-primary);
    border-color: var(--text-primary);
    color: var(--bg-primary);
}

/* ---------- E. Trang chủ: việc cần làm ---------- */
.kpi-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    margin-bottom: 16px;
}

.kpi {
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 12px 14px;
    background: var(--bg-primary);
}

.kpi-label {
    display: block;
    font-size: 13px;
    color: var(--text-muted);
}

.kpi-value {
    font-size: 26px;
    font-weight: bold;
}

.home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 16px;
    align-items: start;
}

.todo-list,
.activity-list {
    list-style: none;
    margin: 0;
    padding: 0;
}

.todo-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid var(--border-light);
}

.todo-item:first-child {
    border-top: none;
}

.todo-count {
    min-width: 40px;
    text-align: center;
    font-size: 20px;
    font-weight: bold;
}

.todo-text {
    flex: 1;
}

.todo-empty {
    padding: 16px 0;
    color: var(--text-muted);
}

.activity-item {
    padding: 8px 0;
    border-top: 1px solid var(--border-light);
    font-size: 14px;
    cursor: pointer;
}

.activity-item:first-child {
    border-top: none;
}

.activity-item.unread {
    font-weight: bold;
}

/* ---------- A. Kanban đơn hàng ---------- */
.kanban-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.kanban {
    display: grid;
    grid-template-columns: repeat(4, minmax(240px, 1fr)) minmax(180px, 0.7fr);
    gap: 12px;
    overflow-x: auto;
    align-items: start;
}

.kanban-col {
    background: var(--bg-secondary);
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 8px;
    min-height: 200px;
}

.kanban-col-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 4px 4px 8px;
    font-weight: bold;
}

.kanban-count {
    min-width: 24px;
    padding: 0 6px;
    border-radius: 10px;
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    text-align: center;
    font-size: 12px;
}

.kanban-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 10px;
    margin-bottom: 8px;
}

.kanban-card-head {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-weight: bold;
}

.kanban-card-items {
    list-style: none;
    margin: 8px 0;
    padding: 0;
    font-size: 13px;
}

.kanban-card-items li {
    padding: 2px 0;
}

.kanban-card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    border-top: 1px dashed var(--border-light);
    padding-top: 8px;
}

.kanban-actions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}

.kanban-actions form {
    margin: 0;
}

.kanban-empty {
    padding: 16px 4px;
    color: var(--text-muted);
    font-size: 13px;
    text-align: center;
}

.btn-next {
    padding: 6px 10px;
    border: 1.5px solid var(--bx-btn-line);
    border-radius: 4px;
    background: var(--bx-btn-bg);
    color: var(--bx-btn-ink);
    font-weight: bold;
    cursor: pointer;
}

.btn-plain {
    padding: 6px 10px;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    background: var(--bg-primary);
    color: var(--text-primary);
    cursor: pointer;
}

/* ---------- C. POS quầy: nhóm | món | hóa đơn ---------- */
.pos {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr) 340px;
    gap: 12px;
    align-items: start;
}

.pos-cats {
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: sticky;
    top: 70px;
}

.pos-cats .menu-cat {
    text-align: left;
}

/* Lưới món trong POS: tự chia cột theo bề ngang (thẻ món cũ rộng cố định 200px) */
.pos-items .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
}

.pos-items .product-card {
    width: auto;
    padding: 10px;
}

.pos-items .product-card h3 {
    font-size: 14px;
    margin: 6px 0;
}

.pos-ticket {
    position: sticky;
    top: 70px;
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - 90px);
}

.pos-ticket-lines {
    flex: 1;
    overflow-y: auto;
    list-style: none;
    margin: 0;
    padding: 0;
}

.pos-line {
    display: flex;
    gap: 8px;
    padding: 8px 0;
    border-top: 1px solid var(--border-light);
}

.pos-line:first-child {
    border-top: none;
}

.pos-line-main {
    flex: 1;
    min-width: 0;
}

.pos-line-price {
    font-weight: bold;
    white-space: nowrap;
}

.pos-line-qty {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
}

.pos-line-qty form {
    margin: 0;
}

.pos-total {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-top: 2px solid var(--text-primary);
    font-size: 18px;
    font-weight: bold;
}

.pos-actions {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 8px;
}

.pos-actions form,
.pos-actions button {
    width: 100%;
}

.pos-empty {
    padding: 24px 0;
    text-align: center;
    color: var(--text-muted);
}

/* ---------- B. Danh sách + chi tiết (Báo cáo, Kho) ---------- */
.md-layout {
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.4fr);
    gap: 16px;
    align-items: start;
}

.md-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 10px;
}

.md-filter .filter-input {
    flex: 1;
    min-width: 120px;
}

.md-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: calc(100vh - 220px);
    overflow-y: auto;
}

.md-row {
    display: block;
    width: 100%;
    padding: 10px;
    border: none;
    border-top: 1px solid var(--border-light);
    background: transparent;
    color: var(--text-primary);
    text-align: left;
    font: inherit;
    cursor: pointer;
}

.md-rows li:first-child .md-row {
    border-top: none;
}

.md-row:hover {
    background: var(--bg-secondary);
}

.md-row.active {
    background: var(--bg-tertiary);
}

.md-row-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 2px;
}

.md-detail {
    position: sticky;
    top: 70px;
}

.md-placeholder {
    padding: 40px 10px;
    text-align: center;
    color: var(--text-muted);
}

/* ---------- D. Lịch nguồn lực (Phân ca) ---------- */
.shift-calendar .matrix-table {
    table-layout: fixed;
    min-width: 760px;
}

/* Cột nhân viên / vai trò mang class tiện ích w-180, w-100 (= width 100%) -> với table-layout fixed phải cố định lại, nếu không 7 cột ngày bị ép về 0 */
.shift-calendar .matrix-table th.w-180 {
    width: 170px;
}

.shift-calendar .matrix-table th.w-100 {
    width: 90px;
}

.table-responsive {
    overflow-x: auto;
}

.shift-calendar .matrix-table td {
    height: 64px;
    vertical-align: top;
    padding: 4px;
}

.shift-calendar .matrix-shift-badge {
    position: relative;
    height: 100%;
    padding: 4px 6px;
    border-left: 4px solid var(--bx-acc);
    background: var(--bg-secondary);
    text-align: left;
}

.shift-calendar .btn-matrix-add {
    width: 100%;
    height: 100%;
    min-height: 54px;
    border: 1px dashed transparent;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
}

.shift-calendar .btn-matrix-add:hover {
    border-color: var(--border-main);
    color: var(--text-primary);
}

.shift-side {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
    gap: 16px;
    align-items: start;
}

/* ---------- F. Điều phối: cột theo khu vực + hàng chờ ---------- */
.dispatch-board {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 16px;
    align-items: start;
}

.area-columns {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 1fr);
    gap: 12px;
    overflow-x: auto;
    align-items: start;
}

.assign-inline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px;
    margin: 8px 0 0;
}

.dispatch-side {
    display: grid;
    gap: 16px;
}

.shipper-load {
    padding: 8px 0;
    border-top: 1px solid var(--border-light);
}

.shipper-load:first-child {
    border-top: none;
}

.shipper-load meter {
    width: 100%;
    height: 8px;
}

.shipper-load form {
    margin-top: 6px;
}

/* ---------- G. Điện thoại: 1 việc 1 màn (Shipper, khách QR) ---------- */
.ship-page {
    max-width: 720px;
}

.ship-focus {
    margin-bottom: 16px;
    border: 2px solid var(--bx-acc);
}

.ship-focus-name {
    margin: 8px 0 2px;
    font-size: 18px;
    font-weight: bold;
}

.ship-call {
    display: block;
    margin: 10px 0;
    text-align: center;
    font-weight: bold;
}

.ship-focus-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 8px;
}

.ship-focus-actions form,
.ship-focus-actions button {
    width: 100%;
}

.ship-focus-actions .btn-next,
.ship-focus-actions .btn-plain {
    min-height: 44px;
}

.ship-section {
    margin-bottom: 16px;
}

.bottom-nav {
    display: none;
}

@media (max-width: 768px) {
    /* Thanh điều hướng đáy: Shipper (.bottom-nav) và tab của màn khách QR */
    .bottom-nav,
    .qr-page .tab-nav {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 950;
        display: flex;
        margin: 0;
        border-top: 1px solid var(--border-light);
        border-bottom: none;
        background: var(--bg-primary);
    }

    .bottom-nav a,
    .qr-page .tab-nav .tab-btn {
        flex: 1;
        margin: 0;
        padding: 12px 4px;
        border: none;
        border-radius: 0;
        background: transparent;
        text-align: center;
        font-size: 13px;
        font-weight: bold;
    }

    .qr-page .tab-nav .tab-btn.active {
        border-top: 3px solid var(--bx-acc);
    }

    .ship-page,
    .qr-page {
        padding-bottom: 70px;
    }

    .qr-page .floating-cart {
        display: none;
    }

    /* Nút sáng/tối nổi góc dưới: đẩy lên trên thanh điều hướng đáy */
    .qr-page #btnDarkModeGlobal,
    body:has(.bottom-nav) #btnDarkModeGlobal {
        bottom: 76px;
    }

    body:has(.bottom-nav) .app-footer {
        padding-bottom: 70px;
    }

    .qr-page .menu-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        padding: 0;
    }

    .qr-page .product-card {
        width: auto;
        padding: 8px;
    }

    .qr-page .menu-cats {
        flex-wrap: nowrap;
        overflow-x: auto;
    }

    .qr-page .menu-cat {
        flex: none;
    }
}

@media (max-width: 1023px) {
    .dispatch-board {
        grid-template-columns: minmax(0, 1fr);
    }

    .md-layout {
        grid-template-columns: minmax(0, 1fr);
    }

    .md-detail {
        position: static;
    }

    .home-grid {
        grid-template-columns: minmax(0, 1fr);
    }

    .pos {
        grid-template-columns: minmax(0, 1fr);
    }

    .pos-cats {
        flex-direction: row;
        flex-wrap: wrap;
        position: static;
    }

    .pos-ticket {
        position: static;
        max-height: none;
    }
}

/* Các nút/nhãn cũ tô màu nhấn: theo cặp màu của theme (mẫu C = nền cam nhạt chữ cam; mẫu D = nền cam chữ tối) */
.menu-cat.active,
.btn-update,
.btn-option-buy,
.btn-action-add-recipe:hover {
    background: var(--bx-tab-on-bg);
    border: 1.5px solid var(--bx-btn-line);
    color: var(--bx-tab-on-ink);
}

.badge-table,
.badge-featured {
    background: var(--bx-acc-dark);
    color: #FFFFFF;
}

body.dark-theme .badge-table,
body.dark-theme .badge-featured {
    color: #1A120C;
}

/* Nhãn "Chờ xử lý" cũ: chữ cam quá nhạt trên nền kem -> đậm hơn cho dễ đọc */
.report-badge-pending {
    color: #9A4A00;
}

/* Thẻ món: nút "Thêm vào giỏ" luôn nằm sát đáy thẻ, các thẻ cùng hàng cao bằng nhau -> nút thẳng hàng dù tên món dài 1 hay 3 dòng */
.product-card {
    display: flex;
    flex-direction: column;
}

.product-card .product-price {
    margin-top: auto;
    margin-bottom: 10px;
}

/* ---------- Nút icon, logo màn QR, ghi công icon ---------- */
.lang-btn,
.btn-icon-alert,
#btnHamburger,
#btnDarkModeGlobal {
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.subnav a .fi {
    margin-right: 8px;
    color: var(--bx-mute);
}

.subnav a.active .fi {
    color: var(--bx-acc);
}

.notification-icon-box .fi {
    font-size: 18px;
    color: var(--bx-acc);
}

.qr-brand {
    display: flex;
    align-items: center;
    gap: 10px;
}

.qr-credit {
    text-align: center;
    font-size: 11px;
    color: var(--bx-mute);
    padding: 8px 16px 96px;
}

.qr-credit a {
    color: var(--bx-acc-dark);
}

/* ---------- Mẫu G "Cột trái cam" (người dùng chọn 2026-10-28) ----------
   Thanh trên: nền trắng + chữ thương hiệu cam, tab đang chọn = ô nâu đậm chữ trắng (--bx-top-*).
   Cột trái: cam đặc, mục đang chọn = ô trắng chữ cam (--bx-bar-*). Nội dung: nền trắng ấm.
   Chỉ đặt màu cho từng phần tử trên thanh (không đặt cho cả .topbar) để dropdown giữ màu riêng. */
.topbar {
    background: var(--bx-top-bg);
    border-bottom: 1px solid var(--bx-top-line);
}

.topbar .topbar-brand-text {
    color: var(--bx-top-brand);
}

.topbar .module-tab {
    color: var(--bx-top-mute);
}

.topbar .module-tab:hover {
    background: var(--bx-top-hover);
    color: var(--bx-top-ink);
}

.topbar .module-tab.active {
    background: var(--bx-top-on-bg);
    color: var(--bx-top-on-ink);
}

.topbar .lang-btn,
.topbar .btn-icon-alert,
.topbar #btnHamburger {
    background: transparent;
    border: 1px solid var(--bx-top-line);
    color: var(--bx-top-ink);
}

.topbar .lang-btn:hover,
.topbar .btn-icon-alert:hover,
.topbar #btnHamburger:hover {
    background: var(--bx-top-hover);
}

.topbar #btnAvatar,
.topbar .btn-login {
    background: var(--bx-top-avatar-bg);
    border: none;
    color: var(--bx-top-avatar-ink);
}

.topbar .brand-mark {
    background: transparent;
    border-radius: 0;
}

.subnav,
#menuDoc.subnav {
    background: var(--bx-bar-bg);
    border-right: none;
}

.subnav .subnav-title {
    color: var(--bx-bar-mute);
}

.subnav a,
.subnav a .fi {
    color: var(--bx-bar-ink);
}

.subnav a:hover {
    background: var(--bx-bar-hover);
}

.subnav a.active,
.subnav a.active .fi {
    background: var(--bx-bar-on-bg);
    color: var(--bx-bar-on-ink);
}

.subnav a.active .fi {
    background: transparent;
}

.subnav #btnDongMenuDoc {
    background: transparent;
    border: 1px solid var(--bx-bar-line);
    color: var(--bx-bar-ink);
}

@media (min-width: 1024px) {
    body.has-shell > #menuDoc {
        border-right: none;
    }
}

/* Mẫu G: số đếm cột Kanban là chấm cam đặc, tên cột đậm */
.kanban-count {
    background: var(--bx-acc);
    border-color: var(--bx-acc);
    color: #FFFFFF;
    font-weight: 700;
}

body.dark-theme .kanban-count {
    color: #1A120C;
}

.kanban-col-head {
    font-weight: 700;
}

/* ---------- Toàn hệ thống: ô nhập, form, thông báo (áp cho login / register / profile / settings...) ---------- */
input[type="text"],
input[type="password"],
input[type="email"],
input[type="number"],
input[type="date"],
input[type="time"],
input[type="tel"],
input[type="search"],
select,
textarea {
    padding: 9px 12px;
    border: 1px solid var(--bx-line);
    border-radius: 4px;
    background: var(--bx-card);
    color: var(--bx-ink);
    font-size: 14px;
}

input:focus,
select:focus,
textarea:focus {
    outline: 2px solid var(--bx-acc);
    outline-offset: 0;
    border-color: var(--bx-acc);
}

input[type="submit"] {
    padding: 10px 18px;
    border: 1.5px solid var(--bx-btn-line);
    border-radius: 4px;
    background: var(--bx-btn-bg);
    color: var(--bx-btn-ink);
    font-weight: 700;
    cursor: pointer;
}

input[type="submit"]:hover {
    background: var(--bx-btn-hover);
}

.msg-error,
.alert-danger {
    padding: 10px 12px;
    border-left: 4px solid var(--bx-danger);
    border-radius: 4px;
    background: var(--bx-soft);
    color: var(--bx-danger);
}

.msg-success,
.alert-success {
    padding: 10px 12px;
    border-left: 4px solid var(--bx-ok);
    border-radius: 4px;
    background: var(--bx-soft);
    color: var(--bx-ok);
}

/* Form dạng thẻ: nhãn trên, ô nhập full ngang, bỏ <br> cũ */
.form-card br {
    display: none;
}

.form-card label {
    display: block;
    margin: 14px 0 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--bx-mute);
}

.form-card input[type="text"],
.form-card input[type="password"],
.form-card input[type="email"],
.form-card select {
    width: 100%;
    box-sizing: border-box;
}

.form-card input[type="submit"] {
    width: 100%;
    margin-top: 22px;
}

/* ---------- Đăng nhập / đăng ký: thẻ giữa trang, logo phía trên ---------- */
.auth-page {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 40px;
}

.auth-card {
    width: 100%;
    max-width: 400px;
    padding: 28px 28px 24px;
    border: 1px solid var(--bx-line);
    border-radius: 8px;
    background: var(--bx-card);
    box-shadow: 0 6px 24px rgba(43, 26, 16, 0.08);
}

.auth-card-wide {
    max-width: 520px;
}

.auth-logo {
    display: block;
    width: 84px;
    height: 84px;
    margin: 0 auto 4px;
    object-fit: contain;
}

.auth-card h2 {
    margin: 0 0 6px;
    text-align: center;
}

.auth-switch {
    margin: 18px 0 0;
    text-align: center;
    font-size: 14px;
}

.auth-switch a {
    color: var(--bx-acc-dark);
    font-weight: 600;
    text-decoration: underline;
}

.register-wrapper.auth-card {
    margin: 0;
}

/* ---------- Hồ sơ cá nhân ---------- */
.profile-layout {
    align-items: flex-start;
    flex-wrap: wrap;
}

.profile-avatar-col.panel,
.profile-detail-col.panel {
    padding: 24px;
    border-radius: 8px;
    border: 1px solid var(--bx-line);
    background: var(--bx-card);
}

.profile-avatar-col h3 {
    margin: 0 0 16px;
    font-size: 15px;
    color: var(--bx-mute);
}

.profile-avatar-circle {
    background: var(--bx-acc);
    color: #FFFFFF;
}

body.dark-theme .profile-avatar-circle {
    color: #1A120C;
}

.profile-avatar-img {
    border-color: var(--bx-acc);
}

.profile-detail-col h2 {
    margin: 0 0 12px;
}

.profile-table {
    border-collapse: collapse;
    line-height: 1.5;
}

.profile-table td {
    padding: 12px 8px;
    border-bottom: 1px solid var(--bx-line);
}

.profile-table tr:last-child td {
    border-bottom: none;
}

.profile-table td:first-child {
    width: 34%;
}

.profile-table td:first-child strong {
    font-weight: 600;
    color: var(--bx-mute);
}

/* ---------- Cài đặt ---------- */
.settings-layout {
    align-items: flex-start;
    flex-wrap: wrap;
}

.settings-layout > .panel {
    padding: 24px;
    border-radius: 8px;
    max-width: 560px;
}

.settings-sidebar {
    border-right: none;
    padding: 12px;
    border: 1px solid var(--bx-line);
    border-radius: 8px;
    background: var(--bx-card);
}

.settings-sidebar h3 {
    margin: 0 0 10px;
    font-size: 13px;
    text-transform: uppercase;
    color: var(--bx-mute);
}

.btn-menu-tab {
    padding: 9px 12px;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: var(--bx-ink);
    text-align: left;
    font-weight: 600;
}

.btn-menu-tab:hover {
    background: var(--bx-soft);
}

/* Trang báo không có quyền */
.unauthorized-message {
    max-width: 440px;
    margin: 40px auto;
    padding: 28px;
    border: 1px solid var(--bx-line);
    border-radius: 8px;
    background: var(--bx-card);
    text-align: center;
}

/* Trang chủ cho khách chưa đăng nhập */
.guest-hero-container {
    max-width: 640px;
    margin: 48px auto;
    padding: 40px 28px;
    border: 1px solid var(--bx-line);
    border-radius: 8px;
    background: var(--bx-card);
}

.guest-logo {
    width: 120px;
    height: 120px;
    margin-bottom: 12px;
}

.btn-primary.btn-lg {
    display: inline-block;
    padding: 12px 28px;
}

.register-layout.form-card input[type="text"],
.register-layout.form-card input[type="password"],
.register-layout.form-card input[type="email"] {
    margin-top: 0;
    padding: 9px 12px;
    border: 1px solid var(--bx-line);
    background-color: var(--bx-card);
}

/* Màu xanh cũ còn sót ở thành phần không phải trạng thái -> theo theme */
.btn-image-tab {
    border: 1px solid var(--bx-line);
    border-radius: 4px;
    background: var(--bx-col);
    color: var(--bx-ink);
}

.btn-image-tab:hover {
    background: var(--bx-soft);
}

.btn-image-tab.active {
    background: var(--bx-tab-on-bg);
    border-color: var(--bx-tab-on-bg);
    color: var(--bx-tab-on-ink);
}

.form-hint-text {
    color: var(--bx-mute);
}

.dashboard-avatar {
    background: var(--bx-acc);
}

.register-nav-link {
    color: var(--bx-acc-dark);
}

/* Ngắt dòng đều: tiêu đề và đoạn mô tả ngắn cân bằng độ dài các dòng (không còn 1-2 chữ lẻ ở dòng cuối) */
h1, h2, h3, h4,
.guest-hero-desc,
.page-head,
.kpi-label,
.auth-card p,
.unauthorized-message p,
.md-placeholder {
    text-wrap: balance;
}

p, li, td {
    text-wrap: pretty;
}

.guest-hero-title {
    font-size: 34px;
    line-height: 1.25;
}

.guest-hero-desc {
    font-size: 17px;
    line-height: 1.6;
    max-width: 520px;
}

.guest-hero-container,
.guest-hero-container .guest-hero-desc {
    text-align: center;
}

.guest-hero-container .guest-hero-desc {
    margin-left: auto;
    margin-right: auto;
}
</file>

<file path="web/WEB-INF/tags/itemOptions.tag">
<%@tag description="Hiển thị tuỳ chọn của 1 dòng món: size, đá, đường, topping, ghi chú (dùng chung cho giỏ hàng, xác nhận đơn, bảng đơn)" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@attribute name="sizeName" required="false"%>
<%@attribute name="iceLevel" required="false"%>
<%@attribute name="sugarLevel" required="false"%>
<%@attribute name="toppings" required="false"%>
<%@attribute name="note" required="false"%>
<%-- Tag chạy trong ngữ cảnh riêng nên phải nạp lại ngôn ngữ (Locale 3 tầng: Session -> Cookie -> vi) --%>
<fmt:setLocale value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setBundle basename="resources.messages" />
<c:if test="${not empty sizeName or not empty iceLevel or not empty sugarLevel or not empty toppings or not empty note}">
    <span class="item-options">
        <c:if test="${not empty sizeName}">
            <span class="item-opt"><fmt:message key="option.size_prefix" /> <c:out value="${sizeName}" /></span>
        </c:if>
        <c:if test="${not empty iceLevel}">
            <span class="item-opt"><fmt:message key="option.ice.${iceLevel}" /></span>
        </c:if>
        <c:if test="${not empty sugarLevel}">
            <span class="item-opt"><fmt:message key="option.sugar.${sugarLevel}" /></span>
        </c:if>
        <c:if test="${not empty toppings}">
            <span class="item-opt">+ <c:out value="${toppings}" /></span>
        </c:if>
        <c:if test="${not empty note}">
            <span class="item-opt item-note"><fmt:message key="option.note_prefix" />: <c:out value="${note}" /></span>
        </c:if>
    </span>
</c:if>
</file>

<file path="web/WEB-INF/tags/orderCard.tag">
<%@tag description="Thẻ 1 đơn trong bảng Kanban Quản lý đơn: nguồn đơn, món + tùy chọn, tổng tiền, nút bước tiếp theo" pageEncoding="UTF-8"%>
<%@attribute name="order" required="true" type="java.util.Map"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<%@taglib prefix="bx" tagdir="/WEB-INF/tags"%>
<%-- Tag file không kế thừa locale của trang gọi -> tự khai báo --%>
<fmt:setLocale value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setBundle basename="resources.messages" />
<c:set var="ctx" value="${pageContext.request.contextPath}" />

<article class="kanban-card" data-order-type="${order.orderType}">
    <div class="kanban-card-head">
        <span>#${order.orderId}</span>
        <span class="muted">
            <c:choose>
                <c:when test="${order.orderType == 'Table'}"><fmt:message key="order.management.source.table" /> ${order.tableId}</c:when>
                <c:when test="${order.orderType == 'Counter'}"><fmt:message key="order.management.tab.counter" /></c:when>
                <c:otherwise><c:out value="${order.customerName}" /></c:otherwise>
            </c:choose>
        </span>
    </div>
    <div class="muted">${order.createdAt}</div>

    <ul class="kanban-card-items">
        <c:forEach var="detail" items="${order.details}">
            <li>
                <strong>${detail.quantity}×</strong> <c:out value="${detail.productName}" />
                <bx:itemOptions sizeName="${detail.sizeName}" iceLevel="${detail.iceLevel}" sugarLevel="${detail.sugarLevel}" toppings="${detail.toppings}" note="${detail.note}" />
            </li>
        </c:forEach>
    </ul>

    <c:if test="${order.status == 'Cancelled' and not order.isCancelLocked}">
        <div class="cancel-countdown-wrapper" id="cancelCountdownWrapper-${order.orderId}">
            <span class="muted"><fmt:message key="order.cancel.countdown" /></span>
            <span class="cancel-countdown-timer font-bold" data-order-id="${order.orderId}" data-seconds="${order.remainingCancelSeconds}"
                  data-locked-text="<fmt:message key="order.cancel.locked" />">--:--</span>
        </div>
    </c:if>

    <div class="kanban-card-foot">
        <strong><fmt:formatNumber value="${order.totalAmount}" pattern="#,###" /> ₫</strong>
        <div class="kanban-actions">
            <c:choose>
                <c:when test="${order.isDeliveryUnderShipper}">
                    <span class="muted"><fmt:message key="order.management.action.under_shipper" /></span>
                </c:when>
                <c:when test="${order.isClosedStatus or order.status == 'Cancelled'}"></c:when>
                <c:otherwise>
                    <%-- Bước tiếp theo theo trạng thái hiện tại; JS handleStaffStatusSubmit vẫn chặn/mở popup như cũ --%>
                    <c:choose>
                        <c:when test="${order.status == 'Accepted'}"><c:set var="nextStatus" value="Prepared" /><c:set var="nextKey" value="order.kanban.next.start" /></c:when>
                        <c:when test="${order.status == 'Prepared' and order.orderType != 'Delivery'}"><c:set var="nextStatus" value="Paid" /><c:set var="nextKey" value="order.kanban.next.paid" /></c:when>
                        <c:when test="${order.status == 'Prepared'}"><c:set var="nextStatus" value="Waiting for dispatch" /><c:set var="nextKey" value="order.kanban.next.dispatch" /></c:when>
                        <c:otherwise><c:set var="nextStatus" value="" /></c:otherwise>
                    </c:choose>
                    <c:if test="${not empty nextStatus}">
                        <form action="${ctx}/OrderManagementController" method="POST" class="order-status-form"
                              data-customer-name="${fn:escapeXml(order.customerName)}" data-customer-phone="${fn:escapeXml(order.customerPhone)}"
                              data-delivery-address="${fn:escapeXml(order.deliveryAddress)}" data-area-id="${order.areaId}"
                              data-order-type="${order.orderType}" data-current-status="${order.status}" data-order-id="${order.orderId}">
                            <input type="hidden" name="action" value="updateStatus" />
                            <input type="hidden" name="orderId" value="${order.orderId}" />
                            <input type="hidden" name="filterDate" value="${CURRENT_FILTER_DATE}" />
                            <input type="hidden" name="filterStatus" value="ALL" />
                            <input type="hidden" name="activeTab" value="tab-all-orders" />
                            <input type="hidden" name="newStatus" value="${nextStatus}" />
                            <button type="submit" class="btn-next"><fmt:message key="${nextKey}" /></button>
                        </form>
                    </c:if>
                    <%-- Đơn tại quầy/bàn đã pha xong: có thể chuyển sang giao hàng (JS mở popup nhập địa chỉ) --%>
                    <c:if test="${order.status == 'Prepared' and order.orderType != 'Delivery'}">
                        <form action="${ctx}/OrderManagementController" method="POST" class="order-status-form"
                              data-customer-name="${fn:escapeXml(order.customerName)}" data-customer-phone="${fn:escapeXml(order.customerPhone)}"
                              data-delivery-address="${fn:escapeXml(order.deliveryAddress)}" data-area-id="${order.areaId}"
                              data-order-type="${order.orderType}" data-current-status="${order.status}" data-order-id="${order.orderId}">
                            <input type="hidden" name="action" value="updateStatus" />
                            <input type="hidden" name="orderId" value="${order.orderId}" />
                            <input type="hidden" name="filterDate" value="${CURRENT_FILTER_DATE}" />
                            <input type="hidden" name="filterStatus" value="ALL" />
                            <input type="hidden" name="activeTab" value="tab-all-orders" />
                            <input type="hidden" name="newStatus" value="Waiting for dispatch" />
                            <button type="submit" class="btn-plain"><fmt:message key="order.kanban.next.dispatch" /></button>
                        </form>
                    </c:if>
                    <c:if test="${order.canCancelOrder}">
                        <button type="button" class="btn-plain btn-open-staff-cancel" data-order-id="${order.orderId}" data-tab-key="tab-all-orders"><fmt:message key="order.management.btn.cancel" /></button>
                    </c:if>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</article>
</file>

