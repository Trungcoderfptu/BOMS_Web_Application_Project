<file path="web/inventory_managerment.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<fmt:setLocale value="${not empty cookie.LANG.value ? cookie.LANG.value : 'vi'}" />
<fmt:setBundle basename="resources.messages" />

<jsp:include page="header.jsp" />

<main class="main-content">
    <div class="flex-between mt-15 mb-20">
        <h2 class="m-0"><fmt:message key="inventory.heading" /></h2>
        <c:if test="${IS_MANAGER}">
            <button type="button" class="btn-login" onclick="openCreateIngredientModal()">
                + <fmt:message key="inventory.btn.add" />
            </button>
        </c:if>
    </div>

    <%-- Flash Message Thông Báo Một Lần (Chuẩn PRG) --%>
    <c:if test="${not empty sessionScope.ERROR_MESSAGE}">
        <p class="msg-error text-center"><fmt:message key="${sessionScope.ERROR_MESSAGE}" /></p>
        <c:remove var="ERROR_MESSAGE" scope="session" />
    </c:if>
    <c:if test="${not empty ERROR_MESSAGE}">
        <p class="msg-error text-center"><fmt:message key="${ERROR_MESSAGE}" /></p>
    </c:if>

    <c:if test="${not empty sessionScope.SUCCESS_MESSAGE}">
        <p class="msg-success text-center"><fmt:message key="${sessionScope.SUCCESS_MESSAGE}" /></p>
        <c:remove var="SUCCESS_MESSAGE" scope="session" />
    </c:if>
    <c:if test="${not empty SUCCESS_MESSAGE}">
        <p class="msg-success text-center"><fmt:message key="${SUCCESS_MESSAGE}" /></p>
    </c:if>

    <%-- Thanh Tìm Kiếm Nguyên Liệu --%>
    <form action="${pageContext.request.contextPath}/InventoryManagementController" method="GET" class="order-filter-panel mb-20">
        <div class="filter-item flex-grow-1">
            <label for="searchIngredient"><fmt:message key="inventory.table.name" />:</label>
            <input type="text" id="searchIngredient" name="search" value="${fn:escapeXml(SEARCH_TERM)}"
                   placeholder="<fmt:message key="inventory.search.placeholder" />"
                   class="filter-input flex-grow-1" />
        </div>
        <button type="submit" class="btn-login"><fmt:message key="inventory.btn.search" /></button>
        <c:if test="${not empty SEARCH_TERM}">
            <a href="${pageContext.request.contextPath}/InventoryManagementController" class="btn-modal-cancel">
                <fmt:message key="inventory.btn.clear_search" />
            </a>
        </c:if>
    </form>

    <%-- Bảng Danh Sách Nguyên Liệu Kho --%>
    <c:choose>
        <c:when test="${empty INGREDIENT_LIST}">
            <div class="empty-cart-container">
                <h3 class="msg-info"><fmt:message key="inventory.empty" /></h3>
            </div>
        </c:when>
        <c:otherwise>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th><fmt:message key="inventory.table.id" /></th>
                        <th><fmt:message key="inventory.table.name" /></th>
                        <th><fmt:message key="inventory.table.category" /></th>
                        <th><fmt:message key="inventory.table.quantity" /></th>
                        <th><fmt:message key="inventory.table.unit" /></th>
                        <th><fmt:message key="inventory.table.price" /></th>
                        <th><fmt:message key="inventory.table.location" /></th>
                        <th><fmt:message key="inventory.table.threshold" /></th>
                        <th><fmt:message key="inventory.table.status" /></th>
                        <c:if test="${IS_MANAGER}">
                            <th><fmt:message key="inventory.table.action" /></th>
                        </c:if>
                    </tr>
                </thead>
                <tbody>
                    <c:forEach var="item" items="${INGREDIENT_LIST}">
                        <tr>
                            <td><strong>#${item.ingredientId}</strong></td>
                            <td><strong>${item.ingredientName}</strong></td>
                            <td><span class="badge-category">${item.categoryName}</span></td>
                            <td class="font-bold">
                                <fmt:formatNumber value="${item.quantity}" maxFractionDigits="2" />
                            </td>
                            <td>${item.unit}</td>
                            <td class="font-bold text-nowrap">
                                <fmt:formatNumber value="${item.price}" pattern="#,###" /> ₫
                            </td>
                            <td>${item.storageLocation}</td>
                            <td>
                                <fmt:formatNumber value="${item.warningThreshold}" maxFractionDigits="2" /> ${item.unit}
                            </td>
                            <td>
                                <c:choose>
                                    <c:when test="${item.stockStatus == 'OUT_OF_STOCK'}">
                                        <span class="badge-status-inactive">
                                            <fmt:message key="inventory.status.out_of_stock" />
                                        </span>
                                    </c:when>
                                    <c:when test="${item.stockStatus == 'LOW_STOCK'}">
                                        <span class="badge-stock-out">
                                            <fmt:message key="inventory.status.low_stock" />
                                        </span>
                                    </c:when>
                                    <c:otherwise>
                                        <span class="badge-stock-ok">
                                            <fmt:message key="inventory.status.in_stock" />
                                        </span>
                                    </c:otherwise>
                                </c:choose>
                            </td>
                            <c:if test="${IS_MANAGER}">
                                <td>
                                    <div class="menu-action-buttons">
                                        <button type="button" class="btn-action-edit"
                                                onclick="openEditIngredientModal('${item.ingredientId}', '${item.categoryId}', '${fn:escapeXml(item.ingredientName)}', '${fn:escapeXml(item.unit)}', '${item.quantity}', '${item.price}', '${fn:escapeXml(item.storageLocation)}', '${item.warningThreshold}')">
                                            <fmt:message key="inventory.btn.edit" />
                                        </button>
                                        <button type="button" class="btn-action-toggle-resume"
                                                onclick="openThresholdModal('${item.ingredientId}', '${fn:escapeXml(item.ingredientName)}', '${item.warningThreshold}')">
                                            <fmt:message key="inventory.btn.update_threshold" />
                                        </button>
                                        <form action="${pageContext.request.contextPath}/InventoryManagementController" method="POST" class="m-0 d-inline"
                                              onsubmit="return confirm('<fmt:message key="inventory.confirm.delete" />');">
                                            <input type="hidden" name="action" value="delete" />
                                            <input type="hidden" name="ingredientId" value="${item.ingredientId}" />
                                            <button type="submit" class="btn-action-toggle-stop">
                                                <fmt:message key="inventory.btn.delete" />
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </c:if>
                        </tr>
                    </c:forEach>
                </tbody>
            </table>
        </c:otherwise>
    </c:choose>

    <jsp:include page="components/inventory_form_modal.jsp" />
</main>

<jsp:include page="footer.jsp" />
</file>

<file path="web/report_detail.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<c:set var="currentLang" value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setLocale value="${currentLang}" />
<fmt:setBundle basename="resources.messages" />

<jsp:include page="header.jsp" />

<main class="main-content">
    <a href="${pageContext.request.contextPath}/ReportManagementController" class="report-back-link">&larr; <fmt:message key="report.btn.back_to_list" /></a>
    <h2><fmt:message key="report.detail.heading" />: <c:out value="${REPORT_DETAIL.ticketId}" /></h2>

    <c:if test="${not empty ERROR_MESSAGE}">
        <p class="msg-error"><fmt:message key="${ERROR_MESSAGE}" /></p>
    </c:if>

    <%-- Bước 4: Hiển thị chi tiết báo cáo --%>
    <table class="admin-table report-info-table">
        <tr><th><fmt:message key="report.label.category" /></th><td><c:out value="${REPORT_DETAIL.categoryName}" /></td></tr>
        <tr><th><fmt:message key="report.label.status" /></th>
            <td><span class="order-badge report-badge-${fn:toLowerCase(REPORT_DETAIL.statusKey)}"><fmt:message key="report.status.${REPORT_DETAIL.statusKey}" /></span></td></tr>
        <tr><th><fmt:message key="report.label.submitted_at" /></th><td>${REPORT_DETAIL.submittedAt}</td></tr>
        <tr><th><fmt:message key="report.label.updated_at" /></th><td>${empty REPORT_DETAIL.updatedAt ? '-' : REPORT_DETAIL.updatedAt}</td></tr>
        <tr><th><fmt:message key="report.label.title" /></th><td><strong><c:out value="${REPORT_DETAIL.title}" /></strong></td></tr>
        <tr><th><fmt:message key="report.label.description" /></th><td class="report-pre"><c:out value="${REPORT_DETAIL.description}" /></td></tr>
        <tr><th><fmt:message key="report.label.evidence" /></th>
            <td>
                <c:choose>
                    <c:when test="${empty REPORT_DETAIL.evidences}"><fmt:message key="report.evidence.none" /></c:when>
                    <c:otherwise>
                        <%-- 8.2 Download Evidence --%>
                        <ul class="no-bullet evidence-list">
                            <c:forEach var="ev" items="${REPORT_DETAIL.evidences}">
                                <li>
                                    <a href="${pageContext.request.contextPath}/EvidenceController?id=${ev.evidenceId}&reportId=${REPORT_DETAIL.reportId}">
                                        <c:out value="${ev.fileName}" />
                                    </a>
                                    <span class="report-hint">(${fn:toUpperCase(ev.fileType)}, ${ev.fileSizeKb} KB)</span>
                                </li>
                            </c:forEach>
                        </ul>
                    </c:otherwise>
                </c:choose>
            </td></tr>
        <tr><th><fmt:message key="report.label.feedback" /></th>
            <td class="report-pre">
                <c:choose>
                    <c:when test="${not empty REPORT_DETAIL.feedback}"><c:out value="${REPORT_DETAIL.feedback}" /></c:when>
                    <c:otherwise><fmt:message key="report.feedback.none" /></c:otherwise>
                </c:choose>
            </td></tr>
    </table>

    <c:choose>
        <c:when test="${REPORT_DETAIL.closed}">
            <p class="msg-warning mt-15"><fmt:message key="report.detail.closed" /></p>
        </c:when>
        <c:otherwise>
            <%-- Bước 6 - 8: Chọn trạng thái mới, nhập phản hồi và gửi --%>
            <h3 class="mt-15"><fmt:message key="report.detail.process_heading" /></h3>
            <form action="${pageContext.request.contextPath}/ReportManagementController" method="POST" class="report-form">
                <input type="hidden" name="reportId" value="${REPORT_DETAIL.reportId}" />
                <div class="report-field">
                    <label for="newStatus"><fmt:message key="report.label.new_status" /> *</label>
                    <select id="newStatus" name="newStatus" class="filter-input ${ERROR_MESSAGE == 'E0310' ? 'input-error' : ''}" required>
                        <option value="In Progress" ${param.newStatus == 'In Progress' ? 'selected' : ''}><fmt:message key="report.status.In_Progress" /></option>
                        <option value="Resolved" ${param.newStatus == 'Resolved' ? 'selected' : ''}><fmt:message key="report.status.Resolved" /></option>
                        <option value="Rejected" ${param.newStatus == 'Rejected' ? 'selected' : ''}><fmt:message key="report.status.Rejected" /></option>
                    </select>
                </div>
                <div class="report-field">
                    <label for="txtFeedback"><fmt:message key="report.label.feedback_notes" /></label>
                    <textarea id="txtFeedback" name="txtFeedback" rows="5"
                              class="filter-input ${ERROR_MESSAGE == 'E0311' ? 'input-error' : ''}"><c:out value="${param.txtFeedback}" /></textarea>
                    <small class="report-hint"><fmt:message key="report.hint.reject_feedback" /></small>
                </div>
                <div class="report-actions">
                    <button type="submit" class="btn-register-action m-0 w-auto"><fmt:message key="report.btn.submit_update" /></button>
                    <%-- 8.1 Cancel Action: bỏ dữ liệu đã nhập, giữ trạng thái cũ, quay lại màn hình chi tiết --%>
                    <a href="${pageContext.request.contextPath}/ReportManagementController?reportId=${REPORT_DETAIL.reportId}" class="btn-report-cancel"><fmt:message key="report.btn.cancel" /></a>
                </div>
            </form>
        </c:otherwise>
    </c:choose>
</main>

<jsp:include page="footer.jsp" />
</file>

<file path="web/report_management.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<c:set var="currentLang" value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setLocale value="${currentLang}" />
<fmt:setBundle basename="resources.messages" />

<jsp:include page="header.jsp" />

<main class="main-content">
    <h2><fmt:message key="report.management.heading" /></h2>

    <c:if test="${not empty ERROR_MESSAGE}">
        <p class="msg-error"><fmt:message key="${ERROR_MESSAGE}" /></p>
    </c:if>
    <c:if test="${not empty SUCCESS_MESSAGE}">
        <p class="msg-success"><fmt:message key="${SUCCESS_MESSAGE}" /></p>
    </c:if>

    <%-- Bộ lọc theo Trạng thái, Ngày, Loại (UC-08 Other Information) --%>
    <form action="${pageContext.request.contextPath}/ReportManagementController" method="GET" class="order-filter-panel">
        <div class="filter-item">
            <label for="filterStatus"><fmt:message key="report.label.status" /></label>
            <select id="filterStatus" name="filterStatus" class="filter-input">
                <option value="ALL" ${CURRENT_FILTER_STATUS == 'ALL' ? 'selected' : ''}><fmt:message key="report.filter.all" /></option>
                <option value="Pending" ${CURRENT_FILTER_STATUS == 'Pending' ? 'selected' : ''}><fmt:message key="report.status.Pending" /></option>
                <option value="In Progress" ${CURRENT_FILTER_STATUS == 'In Progress' ? 'selected' : ''}><fmt:message key="report.status.In_Progress" /></option>
                <option value="Resolved" ${CURRENT_FILTER_STATUS == 'Resolved' ? 'selected' : ''}><fmt:message key="report.status.Resolved" /></option>
                <option value="Rejected" ${CURRENT_FILTER_STATUS == 'Rejected' ? 'selected' : ''}><fmt:message key="report.status.Rejected" /></option>
            </select>
        </div>
        <div class="filter-item">
            <label for="filterDate"><fmt:message key="report.label.submitted_date" /></label>
            <input type="date" id="filterDate" name="filterDate" value="${fn:escapeXml(CURRENT_FILTER_DATE)}" class="filter-input" />
        </div>
        <div class="filter-item">
            <label for="filterCategory"><fmt:message key="report.label.category" /></label>
            <select id="filterCategory" name="filterCategory" class="filter-input">
                <option value=""><fmt:message key="report.filter.all" /></option>
                <c:forEach var="cat" items="${CATEGORY_LIST}">
                    <option value="${cat.categoryId}" ${CURRENT_FILTER_CATEGORY == cat.categoryId ? 'selected' : ''}><c:out value="${cat.categoryName}" /></option>
                </c:forEach>
            </select>
        </div>
        <button type="submit" class="btn-status-save"><fmt:message key="report.btn.filter" /></button>
    </form>

    <c:choose>
        <c:when test="${empty REPORT_LIST}">
            <p class="text-center"><fmt:message key="report.management.empty" /></p>
        </c:when>
        <c:otherwise>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th><fmt:message key="report.label.ticket" /></th>
                        <th><fmt:message key="report.label.category" /></th>
                        <th><fmt:message key="report.label.title" /></th>
                        <th><fmt:message key="report.label.submitted_at" /></th>
                        <th><fmt:message key="report.label.evidence_count" /></th>
                        <th><fmt:message key="report.label.status" /></th>
                        <th><fmt:message key="report.label.action" /></th>
                    </tr>
                </thead>
                <tbody>
                    <c:forEach var="r" items="${REPORT_LIST}">
                        <tr>
                            <td><strong><c:out value="${r.ticketId}" /></strong></td>
                            <td><c:out value="${r.categoryName}" /></td>
                            <td><c:out value="${r.title}" /></td>
                            <td>${r.submittedAt}</td>
                            <td class="text-center">${r.evidenceCount}</td>
                            <td><span class="order-badge report-badge-${fn:toLowerCase(r.statusKey)}"><fmt:message key="report.status.${r.statusKey}" /></span></td>
                            <td><a href="${pageContext.request.contextPath}/ReportManagementController?reportId=${r.reportId}" class="btn-status-save report-link-btn"><fmt:message key="report.btn.view" /></a></td>
                        </tr>
                    </c:forEach>
                </tbody>
            </table>
        </c:otherwise>
    </c:choose>
</main>

<jsp:include page="footer.jsp" />
</file>

<file path="web/report.jsp">
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<c:set var="currentLang" value="${not empty sessionScope.LANG ? sessionScope.LANG : (not empty cookie.LANG.value ? cookie.LANG.value : 'vi')}" />
<fmt:setLocale value="${currentLang}" />
<fmt:setBundle basename="resources.messages" />

<jsp:include page="header.jsp" />

<main class="main-content">
    <h2><fmt:message key="report.heading" /></h2>
    <p class="report-note"><fmt:message key="report.anonymous_note" /></p>

    <c:if test="${not empty ERROR_MESSAGE}">
        <p class="msg-error"><fmt:message key="${ERROR_MESSAGE}" /></p>
    </c:if>
    <c:if test="${not empty SUCCESS_MESSAGE}">
        <div class="ticket-box">
            <p class="msg-success m-0"><fmt:message key="${SUCCESS_MESSAGE}" /></p>
            <c:if test="${not empty LAST_TICKET_ID}">
                <p class="m-0"><fmt:message key="report.ticket.your_ticket" />: <strong class="ticket-code"><c:out value="${LAST_TICKET_ID}" /></strong></p>
                <p class="report-hint m-0"><fmt:message key="report.ticket.keep_hint" /></p>
            </c:if>
        </div>
    </c:if>

    <c:set var="activeTab" value="${ACTIVE_TAB == 'track' ? 'track' : 'submit'}" />
    <div class="tab-nav d-flex">
        <button type="button" class="tab-btn ${activeTab == 'submit' ? 'active' : ''}" onclick="openTab(event, 'tab-submit')"><fmt:message key="report.tab.submit" /></button>
        <button type="button" class="tab-btn ${activeTab == 'track' ? 'active' : ''}" onclick="openTab(event, 'tab-track')"><fmt:message key="report.tab.track" /></button>
    </div>

    <%-- ===== UC-07: Form gửi báo cáo ===== --%>
    <div id="tab-submit" class="tab-content ${activeTab == 'submit' ? 'active' : 'd-none'}">
        <form action="${pageContext.request.contextPath}/ReportController" method="POST" enctype="multipart/form-data" class="report-form">
            <div class="report-field">
                <label for="categoryId"><fmt:message key="report.label.category" /> *</label>
                <select id="categoryId" name="categoryId" class="filter-input ${ERROR_MESSAGE == 'E0300' ? 'input-error' : ''}" required>
                    <option value=""><fmt:message key="report.label.category.choose" /></option>
                    <c:forEach var="cat" items="${CATEGORY_LIST}">
                        <option value="${cat.categoryId}" ${param.categoryId == cat.categoryId ? 'selected' : ''}><c:out value="${cat.categoryName}" /></option>
                    </c:forEach>
                </select>
            </div>

            <div class="report-field">
                <label for="txtTitle"><fmt:message key="report.label.title" /> *</label>
                <input type="text" id="txtTitle" name="txtTitle" maxlength="200" value="${fn:escapeXml(param.txtTitle)}"
                       class="filter-input ${ERROR_MESSAGE == 'E0301' || ERROR_MESSAGE == 'E0303' ? 'input-error' : ''}" required />
            </div>

            <div class="report-field">
                <label for="txtDescription"><fmt:message key="report.label.description" /> *</label>
                <textarea id="txtDescription" name="txtDescription" rows="6"
                          class="filter-input ${ERROR_MESSAGE == 'E0302' ? 'input-error' : ''}" required><c:out value="${param.txtDescription}" /></textarea>
            </div>

            <div class="report-field">
                <label for="evidenceFiles"><fmt:message key="report.label.evidence" /> *</label>
                <input type="file" id="evidenceFiles" name="evidenceFiles" multiple required
                       accept=".jpg,.jpeg,.png,.mp4,.pdf,.docx"
                       data-max-files="5" data-max-size="20971520"
                       data-msg-files="<fmt:message key='E0307' />"
                       data-msg-size="<fmt:message key='E0306' />"
                       data-msg-type="<fmt:message key='E0305' />"
                       class="${ERROR_MESSAGE == 'E0304' || ERROR_MESSAGE == 'E0305' || ERROR_MESSAGE == 'E0306' || ERROR_MESSAGE == 'E0307' || ERROR_MESSAGE == 'E0315' ? 'input-error' : ''}" />
                <small class="report-hint"><fmt:message key="report.hint.evidence" /></small>
                <c:if test="${not empty ERROR_MESSAGE}">
                    <small class="report-hint"><fmt:message key="report.hint.reselect_files" /></small>
                </c:if>
            </div>

            <div class="report-actions">
                <button type="submit" class="btn-register-action m-0 w-auto"><fmt:message key="report.btn.submit" /></button>
                <%-- 7.1 Cancel Reporting: bỏ dữ liệu đã nhập và quay lại màn hình trước --%>
                <a href="${pageContext.request.contextPath}/index.jsp" class="btn-report-cancel"><fmt:message key="report.btn.cancel" /></a>
            </div>
        </form>
    </div>

    <%-- ===== Tra cứu phản hồi theo Ticket ID (UC-08 POST-3) ===== --%>
    <div id="tab-track" class="tab-content ${activeTab == 'track' ? 'active' : 'd-none'}">
        <form action="${pageContext.request.contextPath}/ReportController" method="GET" class="order-filter-panel">
            <div class="filter-item">
                <label for="ticketId"><fmt:message key="report.label.ticket" /></label>
                <input type="text" id="ticketId" name="ticketId" value="${fn:escapeXml(param.ticketId)}" placeholder="TK-XXXXXXXX"
                       class="filter-input ${ERROR_MESSAGE == 'E0316' || ERROR_MESSAGE == 'E0309' ? 'input-error' : ''}" />
            </div>
            <button type="submit" class="btn-status-save"><fmt:message key="report.btn.track" /></button>
        </form>

        <c:if test="${not empty TICKET_RESULT}">
            <table class="admin-table report-info-table">
                <tr><th><fmt:message key="report.label.ticket" /></th><td><strong><c:out value="${TICKET_RESULT.ticketId}" /></strong></td></tr>
                <tr><th><fmt:message key="report.label.category" /></th><td><c:out value="${TICKET_RESULT.categoryName}" /></td></tr>
                <tr><th><fmt:message key="report.label.title" /></th><td><c:out value="${TICKET_RESULT.title}" /></td></tr>
                <tr><th><fmt:message key="report.label.status" /></th>
                    <td><span class="order-badge report-badge-${fn:toLowerCase(TICKET_RESULT.statusKey)}"><fmt:message key="report.status.${TICKET_RESULT.statusKey}" /></span></td></tr>
                <tr><th><fmt:message key="report.label.submitted_at" /></th><td>${TICKET_RESULT.submittedAt}</td></tr>
                <tr><th><fmt:message key="report.label.updated_at" /></th><td>${empty TICKET_RESULT.updatedAt ? '-' : TICKET_RESULT.updatedAt}</td></tr>
                <tr><th><fmt:message key="report.label.feedback" /></th>
                    <td class="report-pre">
                        <c:choose>
                            <c:when test="${not empty TICKET_RESULT.feedback}"><c:out value="${TICKET_RESULT.feedback}" /></c:when>
                            <c:otherwise><fmt:message key="report.feedback.none" /></c:otherwise>
                        </c:choose>
                    </td></tr>
            </table>
        </c:if>
    </div>
</main>

