                <button type="button" class="btn-secondary" data-close-modal="assignShiftModal">
                    <fmt:message key="hr.btn.cancel" />
                </button>
                <button type="submit" class="btn-primary" id="btnSubmitAssign">
                    <fmt:message key="hr.btn.assign" />
